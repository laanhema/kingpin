#!/usr/bin/env bash
# Dossier diff helper for workers: generate valid @pierre/diffs blocks and check a report.html.
#
# Usage:
#   kingpin-report diffs [--repo <dir>] [--base <ref>]   print the HTML fragment for Section 3
#   kingpin-report check [--prose-only] <file>           fail when a diff would render blank, the
#                                                        page would overflow, or the prose carries
#                                                        an AI tell
set -euo pipefail

KP_ROOT=$(cd "$(dirname "$0")/.." && pwd)

case "${1:-}" in
  diffs|check) exec node "$KP_ROOT/lib/report-diffs.mjs" "$@" ;;
  -h|--help|"")
    cat << 'HELP'
usage: kingpin-report diffs [--repo <dir>] [--base <ref>]
       kingpin-report check [--prose-only] <file>

  diffs  Print an HTML fragment: one container per changed file (committed since the
         merge-base, uncommitted, untracked), each with a static diff fallback and a
         FileDiff render call that passes oldFile/newFile. Paste it into report.html.
  check  Exit 1 when report.html would show a blank diff: `patch:` used, FileDiff
         without oldFile/newFile, no FileDiff at all, or an empty diff container.
         A `.md` or `.markdown` file is read as markdown: fenced blocks (backtick and
         tilde, nested fences included), indented code blocks, inline code spans and
         HTML comments are ignored, and the diff-section checks do not apply because
         a markdown file carries no diff section.
         It also runs a layout pass over a full page (`*.html` with an `<html>`
         element): a `<pre>` with no `white-space: pre-wrap` or `overflow-x`, inline
         `<code>` with no `overflow-wrap`, an `<img>` with no `max-width`, a `<table>`
         whose cells set no wrap rule, a grid/flex layout with no `min-width: 0` or
         `minmax(0, ...)` guard, and a `src`/`href`/`url()` that is an absolute path or
         climbs out with `..`. Each failure names the offending line, like the prose
         pass. A fragment has no page layout, so it is not judged.
         It also walks every `<style>` block by brace depth: a declaration at the
         top level of a block, outside any selector, fails with its line, because
         the browser drops the rule that follows it. After parsing, a page that
         claims `color-scheme: dark` must carry a `background` on `body`, `html` or
         `:root`, or it fails too.
         It also runs a prose pass (the mechanical slice of the `unslop` skill) and
         fails with file:line and the offending line on an AI tell: em dash,
         "testament to", "it's not just", "delve", "seamless", "in order to",
         "let me know", "I hope this helps". Code blocks, diff output, script/style
         bodies and HTML attributes are ignored. `<!-- unslop:ignore -->` on a line
         keeps a word that is genuinely wanted.
  --prose-only  Run everything but the diff section: the layout and prose passes, for an
         artifact with no diff section; the FileDiff, kp-diff-data and empty-container
         checks are skipped.
HELP
    ;;
  *) echo "kingpin-report: unknown command '$1'" >&2; exit 2 ;;
esac
