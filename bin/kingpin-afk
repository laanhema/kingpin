#!/usr/bin/env bash
# Arm, disarm or report the session-scoped AFK switch that lets the fleet
# supervisor land clean review verdicts while the operator is away.
#
# State lives at $KINGPIN_HOME/afk (holder pid, arm epoch, expiry epoch), never in
# a project config or the global config. It is cleared by `kingpin afk off` and by
# `kingpin lock release`, and it reads as off once the TTL passes or the recorded
# session pid is gone, so a session that dies cannot leave the fleet auto-landing.
#
# Usage: kingpin-afk [on [--ttl <duration>]|off|status]
set -euo pipefail

KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
KP_BIN=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=../lib/duration.sh
. "$KP_BIN/../lib/duration.sh"
# shellcheck source=../lib/afk.sh
. "$KP_BIN/../lib/afk.sh"
# shellcheck source=../lib/session.sh
. "$KP_BIN/../lib/session.sh"

DEFAULT_TTL=28800   # 8 hours

die() { echo "kingpin-afk: $*" >&2; exit 1; }
usage_error() { echo "kingpin-afk: $*" >&2; exit 2; }

usage() {
  cat <<'HELP'
usage: kingpin afk [on [--ttl <duration>]|off|status]

  on      arm AFK auto-landing for this orchestrator session
  off     disarm it
  status  print "AFK: on until HH:MM (pid N)", or "AFK: off"

--ttl takes one or more <n><unit> segments, unit s, m, h or d (90m, 8h, 1h30m);
the default is 8h. While armed, `kingpin watch` lands a clean review verdict
through the normal landing gate and holds everything that needs judgement.
The state is session-scoped at $KINGPIN_HOME/afk and `kingpin lock release`
clears it; it also reads as off once the TTL passes or the holder pid is gone.
HELP
}

cmd=${1:-}
case "$cmd" in
  -h|--help) usage; exit 0 ;;
  '') usage >&2; exit 2 ;;
esac
shift

case "$cmd" in
  on)
    ttl=$DEFAULT_TTL
    while [ $# -gt 0 ]; do
      case "$1" in
        --ttl)
          ttl=$(kp_parse_duration "${2:-}") || usage_error "--ttl needs a duration such as 90m, 8h or 1h30m (got '${2:-}')"
          shift 2
          ;;
        -h|--help) usage; exit 0 ;;
        *) usage_error "unknown argument '$1' for 'afk on'" ;;
      esac
    done
    pid=$(kp_session_pid)
    case "$pid" in ''|*[!0-9]*) die "could not determine the session pid" ;; esac
    kp_afk_write "$KP_HOME" "$pid" "$ttl" || die "could not write $KP_HOME/afk"
    kp_afk_line "$KP_HOME"
    ;;
  off)
    [ $# -eq 0 ] || usage_error "unknown argument '$1' for 'afk off'"
    kp_afk_clear "$KP_HOME"
    echo "AFK: off"
    ;;
  status)
    [ $# -eq 0 ] || usage_error "unknown argument '$1' for 'afk status'"
    line=$(kp_afk_line "$KP_HOME")
    printf '%s\n' "${line:-AFK: off}"
    ;;
  *)
    usage_error "unknown command '$cmd' (use on, off or status)"
    ;;
esac
