#!/usr/bin/env bash
# Rename the tmux window of a --text task once its worker has created the
# GitHub issue, so the window reads kp-<n>-<slug> like an --issue task.
#
# Only the window and TMUX_TARGET change. The task ID, the task folder, the
# branch and the worktree keep their first name: the worker holds those paths
# while it runs. Idempotent: a `renamed` marker in the task folder makes later
# calls a no-op, and it is written last, so a failed rename retries.
#
# Usage: kingpin-rename <task-id>
# Command overrides: KINGPIN_GH.
set -euo pipefail

KP_ROOT=$(cd "$(dirname "$0")/.." && pwd)
KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
# shellcheck source=../lib/status.sh
. "$KP_ROOT/lib/status.sh"
# shellcheck source=../lib/tmux.sh
. "$KP_ROOT/lib/tmux.sh"
GH_CMD=${KINGPIN_GH:-gh}
# kingpin-wait calls this synchronously: a hung gh call must not block fleet events.
GH_TIMEOUT=; ! command -v timeout >/dev/null || GH_TIMEOUT="timeout 10"

[ $# -ge 1 ] || { echo "usage: kingpin-rename <task-id>" >&2; exit 1; }
id=$1

task_dir=$KP_HOME/tasks/$id
env_file=$task_dir/task.env
status_file=$task_dir/status
[ -d "$task_dir" ] && [ -f "$env_file" ] || exit 0
[ ! -f "$task_dir/renamed" ] || exit 0
[ -z "$(kp_env_get "$env_file" ISSUE)" ] || exit 0
[ -f "$status_file" ] || exit 0

line=$(grep -E '^issue: #[0-9]+' "$status_file" | head -n 1 || true)
[ -n "$line" ] || exit 0
n=$(printf '%s\n' "$line" | sed -E 's/^issue: #([0-9]+).*/\1/')

project_path=$(kp_env_get "$env_file" PROJECT_PATH)
target=$(kp_env_get "$env_file" TMUX_TARGET)
[ -n "$target" ] || target=kingpin:$id

title=''
# shellcheck disable=SC2086 # GH_TIMEOUT is "timeout N" or empty and must word-split
[ -d "$project_path" ] && title=$(cd "$project_path" && $GH_TIMEOUT $GH_CMD issue view "$n" --json title -q .title 2>/dev/null || true)
slug=$(node "$KP_ROOT/lib/slug.mjs" "$title" 2>/dev/null || true)
[ -n "$slug" ] || slug=${id#kp-}
new=kp-$n${slug:+-$slug}
[[ $new =~ ^[a-z0-9][a-z0-9-]*$ ]] || exit 0

# Resolve the window first (lib/tmux.sh): the task's name, then the recorded id, on
# the socket the record names (issue #142). A rename keeps the window id, so nothing
# else has to be rewritten.
if kp_window_find "$task_dir" >/dev/null 2>&1; then
  kp_tmux "$KP_WINDOW_SOCKET" rename-window -t "$KP_WINDOW_ID" "$new"
fi

session=${target%%:*}
tmp=$env_file.rename.$$
sed "s|^TMUX_TARGET=.*|TMUX_TARGET=$session:$new|" "$env_file" > "$tmp"
mv "$tmp" "$env_file"
printf '%s\n' "$new" > "$task_dir/renamed"
echo "kingpin-rename: $id window renamed to $new"
