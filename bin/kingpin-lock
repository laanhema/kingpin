#!/usr/bin/env bash
# Acquire or inspect the kingpin orchestrator session lock.
# Usage: kingpin-lock [status|check|acquire|release|harness] [--harness claude|agy|opencode] [pid]
#
# The lock file holds the session pid on line 1 and, when known, the agent
# harness of the session (claude, agy or opencode) on line 2. `kingpin spawn`
# uses that harness as the default worker harness (`kingpin-lock harness`).
#
# `acquire` and `release` are serialized by a sibling mutex,
# `$KINGPIN_HOME/orchestrator.lock.mutex`, so the check and the write cannot
# interleave: N sessions that start together get one `lock: acquired` and N-1
# refusals. The mutex is the shared helper in `lib/mutex.sh`, the same one the
# landing lane uses: the owner pid on line 1, created by hard-linking a prepared
# file into place, reclaimed only when its owner is dead or the file is over a
# minute old, and released only by its owner. `flock` is not used because it is
# not available on macOS by default. The lock file itself is published with
# `mktemp` in the same directory plus `mv`, never truncated in place, so
# `status`, `check`, `harness` and `lock_harness` can read it without the mutex
# and still never see a half-written pid or harness line. `release` refuses to
# free a lock whose live owner is another pid.
#
# How `acquire` picks the harness, first match wins:
#   1. --harness <name> on `acquire`
#   2. the KINGPIN_HARNESS environment variable
#   3. the command name (or argv) of the session pid: claude*, agy*, opencode*
#   4. the calling agent's own environment marker: CLAUDECODE=1 -> claude,
#      OPENCODE=1 -> opencode
# Nothing matched (e.g. a codex session): no harness is recorded. The record
# goes away with `release` and is ignored once the holder pid is dead; the next
# `acquire` over a stale lock rewrites the whole file.
set -euo pipefail

KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
LOCK_FILE="$KP_HOME/orchestrator.lock"
MUTEX_FILE="$LOCK_FILE.mutex"
# shellcheck source=../lib/supervisor.sh
. "$(dirname "$0")/../lib/supervisor.sh"
# shellcheck source=../lib/mutex.sh
. "$(dirname "$0")/../lib/mutex.sh"

die() { echo "kingpin-lock: $*" >&2; exit 1; }

usage() {
  cat <<'HELP'
usage: kingpin-lock [status|check|acquire [--harness <name>]|release|harness] [pid]

  status    print `lock: free` or `lock: held by pid <n> (<harness>)`
  check     exit 0 when this session holds the lock, 1 when it does not
  acquire   take the lock for this session (default command)
  release   drop this session's lock; refuses while another live session holds it
  harness   print the harness recorded for the holder (claude, agy, opencode)

--harness records the session's harness on `acquire`. A numeric [pid] overrides
the detected session pid; KINGPIN_LOCK_PID does the same.
HELP
}

is_harness_pid() {
  local p=$1
  [ -n "$p" ] || return 1
  [ "$p" -gt 1 ] 2>/dev/null || return 1
  kill -0 "$p" 2>/dev/null || return 1
  local comm
  comm=$(ps -o comm= -p "$p" 2>/dev/null | tr -d ' ' || true)
  case "$comm" in
    bash|sh|zsh|dash|tmux*) return 1 ;;
    claude|claude-*|agy|agy-*|opencode|opencode-*|codex|codex-*|pi|pi-*|grok|grok-*|kimi|kimi-*) return 0 ;;
  esac
  local args
  args=$(ps -o args= -p "$p" 2>/dev/null || true)
  local pattern='(^|[ /])(claude|agy|opencode|codex|pi|grok|kimi)(-[^ ]*)?([ ]|$)'
  if [[ "$args" =~ $pattern ]]; then
    return 0
  fi
  return 1
}

valid_harness() {
  case "$1" in claude|agy|opencode) return 0 ;; *) return 1 ;; esac
}

# Harness name for a process, from its command name or argv. Empty if unknown.
harness_of_pid() {
  local p=$1 comm args
  [ -n "$p" ] || return 0
  comm=$(ps -o comm= -p "$p" 2>/dev/null | tr -d ' ' || true)
  case "$comm" in
    claude|claude-*) echo claude; return 0 ;;
    agy|agy-*) echo agy; return 0 ;;
    opencode|opencode-*) echo opencode; return 0 ;;
  esac
  args=$(ps -o args= -p "$p" 2>/dev/null || true)
  local pattern='(^|[ /])(claude|agy|opencode)(-[^ ]*)?([ ]|$)'
  if [[ "$args" =~ $pattern ]]; then
    echo "${BASH_REMATCH[2]}"
  fi
}

# Print the harness of the session: explicit choice, then process, then env.
detect_harness() {
  local pid=$1 h=''
  if [ -n "$harness_flag" ]; then
    h=$harness_flag
  elif [ -n "${KINGPIN_HARNESS:-}" ]; then
    h=$KINGPIN_HARNESS
  fi
  if [ -n "$h" ]; then
    valid_harness "$h" || { echo "error: unsupported harness: $h (must be claude, agy, or opencode)" >&2; return 1; }
    echo "$h"
    return 0
  fi
  h=$(harness_of_pid "$pid")
  if [ -z "$h" ]; then
    if [ "${CLAUDECODE:-}" = "1" ]; then h=claude
    elif [ "${OPENCODE:-}" = "1" ]; then h=opencode
    fi
  fi
  echo "$h"
}

# Harness recorded for a live holder; empty when free, stale or not recorded.
lock_harness() {
  [ -f "$LOCK_FILE" ] || return 0
  local pid h
  pid=$(sed -n 1p "$LOCK_FILE" 2>/dev/null || true)
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 0
  h=$(sed -n 2p "$LOCK_FILE" 2>/dev/null | tr -d ' ' || true)
  valid_harness "$h" && echo "$h"
  return 0
}

# Take the orchestrator lock mutex through the shared helper (lib/mutex.sh). On
# failure the helper leaves the last-read owner pid in kp_mutex_owner, and the
# refusal names it: a session that is blocked sees who is blocking it. The wait
# is about 9 s of 250 short retries, so a refusal arrives that long after the
# mutex was taken.
take_mutex() {
  kp_mutex_acquire "$MUTEX_FILE" && return 0
  die "could not take the orchestrator lock mutex (held by pid ${kp_mutex_owner:-unknown} for more than 8 s)"
}

# Publish the lock file atomically: write pid (and the optional harness on line 2)
# to a temp file in the same directory, then rename it into place. A reader sees
# either the old file or the new one, never a truncated pid or harness. The caller
# holds the mutex.
kp_lock_write() {
  local pid=${1:?} harness=${2:-} tmp
  tmp=$(mktemp "${LOCK_FILE}.tmp.XXXXXX" 2>/dev/null) || return 1
  if [ -n "$harness" ]; then
    printf '%s\n%s\n' "$pid" "$harness" > "$tmp" || { rm -f "$tmp"; return 1; }
  else
    printf '%s\n' "$pid" > "$tmp" || { rm -f "$tmp"; return 1; }
  fi
  # The lock file is fleet-visible and used to be written 0644; keep that.
  chmod 0644 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$LOCK_FILE" || { rm -f "$tmp"; return 1; }
  return 0
}

resolve_session_pid() {
  if [ -n "${KINGPIN_LOCK_PID:-}" ] && [[ "${KINGPIN_LOCK_PID:-}" =~ ^[0-9]+$ ]]; then
    echo "$KINGPIN_LOCK_PID"
    return 0
  fi
  if [ -n "${2:-}" ] && [[ "$2" =~ ^[0-9]+$ ]]; then
    echo "$2"
    return 0
  fi
  if [ -n "${1:-}" ] && [[ "$1" =~ ^[0-9]+$ ]]; then
    echo "$1"
    return 0
  fi
  local c1=$PPID
  if is_harness_pid "$c1"; then
    echo "$c1"
    return 0
  fi
  local c2
  c2=$(ps -o ppid= -p "$c1" 2>/dev/null | tr -d ' ' || true)
  if [ -n "$c2" ] && is_harness_pid "$c2"; then
    echo "$c2"
    return 0
  fi
  echo "$c1"
}

cmd=${1:-acquire}
[ $# -eq 0 ] || shift
case "$cmd" in
  -h|--help) usage; exit 0 ;;
esac

harness_flag=''
positional=()
while [ $# -gt 0 ]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --harness) harness_flag=${2:?--harness needs a value}; shift 2 ;;
    *) positional+=("$1"); shift ;;
  esac
done
# resolve_session_pid reads the command as $1 and the optional pid as $2.
set -- "$cmd" ${positional[@]+"${positional[@]}"}
# Created only now that both help arms have exited: `kingpin lock --help` on a
# fresh host prints usage without starting fleet state.
mkdir -p "$KP_HOME"

case "$cmd" in
  status)
    if [ ! -f "$LOCK_FILE" ]; then
      echo "lock: free"
      exit 0
    fi
    pid=$(sed -n 1p "$LOCK_FILE" 2>/dev/null || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      h=$(lock_harness)
      if [ -n "$h" ]; then
        echo "lock: held by pid $pid ($h)"
      else
        echo "lock: held by pid $pid"
      fi
    else
      echo "lock: stale"
    fi
    exit 0
    ;;
  check)
    if [ -f "$LOCK_FILE" ]; then
      pid=$(sed -n 1p "$LOCK_FILE" 2>/dev/null || true)
      if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        target_pid=$(resolve_session_pid "$@")
        if [ "$pid" != "$target_pid" ]; then
          echo "error: another live kingpin orchestrator session holds the lock (pid $pid)" >&2
          exit 1
        fi
      fi
    fi
    echo "lock: verified"
    exit 0
    ;;
  acquire)
    target_pid=$(resolve_session_pid "$@")
    take_mutex
    if [ -f "$LOCK_FILE" ]; then
      pid=$(sed -n 1p "$LOCK_FILE" 2>/dev/null || true)
      if [ -n "$pid" ] && [ "$pid" != "$target_pid" ] && kill -0 "$pid" 2>/dev/null; then
        kp_mutex_release "$MUTEX_FILE"
        echo "error: another live kingpin orchestrator session holds the lock (pid $pid)" >&2
        exit 1
      fi
    fi
    harness=$(detect_harness "$target_pid") || { kp_mutex_release "$MUTEX_FILE"; exit 1; }
    kp_lock_write "$target_pid" "$harness" || { kp_mutex_release "$MUTEX_FILE"; die "could not write $LOCK_FILE"; }
    kp_mutex_release "$MUTEX_FILE"
    if [ -n "$harness" ]; then
      echo "lock: acquired (pid $target_pid, harness $harness)"
    else
      echo "lock: acquired (pid $target_pid)"
    fi
    # The guard file is untracked, so a fresh clone has none, and an older clone may still hold deny rules.
    # `check` says "contract: ..." for a stale contract copy and "guard: ..." for the hook itself.
    guard_out=$("$(dirname "$0")/kingpin-guard" check 2>&1 >/dev/null || true)
    case $guard_out in
      "") ;;
      *contract:*) echo "warning: the orchestrator contract is stale or missing; run 'kingpin guard install'" >&2 ;;
      *) echo "warning: orchestrator guard is not active; run 'kingpin guard install'" >&2 ;;
    esac
    # Nothing starts a supervisor for you: a session that only inspects the fleet
    # would leave a daemon behind. The one line names the command to run.
    if [ -z "$(kp_supervisor_pid "$KP_HOME")" ]; then
      echo "warning: no fleet supervisor is running; run 'kingpin watch'" >&2
    fi
    ;;
  harness)
    lock_harness
    ;;
  release)
    target_pid=$(resolve_session_pid "$@")
    take_mutex
    if [ -f "$LOCK_FILE" ]; then
      pid=$(sed -n 1p "$LOCK_FILE" 2>/dev/null || true)
      if [ -n "$pid" ] && [ "$pid" != "$target_pid" ] && kill -0 "$pid" 2>/dev/null; then
        kp_mutex_release "$MUTEX_FILE"
        echo "error: another live kingpin orchestrator session holds the lock (pid $pid)" >&2
        exit 1
      fi
    fi
    rm -f "$LOCK_FILE"
    kp_mutex_release "$MUTEX_FILE"
    echo "lock: released"
    ;;
  *)
    echo "kingpin-lock: unknown command $cmd" >&2
    exit 2
    ;;
esac
