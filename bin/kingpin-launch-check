#!/usr/bin/env bash
# Record that a worker died at launch: it stopped without writing a single status
# line. kingpin-wait calls this for every task whose `status` file is empty, on every
# pass.
#
# Usage: kingpin-launch-check <task-dir>
#   exit 0  the worker died at launch: `failed: no status: ...` was appended to
#           <task-dir>/status and printed on stdout.
#   exit 1  nothing recorded (it wrote a status line, it is inside the grace
#           period, it is still running, or tmux cannot be asked).
#   exit 2  bad arguments.
#
# A worker has stopped when its tmux window is gone or its panes are dead, or when
# its Stop hook has fired (the `stopped` file) and its window has been silent for
# the grace period without showing a working marker. The Stop hook also fires while
# background agents run, so a pane that shows the markers kingpin-wait's `quiet`
# check skips (keep the two lists in step) is still working. The grace period counts
# from the last Stop, or from CREATED when the worker never stopped.
# KINGPIN_STATUS_GRACE sets it in seconds (default 30).
set -euo pipefail

# shellcheck source=../lib/status.sh
. "$(dirname "$0")/../lib/status.sh"

usage() { echo "usage: kingpin-launch-check <task-dir>" >&2; }

[ $# -eq 1 ] || { usage; exit 2; }
case "$1" in
  -h|--help) usage; exit 0 ;;
  -*) echo "kingpin-launch-check: unknown option '$1'" >&2; usage; exit 2 ;;
esac
task_dir=${1%/}

env_file="$task_dir/task.env"
status_file="$task_dir/status"
[ -f "$env_file" ] || exit 1

has_status() { [ -f "$status_file" ] && grep -q '[^[:space:]]' "$status_file"; }
# A worker that wrote any status line lived long enough to report.
! has_status || exit 1

now=$(date +%s)
grace=${KINGPIN_STATUS_GRACE:-30}
[[ $grace =~ ^[0-9]+$ ]] || grace=30

stop=""
[ -f "$task_dir/stopped" ] && stop=$(tr -d '[:space:]' < "$task_dir/stopped")
[[ $stop =~ ^[0-9]+$ ]] || stop=""
if [ -n "$stop" ]; then
  since=$stop
  since_what="its last stop"
else
  created=$(kp_env_get "$env_file" CREATED)
  # `date -d ""` is midnight, not an error: an empty CREATED must not pass.
  [ -n "$created" ] || exit 1
  since=$(date -d "$created" +%s 2>/dev/null) || exit 1
  since_what="launch"
fi
age=$((now - since))
[ "$age" -ge "$grace" ] || exit 1

id=$(basename "$task_dir")
harness=$(kp_env_get "$env_file" HARNESS)
[ -n "$harness" ] || harness=claude
tmux_target=$(kp_env_get "$env_file" TMUX_TARGET)
[ -n "$tmux_target" ] || tmux_target="kingpin:$id"
# The window ID survives rename and move; older task.env files lack it.
window_id=$(kp_env_get "$env_file" TMUX_WINDOW_ID)
[ -z "$window_id" ] || tmux_target=$window_id

# A tmux server that cannot be reached says nothing about the worker.
tmux list-sessions >/dev/null 2>&1 || exit 1

if panes=$(tmux list-panes -t "$tmux_target" -F '#{pane_dead}' 2>/dev/null); then
  [ -n "$panes" ] || exit 1
  if printf '%s\n' "$panes" | grep -qvx 1; then
    # Alive. Only a worker that stopped and has been silent since counts.
    [ -n "$stop" ] || exit 1
    activity=$(tmux display-message -p -t "$tmux_target" '#{window_activity}' 2>/dev/null || true)
    [[ $activity =~ ^[0-9]+$ ]] || exit 1
    [ $((now - activity)) -ge "$grace" ] || exit 1
    # The Stop hook fires while background agents still run: a pane that shows a
    # working marker is not dead. These are the markers `quiet` skips in kingpin-wait.
    pane_tail=$(tmux capture-pane -pt "$tmux_target" -S -30 2>/dev/null || true)
    case "$harness" in
      claude)
        grep -qE 'Waiting for [0-9]+ background agent|Background agent' <<< "$pane_tail" && exit 1
        ;;
      agy|opencode)
        marker='esc[[:space:]]+to[[:space:]]+cancel'
        [ "$harness" = opencode ] && marker="$marker|Interrupt"
        pane_bottom=$(printf '%s\n' "$pane_tail" | grep -v '^[[:space:]]*$' | tail -12 || true)
        grep -qiE "$marker" <<< "$pane_bottom" && exit 1
        ;;
    esac
    cause="stopped and went silent"
    hint="; kingpin peek $id shows why"
  else
    cause="exited, tmux pane dead"
  fi
else
  cause="exited, tmux window gone"
fi

# The worker is stopped, so nothing races this append; the re-check covers a second caller.
! has_status || exit 1
line="failed: no status: $id ($harness) $cause; never reported a status (${age}s since $since_what${hint:-})"
printf '%s\n' "$line"
printf '%s\n' "$line" >> "$status_file"
exit 0
