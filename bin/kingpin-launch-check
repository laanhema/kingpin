#!/usr/bin/env bash
# Record that a worker died at launch: it stopped without writing a single status
# line. kingpin-wait calls this for every task whose `status` file is empty, on every
# pass.
#
# Usage: kingpin-launch-check <task-dir>
#   exit 0  the worker died at launch: `failed: no status: ...` was appended to
#           <task-dir>/status and printed on stdout.
#   exit 1  nothing recorded (it wrote a status line, it is inside the grace
#           period, it is still running, or tmux cannot be asked).
#   exit 2  bad arguments.
#
# A worker has stopped when its terminal is gone or its panes are dead, or when
# its Stop hook has fired (the `stopped` file) and its terminal has been silent for
# the grace period without showing a working marker. The terminal is whichever one
# the task record names (a tmux window or a Herdr pane). The Stop hook also fires
# while background agents run, so a pane that shows a working marker is still
# working; that marker list is shared with the Stop hook and kingpin-wait in
# lib/status.sh (kp_pane_shows_working). The grace period counts from the last
# Stop, or from CREATED when the worker never stopped.
# KINGPIN_STATUS_GRACE sets it in seconds (default 30).
set -euo pipefail

# shellcheck source=../lib/status.sh
. "$(dirname "$0")/../lib/status.sh"
# shellcheck source=../lib/mux.sh
. "$(dirname "$0")/../lib/mux.sh"
# shellcheck source=../lib/portable.sh
. "$(dirname "$0")/../lib/portable.sh"

usage() { echo "usage: kingpin-launch-check <task-dir>" >&2; }

[ $# -eq 1 ] || { usage; exit 2; }
case "$1" in
  -h|--help) usage; exit 0 ;;
  -*) echo "kingpin-launch-check: unknown option '$1'" >&2; usage; exit 2 ;;
esac
task_dir=${1%/}

env_file="$task_dir/task.env"
status_file="$task_dir/status"
[ -f "$env_file" ] || exit 1

has_status() { [ -f "$status_file" ] && grep -q '[^[:space:]]' "$status_file"; }
# A worker that wrote any status line lived long enough to report.
! has_status || exit 1

now=$(date +%s)
grace=${KINGPIN_STATUS_GRACE:-30}
[[ $grace =~ ^[0-9]+$ ]] || grace=30

stop=""
[ -f "$task_dir/stopped" ] && stop=$(tr -d '[:space:]' < "$task_dir/stopped")
[[ $stop =~ ^[0-9]+$ ]] || stop=""
if [ -n "$stop" ]; then
  since=$stop
  since_what="its last stop"
else
  created=$(kp_env_get "$env_file" CREATED)
  # An empty CREATED is what the old GNU-only `date -Iseconds` wrote on macOS, so
  # task directories already on disk at upgrade time carry it. Report it instead of
  # leaving the worker at (pending) silently; anything else that does not parse is a
  # real failure too, reported rather than read as "now" (what BSD `date -j -f`
  # degrades to). Either way the status file is left untouched.
  if [ -z "$created" ]; then
    echo "kingpin-launch-check: CREATED is empty in $env_file (an older GNU-only date wrote it that way); not judging this worker" >&2
    exit 1
  fi
  if ! since=$(kp_epoch_from_iso "$created"); then
    echo "kingpin-launch-check: cannot parse CREATED='$created' in $env_file (neither date -d nor date -j -f accepted it); not judging this worker" >&2
    exit 1
  fi
  since_what="launch"
fi
age=$((now - since))
[ "$age" -ge "$grace" ] || exit 1

id=$(basename "$task_dir")
harness=$(kp_env_get "$env_file" HARNESS)
[ -n "$harness" ] || harness=claude
# A mux that cannot be reached says nothing about the worker (issue #142, #144).
kp_mux_reachable "$task_dir" || exit 1

# The task's own terminal, found through lib/mux.sh: a tmux window by name first
# (a stale recorded id that now names a foreign window must not be judged as this
# worker's pane), a Herdr pane by label first.
if kp_mux_find "$task_dir" >/dev/null 2>&1; then
  found=1
else
  found=0
fi
case "${KP_MUX:-tmux}" in
  herdr) gone="exited, herdr pane gone" ;;
  *) gone="exited, tmux window gone" ;;
esac
state=''
[ "$found" = 1 ] && state=$(kp_mux_target_state "$KP_WINDOW_ID")
case $state in
  alive)
    # Alive. Only a worker that stopped and has been silent since counts.
    [ -n "$stop" ] || exit 1
    silent=$(kp_mux_activity_age "$task_dir") || exit 1
    [[ $silent =~ ^[0-9]+$ ]] || exit 1
    [ "$silent" -ge "$grace" ] || exit 1
    # The Stop hook fires while background agents still run: a pane that shows a
    # working marker is not dead. The marker list lives in lib/status.sh, shared
    # with the Stop hook and kingpin-wait's `quiet` check.
    pane_tail=$(kp_mux_capture "$KP_WINDOW_ID" --tail 30 2>/dev/null || true)
    if kp_pane_shows_working "$pane_tail" "$harness"; then
      exit 1
    fi
    cause="stopped and went silent"
    hint="; kingpin peek $id shows why"
    ;;
  dead) cause="exited, ${KP_MUX:-tmux} pane dead" ;;
  *) cause=$gone ;;
esac

# The worker is stopped, so nothing races this append; the re-check covers a second caller.
! has_status || exit 1
line="failed: no status: $id ($harness) $cause; never reported a status (${age}s since $since_what${hint:-})"
printf '%s\n' "$line"
printf '%s\n' "$line" >> "$status_file"
exit 0
