#!/usr/bin/env bash
# Record a worker's turn end and make its outcome explicit (issue #102).
#
# One Stop hook for all four harnesses: Claude Code's worker/hooks.json, agy's
# .agents/hooks.json, OpenCode's .opencode/plugins/kingpin-stop.js, and Pi's
# worker/pi/kingpin-harness.ts extension, which runs this script on agent_settled.
# It writes the `stopped` timestamp exactly as the old one-line hook did, then fills
# the one hole the status protocol allows: a worker that ended a turn without reporting.
#
# The turn boundary is the previous `stopped` file. A status file that is newer than
# it was written during this turn (bash's -nt compares mtimes, so the protocol needs
# no new state file). kingpin-listen moves that boundary when it appends a note, so
# a listener note never passes for the worker's report. The first stop has no
# boundary yet and the whole session is one turn, so any worker event counts as a
# report.
#
#   no status this turn, last line needs-input:/feedback:  -> waiting: <kind> <path>
#   no status this turn, anything else, pane idle          -> failed: no status: stopped without reporting
#   no status this turn, pane still shows a working marker -> left untouched (background agents run)
#   a status was written this turn                         -> left untouched
#
# Pi is exempt from the pane check: its extension runs this hook synchronously from
# `agent_settled`, before the TUI repaints, so the pane still shows the working rule
# while the turn is over (see pane_is_working).
#
# A stop hook that fails must not trap the session: every write is best effort, a
# failure is named on stderr, and the exit status is always 0.
#
# Usage: kingpin-stop   (reads $KINGPIN_TASK_DIR)
set -euo pipefail

KP_ROOT=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=../lib/status.sh
. "$KP_ROOT/lib/status.sh"
# shellcheck source=../lib/tmux.sh
. "$KP_ROOT/lib/tmux.sh"

task_dir=${KINGPIN_TASK_DIR:-}
if [ -z "$task_dir" ] || [ ! -d "$task_dir" ]; then
  echo "kingpin-stop: KINGPIN_TASK_DIR is unset or not a directory; the worker's outcome is not recorded" >&2
  exit 0
fi

status_file="$task_dir/status"
stopped_file="$task_dir/stopped"
now=$(date +%s)

warn() { echo "kingpin-stop: $*" >&2; }

# The Stop hook also fires while background agents still run (its harness has
# nothing to wait for once the foreground turn ends). A pane that shows a working
# marker is still working, and a missing line is not a failure yet. The marker list
# lives in lib/status.sh (kp_pane_shows_working), where kingpin-wait's `quiet` check
# and kingpin-launch-check read the same list, so the three cannot disagree.
pane_is_working() {
  local env_file="$task_dir/task.env"
  [ -f "$env_file" ] || return 1
  local harness pane_tail
  harness=$(kp_env_get "$env_file" HARNESS)
  [ -n "$harness" ] || harness=claude
  # Pi is never "still working" here. `agent_settled` is Pi's final idle signal (it
  # fires after agent_end, with no retry or compaction left), Pi has no subagent tool,
  # and the extension runs this hook synchronously inside that event, before the TUI
  # repaints: the pane still shows the working rule for a finished turn. Gating on it
  # would drop the failed: line every silent pi turn (issue #93 review, H4). The
  # shared marker list still covers pi for kingpin-wait and kingpin-launch-check,
  # where the pane is live.
  if [ "$harness" = pi ]; then return 1; fi
  # The task's own window, by name first (lib/tmux.sh), on the socket the record
  # names (issue #142). A pane that cannot be found is not "working", exactly as
  # before.
  kp_window_find "$task_dir" >/dev/null 2>&1 || return 1
  pane_tail=$(kp_tmux "$KP_WINDOW_SOCKET" capture-pane -pt "$KP_WINDOW_ID" -S -30 2>/dev/null) || return 1
  kp_pane_shows_working "$pane_tail" "$harness"
}

last=$(kp_status_last "$status_file")
newest=$(kp_status_newest "$status_file")

# A finished task has nothing left to report.
if kp_status_is_terminal "$last"; then
  :
else
  fresh=0
  if [ -s "$status_file" ] && [ "$(kp_status_worker_events "$status_file")" -gt 0 ]; then
    if [ ! -f "$stopped_file" ]; then
      fresh=1
    elif [ "$status_file" -nt "$stopped_file" ]; then
      # A line appended after the previous turn ended belongs to this turn.
      fresh=1
    fi
  fi

  if [ "$fresh" -eq 0 ]; then
    if kp_status_is_silent "$newest" || [ "${newest%%:*}" = waiting ]; then
      # This stop is already recorded for the same state; do not pile up lines.
      :
    elif kp_status_is_waiting "$newest"; then
      kind=${newest%%:*}
      path="$task_dir/question.md"
      [ "$kind" = feedback ] && path="$task_dir/feedback.md"
      printf '%s\n' "waiting: $kind $path" 2>/dev/null >> "$status_file" \
        || warn "cannot append the waiting line to $status_file"
    else
      if pane_is_working; then
        :
      else
        printf '%s\n' 'failed: no status: stopped without reporting' 2>/dev/null >> "$status_file" \
          || warn "cannot append the missing status to $status_file"
      fi
    fi
  fi
fi

# The marker kingpin-wait, kingpin-launch-check and kingpin-ack read. The old hook
# wrote it unconditionally, even when the worker had reported.
printf '%s\n' "$now" > "$stopped_file" 2>/dev/null || warn "cannot write $stopped_file"

exit 0
