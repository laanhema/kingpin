#!/usr/bin/env bash
# Land a ready task: fix findings if needed, serialize landing per project,
# and send /issue-flow-done to the worker.
#
# The review gate fails closed: a status line whose verdict cannot be read never
# creates landing_sent. It prints the line it could not parse and exits 1.
#
# Usage: kingpin-land <task-id>
set -euo pipefail

KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
KP_BIN=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=../lib/status.sh
. "$KP_BIN/../lib/status.sh"
# shellcheck source=../lib/landing.sh
. "$KP_BIN/../lib/landing.sh"

usage() {
  cat <<'HELP'
usage: kingpin-land <task-id>

Land a ready task: run the fix pass when the review has findings, serialize
landing per project, and send /issue-flow-done to the worker. The review gate
fails closed: a `ready:` line whose verdict cannot be read lands nothing.
HELP
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac
[ $# -ge 1 ] || { echo "usage: kingpin-land <task-id>" >&2; exit 1; }
[ $# -le 1 ] || { echo "kingpin-land: unknown argument: $2" >&2; exit 1; }
id=$1

task_dir="$KP_HOME/tasks/$id"
[ -d "$task_dir" ] || { echo "kingpin-land: task $id not found: $task_dir" >&2; exit 1; }

env_file="$task_dir/task.env"
[ -f "$env_file" ] || { echo "kingpin-land: task.env missing in $task_dir" >&2; exit 1; }

project=$(kp_env_get "$env_file" PROJECT)
issue=$(kp_env_get "$env_file" ISSUE)
worktree=$(kp_env_get "$env_file" WORKTREE)
[ -n "$project" ] || project="default"

status_file="$task_dir/status"
# The gate needs the worker's own last event (kp_status_last skips listener notes).
last_status=$(kp_status_last "$status_file")

if [ -z "$issue" ] && [ -f "$status_file" ]; then
  # Parse issue number from status if not in task.env
  if grep -E -q '^issue: #[0-9]+' "$status_file"; then
    issue=$(grep -E '^issue: #[0-9]+' "$status_file" | head -n 1 | sed -E 's/^issue: #([0-9]+).*/\1/')
  fi
fi

# Handle fixed: status line
if [[ $last_status =~ ^fixed: ]]; then
  # A fixed: line may carry the review verdict too. When it does, it has to agree
  # that the review is clean; a line that says both "fixed" and "findings still
  # open" is self-contradictory, so the gate refuses rather than merge on it.
  if [ "$(kp_status_field_count "$last_status" review)" -gt 0 ]; then
    fixed_verdict=$(kp_status_verdict "$last_status")
    if [ "$(kp_verdict_kind "$fixed_verdict")" != "clean" ]; then
      echo "kingpin-land: task $id: this fixed: line carries a review verdict that is not clean: $last_status" >&2
      echo "kingpin-land: not landing; the worker reports: fixed: high=<n> report=<path>, with review=APPROVE only when it is clean" >&2
      exit 1
    fi
  fi
  # Parsed as a field, not matched inside the line: a report path such as
  # report=high=0.md or a key such as nothigh=3 is not a count.
  high=$(kp_status_field "$last_status" high)
  if ! [[ $high =~ ^[0-9]+$ ]]; then
    # A fix pass that reports no count makes "no High findings left" unprovable,
    # so the gate refuses instead of assuming zero.
    echo "kingpin-land: task $id: cannot read high=<n> from this status line: $last_status" >&2
    echo "kingpin-land: not landing; the worker reports: fixed: high=<n> report=<path>" >&2
    exit 1
  fi
  if [ "$high" -gt 0 ]; then
    # The outcome line is the last stdout line: kingpin-send's own "OK" line is
    # silenced, because kingpin-listen shows the last line to the reviewer.
    echo "kingpin-land: task $id fix pass left $high High/Critical finding(s): not landing yet, requesting a re-review (/review); run kingpin land again once the worker reports ready:"
    if [ -n "$issue" ]; then
      "$KP_BIN/kingpin-send" "$id" "/review --issue $issue" >/dev/null
    else
      "$KP_BIN/kingpin-send" "$id" "/review" >/dev/null
    fi
    exit 0
  fi
  landing_reason="the fix pass completed cleanly"
else
  # Extract report and review verdict if present, in any field order
  verdict=$(kp_status_verdict "$last_status")
  report=$(kp_status_field "$last_status" report)

  resolved_report=""
  if [ -n "$report" ] && [ "$report" != "none" ]; then
    if [[ "$report" != /* ]] && [ -n "$worktree" ]; then
      resolved_report="$worktree/$report"
    else
      resolved_report="$report"
    fi
  fi

  case $(kp_verdict_kind "$verdict") in
    findings)
      # NEEDS CHANGES and APPROVE WITH NITS: run /fix-findings first
      echo "kingpin-land: task $id review has findings ($verdict): running the fix pass first (/fix-findings), not landing yet; landing continues after the worker reports fixed: (kingpin watch does it, or run kingpin land again)"
      touch "$task_dir/landing_in_progress"
      if [ -n "$resolved_report" ]; then
        "$KP_BIN/kingpin-send" "$id" "/fix-findings $resolved_report" >/dev/null
      else
        "$KP_BIN/kingpin-send" "$id" "/fix-findings" >/dev/null
      fi
      exit 0
      ;;
    clean)
      landing_reason="the review is clean ($verdict)"
      ;;
    *)
      # Fail closed: a verdict the gate cannot read never lands. An empty verdict
      # is either a missing review= field, an empty one or a repeated one, which
      # are different mistakes for the operator to fix.
      echo "kingpin-land: task $id: cannot read a review verdict from this status line: $last_status" >&2
      if [ -z "$verdict" ]; then
        case $(kp_status_field_count "$last_status" review) in
          0) echo "kingpin-land: the line has no review= field; the worker reports: ready: branch=<b> review=<verdict> report=<path>" >&2 ;;
          1) echo "kingpin-land: the line has an empty review= field; the worker reports: ready: branch=<b> review=<verdict> report=<path>" >&2 ;;
          *) echo "kingpin-land: the line repeats the review= field; the worker reports it once: ready: branch=<b> review=<verdict> report=<path>" >&2 ;;
        esac
      else
        echo "kingpin-land: expected review=APPROVE, APPROVE WITH NITS or NEEDS CHANGES; not landing" >&2
      fi
      exit 1
      ;;
  esac
fi

# Project-level serialization lane. The claim is atomic (lib/landing.sh takes a
# short-lived mkdir mutex), so two concurrent land runs for different tasks
# cannot both dispatch: the loser queues and the winner holds the lane.
mkdir -p "$KP_HOME/projects"
acquire_rc=0
kp_landing_acquire "$KP_HOME" "$project" "$id" || acquire_rc=$?
if [ "$acquire_rc" -eq 2 ]; then
  echo "kingpin-land: task $id: could not take the project $project landing lock" >&2
  exit 1
fi
if [ "$acquire_rc" -eq 1 ]; then
  holder=$(kp_landing_holder "$KP_HOME" "$project")
  enqueue_rc=0
  kp_landing_enqueue "$KP_HOME" "$project" "$id" || enqueue_rc=$?
  if [ "$enqueue_rc" -eq 2 ]; then
    # Not queued and not dispatched: say so and fail, because exiting 0 here
    # would tell the operator the landing is queued when nothing recorded it.
    echo "kingpin-land: task $id: could not queue behind $holder for project $project" >&2
    exit 1
  fi
  # An entry appended between the holder check and its release would otherwise
  # sit in a queue with no holder, so re-check once after queueing.
  acquire_rc=0
  kp_landing_acquire "$KP_HOME" "$project" "$id" || acquire_rc=$?
  if [ "$acquire_rc" -eq 2 ]; then
    echo "kingpin-land: task $id: could not take the project $project landing lock" >&2
    exit 1
  fi
  if [ "$acquire_rc" -eq 1 ]; then
    holder=$(kp_landing_holder "$KP_HOME" "$project")
    echo "kingpin-land: project $project is already landing $holder; queuing $id"
    exit 0
  fi
fi
touch "$task_dir/landing_sent"

if [ -n "$issue" ]; then
  land_cmd="/issue-flow-done $issue"
  started_msg="kingpin-land: task $id: $landing_reason; starting landing (sending /issue-flow-done $issue)"
else
  land_cmd="/create-pr-merge"
  started_msg="kingpin-land: task $id: $landing_reason; starting landing (no issue number found, sending /create-pr-merge)"
fi
# Printed only once the send reached the worker: kingpin-listen answers a dossier
# with the first line of a failed run, so that line has to be the failure. On
# success this stays the last stdout line, which kingpin-listen shows too.
if "$KP_BIN/kingpin-send" "$id" "$land_cmd" >/dev/null; then
  echo "$started_msg"
  exit 0
fi
# Nothing reached the worker (a dead tmux window, for example). Keeping the lock
# and landing_sent would tell kingpin-listen "already landing" and hide the
# failure, so release the lane and let the next land acquire it.
echo "kingpin-land: task $id: could not send '$land_cmd' (the worker window is gone?)" >&2
rm -f "$task_dir/landing_sent"
# Report what the release actually did: a release that fails leaves the lane
# held by a task that can no longer land, which is the wedge this lane removes.
if kp_landing_release "$KP_HOME" "$project" "$id"; then
  echo "kingpin-land: released the project $project landing lock; the next land can take it" >&2
else
  echo "kingpin-land: task $id: could not release the project $project landing lock; run kingpin done $id --force" >&2
fi
exit 1
