#!/usr/bin/env bash
# Unified entrypoint for the Kingpin orchestrator fleet.
set -euo pipefail

KP_BIN=$(cd "$(dirname "$0")" && pwd)
KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
# shellcheck source=../lib/status.sh
. "$KP_BIN/../lib/status.sh"
# shellcheck source=../lib/supervisor.sh
. "$KP_BIN/../lib/supervisor.sh"
# shellcheck source=../lib/afk.sh
. "$KP_BIN/../lib/afk.sh"
# shellcheck source=../lib/tmux.sh
. "$KP_BIN/../lib/tmux.sh"
# shellcheck source=../lib/browser.sh
. "$KP_BIN/../lib/browser.sh"
# shellcheck source=../lib/dossier.sh
. "$KP_BIN/../lib/dossier.sh"

usage() {
  cat << 'HELP'
Kingpin — Multi-Worker Fleet Orchestrator

Usage: kingpin <command> [arguments...]

Commands:
  init      Configure a project (auto-detects git directory if omitted)
  spawn     Start a worker in a leased worktree on a background tmux window
  run       Start a worker and follow it to completion / review
  watch     Run the fleet supervisor (one per fleet; refuses a second copy)
  land      Land a ready worker; when its review has findings, run the fix pass first (alias: approve)
  done      Verify merge, release worktree lease, and advance queue
  restore   Bring every live task's window back after a tmux server restart
  send      Send input or approval keys to a worker
  peek      Show the last lines of a worker's tmux pane (read-only)
  sync      Fast-forward the main checkout from its upstream (ff-only; refuses a tracked change, an untracked overwrite or a worktree)
  listen    Maintain background Lavish listener and handle review actions
  wait      Wait for fleet task events (blocking or --once)
  ack       Acknowledge task events to advance seen counters
  list      Display active tasks in the terminal (--all adds finished ones)
  brief     Print one bounded fleet digest: live tasks, approvals, dossiers, lanes, queue, AFK
  stats     Summarize the fleet's finished work: verdicts, fix passes, failures and time to merged
  lock      Check, acquire, or release the orchestrator session lock (records its harness)
  afk       Arm or disarm automatic landing while you are away (session-scoped)
  guard     Install or verify the orchestrator-only tool guard (a hook) and contract
  scope     Name the instruction files a harness loads for a worker, check them, or report the readiness of the harness it names (pi, codex)
  report    Generate or check the @pierre/diffs blocks and the prose of a review dossier
  curate    Aggregate critique logs from finished workers

Run 'kingpin <command> --help' for details on a specific command.
HELP
  exit 0
}

[ $# -ge 1 ] || usage

cmd=$1; shift

case "$cmd" in
  init)
    exec "$KP_BIN/kingpin-init" "$@"
    ;;
  spawn)
    exec "$KP_BIN/kingpin-spawn" "$@"
    ;;
  ack)
    exec "$KP_BIN/kingpin-ack" "$@"
    ;;
  wait)
    exec "$KP_BIN/kingpin-wait" "$@"
    ;;
  watch)
    exec "$KP_BIN/kingpin-watch" "$@"
    ;;
  land|approve)
    exec "$KP_BIN/kingpin-land" "$@"
    ;;
  done)
    exec "$KP_BIN/kingpin-done" "$@"
    ;;
  restore)
    exec "$KP_BIN/kingpin-restore" "$@"
    ;;
  send)
    exec "$KP_BIN/kingpin-send" "$@"
    ;;
  peek)
    exec "$KP_BIN/kingpin-peek" "$@"
    ;;
  sync)
    exec "$KP_BIN/kingpin-sync" "$@"
    ;;
  lock)
    exec "$KP_BIN/kingpin-lock" "$@"
    ;;
  afk)
    exec "$KP_BIN/kingpin-afk" "$@"
    ;;
  guard)
    exec "$KP_BIN/kingpin-guard" "$@"
    ;;
  scope)
    exec "$KP_BIN/kingpin-scope" "$@"
    ;;
  report)
    exec "$KP_BIN/kingpin-report" "$@"
    ;;
  curate)
    exec "$KP_BIN/kingpin-curate" "$@"
    ;;
  listen)
    exec "$KP_BIN/kingpin-listen" "$@"
    ;;
  stats)
    exec "$KP_BIN/kingpin-stats" "$@"
    ;;
  brief)
    exec "$KP_BIN/kingpin-brief" "$@"
    ;;
  list|status)
    "$KP_BIN/kingpin-guard" warn || true
    show_all=0
    for arg in "$@"; do
      case "$arg" in
        --all|-a) show_all=1 ;;
        -h|--help)
          echo "usage: kingpin list [--all|-a]"
          echo "  Lists live fleet tasks; --all (or -a) also shows finished (archived) tasks."
          echo "  The SESSION column names the tmux session each worker's window lives in."
          echo "  Always prints a 'Supervisor: running (pid N, since HH:MM)' line, or"
          echo "  'Supervisor: none - run kingpin watch' when no fleet supervisor runs,"
          echo "  and 'AFK: on until HH:MM (pid N)' while AFK auto-landing is armed."
          echo "  A live row also gets a '↳ Browser:' line naming the browser daemons it holds,"
          echo "  with their memory total, so a leak is visible without ps."
          exit 0
          ;;
        *) echo "kingpin list: unknown argument '$arg'" >&2; exit 2 ;;
      esac
    done

    print_task_row() {
      local d=$1 suffix=${2:-}
      local tid env_file proj harness mode status_file st listen_info lpid url
      local state lines seen window_alive tmux_target tmux_socket live_session
      local liveness task_state
      tid=$(basename "$d")
      env_file="$d/task.env"
      proj="-" harness="claude" mode="review"
      tmux_target='' tmux_socket=''
      if [ -f "$env_file" ]; then
        proj=$(kp_env_get "$env_file" PROJECT)
        [ -n "$proj" ] || proj="-"
        harness=$(kp_env_get "$env_file" HARNESS)
        [ -n "$harness" ] || harness="claude"
        mode=$(kp_env_get "$env_file" MODE)
        [ -n "$mode" ] || mode="review"
        # Where the worker lives (issue #142): socket, session, window.
        tmux_socket=$(kp_tmux_socket_from_env "$env_file")
        tmux_target=$(kp_env_get "$env_file" TMUX_TARGET)
        [ -n "$tmux_target" ] || tmux_target="kingpin:$tid"
      fi
      # The task's own window, resolved once by name first and by id second (lib/tmux.sh),
      # on the socket the record names. A stale recorded id that now names a stranger's
      # window is not this task's, so a fleet whose tmux server died reads as dead instead
      # of healthy (issue #149). An archived row never probes: its window was killed by
      # `kingpin done`, and a window check would only say DEAD for good.
      window_alive=0 live_session=''
      if [ -z "$suffix" ] && kp_window_find "$d" >/dev/null 2>&1; then
        window_alive=1
        tmux_socket=$KP_WINDOW_SOCKET
        live_session=$(kp_tmux "$KP_WINDOW_SOCKET" display-message -p -t "$KP_WINDOW_ID" '#S' 2>/dev/null || true)
      fi
      [ -n "$live_session" ] || live_session=${tmux_target%%:*}
      [ -n "$live_session" ] || live_session='-'
      status_file="$d/status"
      st="(pending)"
      state="-"
      # DEAD is a live task whose window is gone, or whose recorded harness is no
      # longer in the window that carries its name, whether or not the record has a
      # status file or a `harness.pid`: an older record (or a curator record) has
      # neither, and `kp_window_harness_live` falls back to the pane's command for it.
      # WAITING and SILENT still describe a pane that is really there, which is why
      # `pane` is a shape of its own: a window that outlived its harness is DEAD while
      # the job runs on, but a finished silent stop keeps the SILENT row it always had.
      # The token itself comes from `kp_task_state` (lib/status.sh), the classifier
      # `kingpin brief` reads too, so the board and the digest cannot disagree.
      liveness=skip
      if [ -z "$suffix" ]; then
        if [ "$window_alive" -eq 0 ]; then
          liveness=dead
        elif kp_window_harness_live "$d"; then
          liveness=live
        else
          liveness=pane
        fi
      fi
      if [ -f "$status_file" ] && [ -s "$status_file" ]; then
        st=$(kp_status_newest "$status_file")
        # Events appended since the last `kingpin ack` (the supervisor acks what
        # it dispatches), so an event nobody has looked at stays visible.
        lines=$(wc -l < "$status_file" | tr -d ' ')
        seen=0
        [ -f "$d/seen" ] && seen=$(tr -d ' ' < "$d/seen" 2>/dev/null || echo 0)
        case "$seen" in ''|*[!0-9]*) seen=0 ;; esac
        case "$lines" in ''|*[!0-9]*) lines=0 ;; esac
        if [ "$lines" -gt "$seen" ]; then
          if [ "$state" = "-" ]; then
            state="Unseen: $((lines - seen))"
          else
            state="$state Unseen: $((lines - seen))"
          fi
        fi
      fi
      task_state=$(kp_task_state "$status_file" "$liveness")
      if [ "$task_state" != none ]; then
        state=$task_state
        if [ "$task_state" = DEAD ]; then
          dead_count=$((dead_count + 1))
        fi
      fi
      printf "%-22s %-10s %-8s %-12s %-10s %-18s %s%s\n" "$tid" "$proj" "$harness" "$mode" "$live_session" "$state" "$st" "$suffix"
      # Name the server and session that hold a live worker, so an operator can
      # attach to it (issue #142). A dead worker's window is gone, and so is an
      # archived row's, so neither names one.
      if [ -z "$suffix" ] && [ -f "$env_file" ] && [ "$window_alive" -eq 1 ]; then
        local where
        where="$(kp_tmux_label "$tmux_socket") $live_session"
        printf "  %-20s %s\n" "↳ Window:" "$where ($KP_WINDOW_ID)"
      fi
      # The browser daemons this task holds right now (issue #160), read from the one table
      # the caller loaded: a worker that drove chrome-devtools-axi left its bridge and
      # headless Chrome behind, keyed by the task folder or the worktree it was started
      # from. The line is the leak made visible without ps; a task that drives no browser
      # gets none, and an archived row's daemons are the cleanup's business, not the board's.
      if [ -z "$suffix" ] && [ -n "$browser_table" ]; then
        local browser_worktree browser_rows browser_count browser_rss browser_pids
        browser_worktree=''
        if [ -f "$env_file" ]; then browser_worktree=$(kp_env_get "$env_file" WORKTREE); fi
        browser_rows=$(printf '%s\n' "$browser_table" \
          | kp_browser_rows_under "$d" ${browser_worktree:+"$browser_worktree"})
        if [ -n "$browser_rows" ]; then
          browser_count=$(printf '%s\n' "$browser_rows" | wc -l | tr -d ' ')
          browser_rss=$(printf '%s\n' "$browser_rows" | awk -F'\t' '{ total += $2 } END { printf "%d", total }')
          browser_pids=$(printf '%s\n' "$browser_rows" | awk -F'\t' '{ pids = pids (pids == "" ? "" : ", ") $1 } END { printf "%s", pids }')
          if [ "$browser_count" -eq 1 ]; then
            printf "  %-20s %s\n" "↳ Browser:" "1 daemon, $(kp_browser_size "$browser_rss") (pid $browser_pids)"
          else
            printf "  %-20s %s\n" "↳ Browser:" "$browser_count daemons, $(kp_browser_size "$browser_rss") (pid $browser_pids)"
          fi
        fi
      fi
      if [ -z "$suffix" ] && [ -f "$d/report.html" ]; then
        # A dossier nobody listens to is named as such (issue #186): an open page with no
        # listener behind it answers no click, and before this it read like a live review.
        listen_info=" (no listener)"
        # The URL the listener recorded when it opened the page (issue #146): handing it
        # over opens no second tab. Without one, the command that opens the page is the
        # only way in, so it stays as the fallback.
        url=""
        [ -s "$d/dossier.url" ] && url=$(head -n 1 "$d/dossier.url")
        if [ -f "$d/listener.pid" ]; then
          lpid=$(cat "$d/listener.pid" 2>/dev/null || true)
          if [ -n "$lpid" ] && kill -0 "$lpid" 2>/dev/null; then
            listen_info=" (listening: pid $lpid)"
          fi
        fi
        printf "  %-20s %s%s\n" "↳ Review:" "${url:-lavish-axi $d/report.html}" "$listen_info"
      fi
    }

    # Live tasks: finished ones (cleanup done) are hidden unless --all.
    # An archived task keeps a symlink at tasks/<id> so its dossier path still
    # resolves (issue #115); it is not a live record, and --all shows it once,
    # from archive/.
    live_dirs=()
    dead_count=0
    for d in "$KP_HOME/tasks"/*; do
      kp_task_is_live "$d" || continue
      if [ "$show_all" -eq 0 ] && [ -f "$d/done_cleaned" ]; then continue; fi
      live_dirs+=("$d")
    done
    archived_dirs=()
    if [ "$show_all" -eq 1 ]; then
      for d in "$KP_HOME/archive"/*; do
        [ -d "$d" ] || continue
        archived_dirs+=("$d")
      done
    fi

    # One `ps` pass feeds every live row's browser line (issue #160); an archived row is
    # never asked for one, and a fleet with no live task runs no scan at all.
    browser_table=''
    if [ ${#live_dirs[@]} -gt 0 ]; then
      browser_table=$(kp_browser_daemons)
    fi

    if [ ${#live_dirs[@]} -eq 0 ] && [ ${#archived_dirs[@]} -eq 0 ]; then
      echo "No tasks in fleet."
    else
      printf "%-22s %-10s %-8s %-12s %-10s %-18s %s\n" "TASK ID" "PROJECT" "HARNESS" "MODE" "SESSION" "STATE" "LAST STATUS"
      printf "%-22s %-10s %-8s %-12s %-10s %-18s %s\n" "-------" "-------" "-------" "----" "-------" "-----" "-----------"
      for d in ${live_dirs[@]+"${live_dirs[@]}"}; do
        suffix=""
        [ -f "$d/done_cleaned" ] && suffix=" (finished)"
        print_task_row "$d" "$suffix"
      done
      for d in ${archived_dirs[@]+"${archived_dirs[@]}"}; do
        print_task_row "$d" " (archived)"
      done
    fi
    # One warning per server that no longer answers while live records still name it
    # (issue #165): a dead server reads as a table of DEAD rows, and the operator needs
    # the socket named, not only the tasks. The line goes to stderr and is silenced by
    # KINGPIN_SKIP_SOCKET_WARN=1, the same shape as KINGPIN_SKIP_GUARD=1.
    warn_unreachable_sockets() {
      local d sock seen=' ' ids id isock
      for d in ${live_dirs[@]+"${live_dirs[@]}"}; do
        sock=$(kp_tmux_socket_from_env "$d/task.env")
        case "$seen" in *" ${sock:-default} "*) continue ;; esac
        seen="$seen${sock:-default} "
        kp_tmux_socket_reachable "$sock" && continue
        ids=''
        for id in ${live_dirs[@]+"${live_dirs[@]}"}; do
          # Compare the normalized socket: a record written before the split names no
          # socket and one naming `default` are the same server, and the dedupe above
          # already treats them as one (issue #165 review M2).
          isock=$(kp_tmux_socket_from_env "$id/task.env")
          [ "${isock:-default}" = "${sock:-default}" ] || continue
          ids=${ids:+"$ids "}$(basename "$id")
        done
        # shellcheck disable=SC2086 # ids is a space-separated list of task ids
        kp_tmux_socket_warn_line "$sock" $ids
      done
    }

    # Dossiers left open on finished tasks (issue #186). A finished row is hidden from
    # the table unless --all, and with it the review line that shows a session, so a tab
    # a reviewer left open would be invisible on the board. One line per record that still
    # has an open session, archived or merely finished; `kingpin watch` ends it on its
    # next sweep, and the line is what an operator reads before that happens.
    print_open_dossiers() {
      local d id url rows=''
      for d in "$KP_HOME"/tasks/* "$KP_HOME"/archive/*; do
        [ -d "$d" ] || continue
        case "$d" in
          "$KP_HOME"/tasks/*) kp_task_is_live "$d" || continue ;;
        esac
        kp_dossier_open "$KP_HOME" "$d" || continue
        id=$(basename "$d")
        url=$(head -n 1 "$d/dossier.url" 2>/dev/null || true)
        rows="${rows}$(printf '  %-22s %s\n' "$id" "$url")"$'\n'
      done
      [ -n "$rows" ] || return 0
      printf '\nDossiers left open on finished tasks (kingpin watch ends them):\n%s' "$rows"
    }

    # The attach command comes from lib/tmux.sh, the one place that knows how a socket
    # is named: the default server is the operator's own and takes a plain `tmux
    # attach`, a name takes `-L`, and a socket path takes `-S` (issue #191). A
    # hardcoded `-t kingpin` would not do: the default server holds the operator's
    # sessions, not the fleet's (issue #165 review M1, L1).
    socket_attach_cmd() {
      kp_tmux_attach_cmd "${1:-}"
    }

    # Where the workers really live, and how to look at them by hand (issue #142). The
    # line is built from the sockets the live records name, not from the caller's
    # KINGPIN_TMUX_SOCKET: a fleet running on the operator's default server used to be
    # told to attach to a server that held no worker (issue #165). With no live task
    # the fleet's own socket is named instead, the one a spawn started outside tmux
    # uses; a spawn inside tmux follows the caller's socket, which this board cannot
    # predict without resolving a target for it.
    print_socket_footer() {
      local d sock seen=' ' any=0
      for d in ${live_dirs[@]+"${live_dirs[@]}"}; do
        sock=$(kp_tmux_socket_from_env "$d/task.env")
        case "$seen" in *" ${sock:-default} "*) continue ;; esac
        seen="$seen${sock:-default} "
        any=1
        printf "Workers live on the tmux server '%s': %s (kingpin peek <task-id> reads one pane)\n" \
          "${sock:-default}" "$(socket_attach_cmd "$sock")"
      done
      if [ "$any" -eq 0 ]; then
        sock=$(kp_tmux_socket_for "$KP_HOME")
        printf "Workers live on the tmux server '%s': %s (kingpin peek <task-id> reads one pane)\n" \
          "$sock" "$(socket_attach_cmd "$sock")"
      fi
    }

    # A fleet whose windows are gone used to read as healthy. Say it plainly, and say
    # what brings it back, before the supervisor and lock lines.
    if [ "${dead_count:-0}" -gt 0 ]; then
      printf 'Fleet: %s live task(s) have no live window; run kingpin restore\n' "$dead_count"
    fi
    print_open_dossiers
    warn_unreachable_sockets
    printf '\n'
    print_socket_footer
    # Whether anyone is watching the fleet, and how to start a supervisor when not.
    printf "\n%s\n" "$(kp_supervisor_line "$KP_HOME")"
    afk_line=$(kp_afk_line "$KP_HOME")
    [ -z "$afk_line" ] || printf '%s\n' "$afk_line"
    lock_line=$("$KP_BIN/kingpin-lock" status 2>/dev/null || true)
    case "$lock_line" in
      "lock: held"*) printf "\nOrchestrator %s (new workers default to its harness)\n" "$lock_line" ;;
    esac
    ;;
  run)
    # kingpin run: spawn worker, then follow until complete or ready
    # --help belongs to spawn's usage: parsing it as a spawned task would fail
    # on the empty spawn output ("could not determine task id").
    case "${1:-}" in
      -h|--help) exec "$KP_BIN/kingpin-spawn" --help ;;
    esac
    out=$("$KP_BIN/kingpin-spawn" "$@")
    echo "$out"
    # Extract task id from spawn output
    task_id=$(echo "$out" | sed -n 's/.*spawned \([a-z0-9-]*\) .*/\1/p' || true)
    [ -n "$task_id" ] || { echo "could not determine task id from spawn output" >&2; exit 1; }

    task_dir="$KP_HOME/tasks/$task_id"
    mode="review"
    mode=$(kp_env_get "$task_dir/task.env" MODE)
    [ -n "$mode" ] || mode="review"

    echo "[kingpin run] Monitoring $task_id (mode: $mode)..."
    while true; do
      # Step supervision loop
      "$KP_BIN/kingpin-watch" --once >/dev/null 2>&1 || true

      # kingpin-watch may already have cleaned up and archived the task. The task
      # path is the signal: it is gone, or it is the link kingpin-done leaves for
      # the archive (issue #115). An archive of an earlier task with the same id
      # must not count as this task's.
      if ! kp_task_is_live "$task_dir"; then
        echo "OK: $task_id merged and cleaned up successfully."
        exit 0
      fi

      status_file="$task_dir/status"
      last_st=$(kp_status_last "$status_file")

      case "$last_st" in
        merged:*)
          # Ensure cleanup ran
          # kingpin-done archives the task dir: a cleaned-up task is one whose
          # dir is gone from tasks/ (or still carries the marker).
          if [ -d "$task_dir" ] && [ ! -f "$task_dir/done_cleaned" ]; then
            "$KP_BIN/kingpin-done" "$task_id" >/dev/null 2>&1 || true
          fi
          if [ ! -d "$task_dir" ] || [ -f "$task_dir/done_cleaned" ]; then
            echo "OK: $task_id merged and cleaned up successfully."
            exit 0
          fi
          ;;
        cleanup-refused:*)
          echo "kingpin run: $task_id cleanup was refused: ${last_st#cleanup-refused: }" >&2
          exit 1
          ;;
        ready:*)
          if [ "$mode" = "auto" ]; then
            # Waiting for auto-landing and merge. The marker check below ends the
            # loop if the worker's window goes away first.
            :
          else
            echo "OK: $task_id is READY for review."
            if [ -f "$task_dir/report.html" ]; then
              if [ -s "$task_dir/dossier.url" ]; then
                echo "  Review dossier: $(head -n 1 "$task_dir/dossier.url")"
              else
                echo "  Review dossier: lavish-axi $task_dir/report.html"
              fi
            fi
            echo "  To land:        kingpin land $task_id"
            exit 0
          fi
          ;;
        needs-input:*)
          echo "OK: $task_id needs input."
          echo "  Question: $task_dir/question.md"
          echo "  To answer: kingpin send $task_id \"<answer>\""
          exit 0
          ;;
        waiting:*)
          # The Stop hook's line for a worker blocked on a human: kind and file.
          echo "OK: $task_id is waiting: ${last_st#waiting: }"
          exit 0
          ;;
        failed:*)
          echo "FAILED: $task_id failed: $last_st" >&2
          exit 1
          ;;
        *) : ;;
      esac

      # A worker that wrote a status line and then died never reports again.
      # kingpin-ack records the dead window as `seen_exited` when the supervisor
      # above acks the `exited` event, so the marker is how that event reaches this
      # loop (the watch output that carried it is discarded). A terminal line is
      # left to its own arm above: cleanup-refused: must stay the reported reason.
      # A worker that wrote no line at all is the launch death #102 covers:
      # kingpin-launch-check records `failed: no status:` after its grace period,
      # and that arm reports it, so the empty status keeps waiting for that line.
      if [ -s "$task_dir/status" ] && ! kp_status_is_terminal "$last_st" \
         && [ -f "$task_dir/seen_exited" ]; then
        echo "FAILED: $task_id exited: the worker window is gone (last status: ${last_st:-none})" >&2
        exit 1
      fi
      sleep 1
    done
    ;;
  -h|--help)
    usage
    ;;
  *)
    echo "kingpin: unknown command '$cmd'. Run 'kingpin --help' for usage." >&2
    exit 2
    ;;
esac
