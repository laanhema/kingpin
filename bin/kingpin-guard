#!/usr/bin/env bash
# Install or verify the orchestrator-only tool guard, and serve its hooks.
#
# The orchestrator session must not edit code. The guard is a PreToolUse hook in the
# untracked, git-ignored .claude/settings.local.json of the Kingpin checkout. It must
# not be a plain deny rule: Claude Code loads that file for the checkout's linked
# worktrees too, so deny rules for Edit, Write, NotebookEdit and Agent would strip the
# same tools from every leased worker. The hook sees the session's working directory
# and denies only in the main checkout; a session whose checkout it cannot resolve is
# denied (fail closed). The file must never be committed either.
#
# A worker's hook (see worker/hooks.json) allows edits inside the worker's own worktree
# and task folder. The worktree is pinned by KINGPIN_WORKTREE (or WORKTREE= in the task's
# task.env), never by the session's working directory.
#
# Usage: kingpin-guard [install|check|warn] [--dir <kingpin-checkout>]
#        kingpin-guard hook <orchestrator|worker>   (PreToolUse hook; JSON on stdin)
#   install  write the hook and remove the legacy deny rules an older version wrote
#   warn     print a one-line stderr warning when the guard is not active; always exit 0,
#            and stay silent in a linked worktree or with KINGPIN_SKIP_GUARD=1
set -euo pipefail

KP_ROOT=$(cd "$(dirname "$0")/.." && pwd)
KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
# shellcheck source=../lib/exclude.sh
. "$KP_ROOT/lib/exclude.sh"
# shellcheck source=../lib/gitdir.sh
. "$KP_ROOT/lib/gitdir.sh"
# The deny rules older versions wrote; install removes them, check rejects them.
LEGACY_DENY='["Edit","Write","NotebookEdit","Agent"]'
MATCHER='Edit|Write|NotebookEdit|Agent'

die() { echo "kingpin-guard: $*" >&2; exit 1; }

if [ "${1:-}" = hook ]; then
  case "${2:-}" in
    orchestrator|worker) exec node "$KP_ROOT/lib/guard-hook.mjs" "$2" ;;
    *) die "usage: kingpin-guard hook <orchestrator|worker>" ;;
  esac
fi

cmd=install dir=$KP_ROOT
while [ $# -gt 0 ]; do
  case $1 in
    install|check|warn) cmd=$1; shift ;;
    --dir) dir=${2:?--dir needs a path}; shift 2 ;;
    -h|--help)
      echo "usage: kingpin-guard [install|check|warn] [--dir <kingpin-checkout>]"
      echo "       kingpin-guard hook <orchestrator|worker>"
      exit 0
      ;;
    *) die "unknown argument: $1" ;;
  esac
done

if [ "$cmd" = warn ]; then
  # Cheap and quiet: used at `kingpin list` and `kingpin-wait` startup.
  [ "${KINGPIN_SKIP_GUARD:-}" != 1 ] || exit 0
  [ -d "$dir" ] && git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || exit 0
fi

[ -d "$dir" ] || die "directory does not exist: $dir"
git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository: $dir"
dir=$(cd "$dir" && pwd -P)
file="$dir/.claude/settings.local.json"
# "|| exit 2": a hook that cannot run (script missing, node missing) must deny, not let the edit through.
hook_cmd="'$dir/bin/kingpin-guard' hook orchestrator || exit 2"

# A leased worktree is a linked worktree; the guard file there would be a second copy.
# `warn` promises to always exit 0, so a failed read there stays silent rather than
# turning a routine `kingpin list` into a failure (issue #86 review, L1).
if [ "$cmd" = warn ]; then
  git_dir=$(kp_git_dir "$dir") || exit 0
  common_dir=$(kp_git_common_dir "$dir") || exit 0
else
  git_dir=$(kp_git_dir "$dir") || die "cannot read the git directory of $dir"
  common_dir=$(kp_git_common_dir "$dir") || die "cannot read the common git directory of $dir"
fi
if [ "$git_dir" != "$common_dir" ]; then
  [ "$cmd" != warn ] || exit 0
  die "$dir is a linked worktree (a worker checkout); run this in the main Kingpin checkout"
fi

# The orchestrator contract is installed from the tracked orchestrator/contract.md
# into instruction sources that exist only in this checkout: a worker in a leased
# worktree must never load one (issue #96). A checkout without the tracked template
# (an arbitrary --dir) skips the contract and keeps the guard-only behaviour.
contract_src="$dir/orchestrator/contract.md"
home_contract="$KP_HOME/orchestrator.md"
claude_contract="$dir/.claude/rules/kingpin-orchestrator.md"
agy_contract="$dir/.agents/rules/kingpin.md"
opencode_cfg="$dir/.opencode/opencode.json"

ensure_excluded() {
  local file=$1 rel excl
  rel=${file#"$dir"/}
  excl=$(kp_git_path "$dir" info/exclude) || die "cannot locate $dir's info/exclude"
  # The guard's entries live in the block it owns in that file, rewritten on every
  # install: a loose copy an older install appended is adopted, never duplicated, so
  # `kingpin spawn` stops naming files the guard hides (issue #123).
  kp_exclude_guard_block "$excl" "$rel" \
    || die "cannot write the guard block in $excl"
}

# The merge below needs plain JSON, and OpenCode also accepts JSONC (comments) in its
# own config. Kingpin will not rewrite such a file, because that would discard the
# user's comments, so the install refuses it before it writes anything: a half-written
# install leaves contract copies that a later `git add -A` would commit.
check_opencode_config() {
  [ -f "$opencode_cfg" ] || return 0
  # shellcheck disable=SC2016 # single quotes are intentional: the program runs in node
  node -e '
    const file = process.argv[1];
    try { JSON.parse(require("fs").readFileSync(file, "utf8")); }
    catch (e) {
      console.error(`kingpin-guard: ${file} is not plain JSON (OpenCode also accepts JSONC comments, which Kingpin will not rewrite); remove the comments, then rerun`);
      process.exit(1);
    }
  ' "$opencode_cfg"
}

install_contract() {
  [ -f "$contract_src" ] || { echo "contract: skipped (no orchestrator/contract.md in $dir)"; return 0; }
  # Everything that can refuse this install runs before the first copy is written.
  check_opencode_config
  # Kingpin owns these filenames in its own checkout, but never clobbers a file it did
  # not write: a user's own rules file at that path stops the install with its name.
  if [ -f "$agy_contract" ] && ! grep -Fq -- 'kingpin orchestrator contract' "$agy_contract"; then
    die "$agy_contract exists and was not written by Kingpin; move it, then rerun"
  fi
  mkdir -p "$(dirname "$home_contract")" "$dir/.claude/rules" "$dir/.agents/rules" "$dir/.opencode"
  cp "$contract_src" "$home_contract"
  # Exclude each in-repo copy as it is written, so a later step that fails cannot leave
  # an untracked contract copy behind (issue #96 review, M3).
  cp "$contract_src" "$claude_contract"
  ensure_excluded "$claude_contract"
  # agy skips a rules file without a trigger frontmatter, so it gets one.
  {
    printf -- '---\ntrigger: always_on\ndescription: Kingpin orchestrator contract\n---\n\n'
    cat "$contract_src"
  } > "$agy_contract"
  ensure_excluded "$agy_contract"
  # shellcheck disable=SC2016 # single quotes are intentional: the program runs in node
  node -e '
    const fs = require("fs");
    const [file, entry] = [process.argv[1], process.argv[2]];
    let cfg = {};
    if (fs.existsSync(file)) {
      try { cfg = JSON.parse(fs.readFileSync(file, "utf8")); }
      catch (e) { console.error(`kingpin-guard: malformed JSON in ${file}: ${e.message}`); process.exit(1); }
    }
    if (cfg === null || typeof cfg !== "object" || Array.isArray(cfg)) {
      console.error(`kingpin-guard: ${file} must contain a JSON object`); process.exit(1);
    }
    if (cfg.instructions !== undefined && !Array.isArray(cfg.instructions)) {
      console.error(`kingpin-guard: "instructions" in ${file} must be a JSON array`); process.exit(1);
    }
    cfg.$schema = cfg.$schema || "https://opencode.ai/config.json";
    cfg.instructions = (cfg.instructions || []).filter((e) => e !== entry).concat(entry);
    const tmp = `${file}.tmp.${process.pid}`;
    fs.writeFileSync(tmp, JSON.stringify(cfg, null, 2) + "\n");
    fs.renameSync(tmp, file);
  ' "$opencode_cfg" "$home_contract"
  ensure_excluded "$opencode_cfg"
  echo "contract: installed ($home_contract, $claude_contract, $agy_contract, $opencode_cfg)"
}

check_contract() {
  local verdict=${1:-} rc=0
  # The verdict must be one of the tokens the node call prints (lib/guard-check.mjs):
  # a caller that forgets it would otherwise turn the omission into a contract
  # message about a config nothing read.
  case $verdict in
    ok|missing|badjson|none) ;;
    *) die "internal: check_contract needs a node verdict (ok|missing|badjson|none), got: '${verdict}'" ;;
  esac
  [ -f "$contract_src" ] || { echo "contract: skipped (no orchestrator/contract.md in $dir)"; return 0; }
  cmp -s "$contract_src" "$home_contract" \
    || { echo "contract: $home_contract is stale or missing; run 'kingpin guard install'" >&2; rc=1; }
  cmp -s "$contract_src" "$claude_contract" \
    || { echo "contract: $claude_contract is stale or missing; run 'kingpin guard install'" >&2; rc=1; }
  # The agy copy carries a five-line frontmatter block before the contract body.
  [ -f "$agy_contract" ] && tail -n +6 "$agy_contract" | cmp -s - "$contract_src" \
    || { echo "contract: $agy_contract is stale or missing; run 'kingpin guard install'" >&2; rc=1; }
  # A config that is not plain JSON must not spill a Node stack trace from `guard check` /
  # `list` (issue #96 review, L1): name the file and what to do. `install` refuses such a
  # file up front; see check_opencode_config. The verdict tokens are what the one node call
  # in the `check` case read; the messages stay here, in the order they were printed.
  if [ "$verdict" != badjson ]; then
    case $verdict in
      ok) ;;
      *) echo "contract: $opencode_cfg does not load it; run 'kingpin guard install'" >&2; rc=1 ;;
    esac
  else
    echo "contract: $opencode_cfg is not valid JSON; remove any comments if it is JSONC, then run \"kingpin guard install\"" >&2
    rc=1
  fi
  [ "$rc" = 0 ] && echo "contract: active ($home_contract)"
  return "$rc"
}

case "$cmd" in
  check)
    [ -f "$file" ] || { echo "guard: missing ($file); run 'kingpin guard install'" >&2; exit 1; }
    # One node start reads both files the check needs (the guard settings and the OpenCode
    # config) and prints `<guard> <contract>` verdict tokens (lib/guard-check.mjs); the
    # messages below are the ones the two node calls this replaced printed. A node start
    # that prints no verdict line (node missing, or failing before its output) makes the
    # read fail, which is told through the same incomplete message below.
    read -r guard_rc contract_verdict < <(
      node "$KP_ROOT/lib/guard-check.mjs" "$file" "$LEGACY_DENY" "$hook_cmd" "$MATCHER" \
        "$contract_src" "$opencode_cfg" "$home_contract"
    ) || { echo "guard: incomplete ($file); run 'kingpin guard install'" >&2; exit 1; }
    case $guard_rc in
      0) ;;
      2) echo "guard: stale deny rules in $file reach worker worktrees; run 'kingpin guard install'" >&2; exit 1 ;;
      *) echo "guard: incomplete ($file); run 'kingpin guard install'" >&2; exit 1 ;;
    esac
    echo "guard: active ($file)"
    check_contract "$contract_verdict" || exit 1
    ;;
  warn)
    # `check` prints "contract: ..." when a contract copy is the problem and "guard: ..."
    # when the hook itself is, so the warning names the right cause instead of sending
    # the operator to the wrong one (issue #96 review, L4).
    out=$("$0" check --dir "$dir" 2>&1 >/dev/null || true)
    case $out in
      "") ;;
      *contract:*) echo "warning: the orchestrator contract is stale or missing; run 'kingpin guard install'" >&2 ;;
      *) echo "warning: orchestrator guard is not active; run 'kingpin guard install'" >&2 ;;
    esac
    ;;
  install)
    mkdir -p "$dir/.claude"
    # shellcheck disable=SC2016 # single quotes are intentional: the program runs in node
    node -e '
      const fs = require("fs");
      const [file, legacy, hookCmd, matcher] = [process.argv[1], JSON.parse(process.argv[2]), process.argv[3], process.argv[4]];
      let cfg = {};
      if (fs.existsSync(file)) {
        try { cfg = JSON.parse(fs.readFileSync(file, "utf8")); }
        catch (e) { console.error(`kingpin-guard: malformed JSON in ${file}: ${e.message}`); process.exit(1); }
      }
      const plain = (v) => v !== null && typeof v === "object" && !Array.isArray(v);
      const bad = (what) => { console.error(`kingpin-guard: ${what} in ${file} must be a JSON object`); process.exit(1); };
      if (!plain(cfg)) { console.error(`kingpin-guard: ${file} must contain a JSON object`); process.exit(1); }
      if (cfg.permissions !== undefined && !plain(cfg.permissions)) bad("\"permissions\"");
      if (cfg.hooks !== undefined && !plain(cfg.hooks)) bad("\"hooks\"");
      if (cfg.hooks && cfg.hooks.PreToolUse !== undefined && !Array.isArray(cfg.hooks.PreToolUse)) {
        console.error(`kingpin-guard: "hooks.PreToolUse" in ${file} must be a JSON array`); process.exit(1);
      }
      // Drop the legacy deny rules (they strip the tools from worker worktrees).
      if (cfg.permissions && Array.isArray(cfg.permissions.deny)) {
        cfg.permissions.deny = cfg.permissions.deny.filter((t) => !legacy.includes(t));
        if (cfg.permissions.deny.length === 0) delete cfg.permissions.deny;
        if (Object.keys(cfg.permissions).length === 0) delete cfg.permissions;
      }
      // Replace any earlier copy of the guard hook (it may point at another path).
      const ours = (h) => h && typeof h.command === "string" && /kingpin-guard.? hook orchestrator/.test(h.command);
      cfg.hooks = cfg.hooks || {};
      cfg.hooks.PreToolUse = (cfg.hooks.PreToolUse || [])
        .map((e) => (e && Array.isArray(e.hooks) ? { ...e, hooks: e.hooks.filter((h) => !ours(h)) } : e))
        .filter((e) => !(e && Array.isArray(e.hooks) && e.hooks.length === 0));
      cfg.hooks.PreToolUse.push({ matcher, hooks: [{ type: "command", command: hookCmd }] });
      const tmp = `${file}.tmp.${process.pid}`;
      fs.writeFileSync(tmp, JSON.stringify(cfg, null, 2) + "\n");
      fs.renameSync(tmp, file);
    ' "$file" "$LEGACY_DENY" "$hook_cmd" "$MATCHER"
    # The guard file must stay out of git, or worker worktrees would inherit it.
    if ! git -C "$dir" check-ignore -q "$file"; then
      excl=$(kp_git_path "$dir" info/exclude) || die "cannot locate $dir's info/exclude"
      mkdir -p "$(dirname "$excl")"
      echo ".claude/settings.local.json" >> "$excl"
    fi
    echo "OK: orchestrator guard installed in $file"
    install_contract
    ;;
esac
