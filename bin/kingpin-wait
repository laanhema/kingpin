#!/usr/bin/env bash
# Wait for task updates across the kingpin fleet.
#
# Inspects $KINGPIN_HOME/tasks/ for:
#   1. New status lines (status line count > seen count). A purely informational
#      `issue:` line does not wake the waiter; any other new line does. A status file
#      rewritten under the cursor (the handled line is gone from its index) is a
#      status event too, even when the line count did not change (issue #190).
#   2. Unexpected window termination (tmux window gone without terminal status).
#      A task whose `launching` marker is fresh (kingpin-spawn has not created the
#      window yet) is not reported.
#   3. Qualified quiet worker (stopped newer than status, pane not waiting on subagents/turns).
#      A worker whose last status is an acknowledged `needs-input:` is not reported
#      again until its status or its pane activity changes (`seen_activity`, written by ack).
#
# Outputs: one line per task update: "<task-id> <reason>" (status|quiet|exited)
# Exit codes:
#   0  events found (lines printed), or the timeout passed with no events
#      (nothing printed: a quiet fleet is not an error)
#   1  --once and no events (scripts such as kingpin-watch rely on this), or an
#      unusable fleet directory (message on stderr)
#   2  bad arguments (message on stderr)
#
# Usage: kingpin-wait [--timeout <seconds>] [--once]
set -euo pipefail

KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
# shellcheck source=../lib/status.sh
. "$(dirname "$0")/../lib/status.sh"
# shellcheck source=../lib/tmux.sh
. "$(dirname "$0")/../lib/tmux.sh"
# shellcheck source=../lib/portable.sh
. "$(dirname "$0")/../lib/portable.sh"
# shellcheck source=../lib/tmux.sh
. "$(dirname "$0")/../lib/tmux.sh"
TIMEOUT=300
ONCE=0

while [ $# -gt 0 ]; do
  case $1 in
    --timeout)
      TIMEOUT=${2:-}
      case $TIMEOUT in
        ''|*[!0-9]*) echo "kingpin-wait: --timeout needs a whole number of seconds" >&2; exit 2 ;;
      esac
      shift 2 ;;
    --once) ONCE=1; shift ;;
    -h|--help)
      cat <<'USAGE'
usage: kingpin-wait [--timeout <seconds>] [--once]

Prints "<task-id> <reason>" per event.
Exit 0: events printed, or the timeout passed with no events (prints nothing).
Exit 1: --once and no events, or the fleet directory is unusable.
Exit 2: bad arguments.
USAGE
      exit 0
      ;;
    *) echo "kingpin-wait: unknown argument $1" >&2; exit 2 ;;
  esac
done

tasks_dir="$KP_HOME/tasks"
if ! mkdir -p "$tasks_dir" 2>/dev/null || [ ! -d "$tasks_dir" ] || [ ! -r "$tasks_dir" ]; then
  echo "kingpin-wait: cannot use fleet directory $tasks_dir" >&2
  exit 1
fi

# Repeat the guard warning once at startup (stderr, non-fatal, silent when active).
"$(dirname "$0")/kingpin-guard" warn || true

# A tmux server that died takes every window with it while the task records still name
# its socket, so a dead fleet reads as `exited` events with no reason (issue #165).
# Warn once per socket per process, on stderr, with the attach command; the check rides
# every pass as well, so a server that dies during a long wait is still named once.
# KINGPIN_SKIP_SOCKET_WARN=1 silences it, like KINGPIN_SKIP_GUARD=1 for the guard.
WARNED_SOCKETS=' '
warn_unreachable_sockets() {
  local dir sock checked=' ' ids id isock
  for dir in "$tasks_dir"/*; do
    kp_task_is_live "$dir" || continue
    sock=$(kp_tmux_socket_from_env "$dir/task.env")
    case "$checked" in *" ${sock:-default} "*) continue ;; esac
    checked="$checked${sock:-default} "
    kp_tmux_socket_reachable "$sock" && continue
    case "$WARNED_SOCKETS" in *" ${sock:-default} "*) continue ;; esac
    WARNED_SOCKETS="$WARNED_SOCKETS${sock:-default} "
    ids=''
    for id in "$tasks_dir"/*; do
      kp_task_is_live "$id" || continue
      # Normalized on both sides: no socket and `default` name the same server, and the
      # dedupe above already treats them as one (issue #165 review M2).
      isock=$(kp_tmux_socket_from_env "$id/task.env")
      [ "${isock:-default}" = "${sock:-default}" ] || continue
      ids=${ids:+"$ids "}$(basename "$id")
    done
    # shellcheck disable=SC2086 # ids is a space-separated list of task ids
    kp_tmux_socket_warn_line "$sock" $ids
  done
}
warn_unreachable_sockets

# kingpin-spawn writes task.env before it creates the window and drops `launching`
# once the window ID is recorded. A fresh marker means the window is still being
# created; a stale one (a spawn that died) no longer hides a missing window.
# The age is computed only from a readable mtime; an unreadable one keeps the grace.
LAUNCH_GRACE=120
is_launching() {
  local marker="$1/launching"
  [ -f "$marker" ] || return 1
  local age mtime
  if ! mtime=$(kp_mtime "$marker"); then
    # A stat that reads nothing must not become age 0: that is a stale-looking
    # marker and reports a task still being spawned as exited. Say so, and keep
    # the launch grace (a false `exited` dispatches the task twice).
    echo "kingpin-wait: cannot read the modification time of $marker; treating the task as still launching" >&2
    return 0
  fi
  age=$(( $(date +%s) - mtime ))
  [ "$age" -lt "$LAUNCH_GRACE" ]
}

# True when the worker already reported a wait (needs-input:, a feedback: note, or
# the Stop hook's waiting: line) and its pane shows no activity since that ack: a
# stop in that state is the same idle wait.
quiet_held() {
  local dir=$1 target=$2 last=$3 count=$4 seen=$5 socket=$6
  kp_status_is_waiting "$last" || return 1
  [ "$count" -eq "$seen" ] || return 1
  [ -f "$dir/seen_activity" ] || return 1
  local now_act
  now_act=$(kp_tmux "$socket" display-message -p -t "$target" '#{window_activity}' 2>/dev/null || true)
  [ "$now_act" = "$(tr -d ' \n' < "$dir/seen_activity")" ]
}

check_task() {
  local dir=$1
  local id
  id=$(basename "$dir")
  local task_env="$dir/task.env"
  [ -f "$task_env" ] || return 0

  # A worker that stopped without a single status line failed at launch. The
  # helper appends `failed: no status: ...` once its grace period is over, so the
  # new line is counted as a status event below. Its stdout is not an event, but
  # its stderr is: the helper names a task.env it cannot judge there, and the
  # supervisor forwards that first line to the fleet log, so keep it.
  [ -s "$dir/status" ] || "$(dirname "$0")/kingpin-launch-check" "$dir" >/dev/null || true

  local status_file="$dir/status"
  local seen_file="$dir/seen"
  local stopped_file="$dir/stopped"
  local seen_stopped_file="$dir/seen_stopped"
  local seen_exited_file="$dir/seen_exited"

  local status_count=0
  local seen_count=0
  local last_status=""

  if [ -f "$status_file" ]; then
    status_count=$(wc -l < "$status_file" | tr -d ' ')
    last_status=$(kp_status_last "$status_file")
  fi
  if [ -f "$seen_file" ]; then
    seen_count=$(cat "$seen_file" 2>/dev/null | tr -d ' ' || echo 0)
  fi

  # 1. New status lines
  if [ "$status_count" -gt "$seen_count" ]; then
    # A --text task learns its issue number here: rename its window (best effort).
    "$(dirname "$0")/kingpin-rename" "$id" >/dev/null 2>&1 || true
    # `issue:` (and blank) lines are informational: wake only for another line.
    if [ -n "$(tail -n +$((seen_count + 1)) "$status_file" | grep -vE '^(issue:|[[:space:]]*$)' || true)" ]; then
      echo "$id status"
      return 0
    fi
  fi

  # 1b. A status file rewritten under the cursor (issue #190). A count alone cannot
  # see this: a worker that removed a handled line and appended one leaves the file
  # the same length as before, so no count check fires and the appended line never
  # gets a dispatch. The anchor kingpin-ack records beside the count tells the two
  # apart, and reporting the rewrite as a status event wakes the supervisor, which
  # repairs the cursor and dispatches what is left. The repair makes the file read
  # as intact again, so this fires once per rewrite.
  if [ "$(kp_status_cursor_resume "$dir")" != "$seen_count" ]; then
    echo "$id status"
    return 0
  fi

  # Terminal tasks need no further checks
  if kp_status_is_terminal "$last_status"; then
    return 0
  fi

  # 2. Window liveness check. The resolver (lib/tmux.sh) finds the task's own window by
  # name first, on the socket the record names (issue #142), so a stale recorded id that
  # now names a foreign window cannot make a dead task look alive. `exited` keeps its old
  # meaning: the *window* is gone. A window that exists while its harness is gone is the
  # DEAD state `kingpin list` reports, not an event here (changing that would fire
  # `exited` for every fixture pane running a shell).
  local tmux_socket=""
  local tmux_target=""
  local window_alive=0
  if kp_window_find "$dir" >/dev/null 2>&1; then
    window_alive=1
    tmux_socket=$KP_WINDOW_SOCKET
    tmux_target=$KP_WINDOW_ID
  fi

  if [ "$window_alive" -eq 0 ]; then
    if is_launching "$dir"; then
      return 0
    fi
    if [ ! -f "$seen_exited_file" ]; then
      echo "$id exited"
      return 0
    fi
    return 0
  fi

  # 3. Qualified quiet check
  if [ -f "$stopped_file" ]; then
    local stop_time
    stop_time=$(cat "$stopped_file" 2>/dev/null | tr -d ' ' || echo 0)
    local seen_stop=0
    [ -f "$seen_stopped_file" ] && seen_stop=$(cat "$seen_stopped_file" 2>/dev/null | tr -d ' ' || echo 0)

    if [ "$stop_time" -gt "$seen_stop" ] && ! quiet_held "$dir" "$tmux_target" "$last_status" "$status_count" "$seen_count" "$tmux_socket"; then
      local harness="claude"
      harness=$(kp_env_get "$task_env" HARNESS)
      [ -n "$harness" ] || harness="claude"

      local pane_tail
      pane_tail=$(kp_tmux "$tmux_socket" capture-pane -pt "$tmux_target" -S -30 2>/dev/null || true)

      # A pane that still shows a working marker is not quiet. The list lives in
      # lib/status.sh, shared with the Stop hook and kingpin-launch-check.
      if ! kp_pane_shows_working "$pane_tail" "$harness"; then
        echo "$id quiet"
        return 0
      fi
    fi
  fi

  return 0
}

check_all() {
  local updates=0
  warn_unreachable_sockets
  for dir in "$tasks_dir"/*; do
    # A finished task keeps a symlink at tasks/<id> so its dossier path resolves
    # (issue #115). It is not live: reporting an event for it would wake the
    # orchestrator about work that is already merged and cleaned up.
    kp_task_is_live "$dir" || continue
    local res
    res=$(check_task "$dir")
    if [ -n "$res" ]; then
      echo "$res"
      updates=1
    fi
  done
  [ "$updates" -eq 1 ] && return 0 || return 1
}

start_time=$(date +%s)
while true; do
  if check_all; then
    exit 0
  fi

  if [ "$ONCE" -eq 1 ]; then
    exit 1
  fi

  now=$(date +%s)
  elapsed=$((now - start_time))
  if [ "$elapsed" -ge "$TIMEOUT" ]; then
    exit 0
  fi

  remaining=$((TIMEOUT - elapsed))
  step=2
  [ "$remaining" -lt "$step" ] && step="$remaining"
  [ "$step" -le 0 ] && exit 0

  if command -v inotifywait >/dev/null 2>&1; then
    inotifywait -q -r -e modify,create,delete,attrib -t "$step" "$tasks_dir" >/dev/null 2>&1 || true
  else
    sleep "$step"
  fi
done
