#!/usr/bin/env bash
# Show the tail of a kingpin task's tmux pane, read-only.
#
# Usage: kingpin-peek <task-id> [--lines N]
#
# Prints the last N (default 20) non-empty lines of the worker's pane, scrollback
# included, with wrapped lines joined. The window is resolved like kingpin-send does
# (lib/tmux.sh): the task's own window name first, which is the one key that survives a
# tmux server restart, then the recorded window ID for a hand-renamed window. Only
# `tmux list-panes` and `tmux capture-pane` run: no keys are sent and nothing is written.
set -euo pipefail

KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
# shellcheck source=../lib/status.sh
. "$(dirname "$0")/../lib/status.sh"
# shellcheck source=../lib/tmux.sh
. "$(dirname "$0")/../lib/tmux.sh"

usage() { echo "usage: kingpin-peek <task-id> [--lines N]" >&2; }

id=""
lines=20
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      echo "  Prints the last N (default 20) non-empty lines of the worker's tmux pane. Read-only." >&2
      exit 0
      ;;
    --lines)
      [ $# -ge 2 ] || { echo "kingpin-peek: --lines needs a positive integer" >&2; exit 2; }
      lines=$2
      shift 2
      ;;
    --lines=*)
      lines=${1#--lines=}
      shift
      ;;
    -*)
      echo "kingpin-peek: unknown option '$1'" >&2
      usage
      exit 2
      ;;
    *)
      if [ -n "$id" ]; then
        echo "kingpin-peek: unexpected argument '$1'" >&2
        usage
        exit 2
      fi
      id=$1
      shift
      ;;
  esac
done

[ -n "$id" ] || { usage; exit 2; }
[[ $lines =~ ^[1-9][0-9]*$ ]] || { echo "kingpin-peek: --lines needs a positive integer" >&2; exit 2; }

task_dir="$KP_HOME/tasks/$id"
[ -d "$task_dir" ] || { echo "kingpin-peek: task $id not found: $task_dir" >&2; exit 1; }

# The window is resolved by lib/tmux.sh: its own name first, then the recorded id,
# on the socket the task record names (issue #142). Only `list-panes` and
# `capture-pane` run: no keys are sent and nothing is written.
if ! kp_window_find "$task_dir"; then
  echo "kingpin-peek: tmux window $KP_WINDOW_LABEL is not alive" >&2
  exit 1
fi

pane=$(kp_tmux "$KP_WINDOW_SOCKET" capture-pane -p -J -t "$KP_WINDOW_ID" -S -2000 2>/dev/null) || {
  echo "kingpin-peek: could not read tmux window $KP_WINDOW_LABEL" >&2
  exit 1
}

printf '%s\n' "$pane" | awk 'NF' | tail -n "$lines"
