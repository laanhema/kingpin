#!/usr/bin/env bash
# Show the tail of a kingpin task's tmux pane, read-only.
#
# Usage: kingpin-peek <task-id> [--lines N]
#
# Prints the last N (default 20) non-empty lines of the worker's pane, scrollback
# included, with wrapped lines joined. The pane is found like kingpin-send does:
# the window ID recorded at spawn first (it survives a rename or move), then
# TMUX_TARGET. Only `tmux list-panes` and `tmux capture-pane` run: no keys are
# sent and nothing is written.
set -euo pipefail

KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
# shellcheck source=../lib/status.sh
. "$(dirname "$0")/../lib/status.sh"

usage() { echo "usage: kingpin-peek <task-id> [--lines N]" >&2; }

id=""
lines=20
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      echo "  Prints the last N (default 20) non-empty lines of the worker's tmux pane. Read-only." >&2
      exit 0
      ;;
    --lines)
      [ $# -ge 2 ] || { echo "kingpin-peek: --lines needs a positive integer" >&2; exit 2; }
      lines=$2
      shift 2
      ;;
    --lines=*)
      lines=${1#--lines=}
      shift
      ;;
    -*)
      echo "kingpin-peek: unknown option '$1'" >&2
      usage
      exit 2
      ;;
    *)
      if [ -n "$id" ]; then
        echo "kingpin-peek: unexpected argument '$1'" >&2
        usage
        exit 2
      fi
      id=$1
      shift
      ;;
  esac
done

[ -n "$id" ] || { usage; exit 2; }
[[ $lines =~ ^[1-9][0-9]*$ ]] || { echo "kingpin-peek: --lines needs a positive integer" >&2; exit 2; }

task_dir="$KP_HOME/tasks/$id"
[ -d "$task_dir" ] || { echo "kingpin-peek: task $id not found: $task_dir" >&2; exit 1; }

env_file="$task_dir/task.env"
tmux_target="kingpin:$id"
if [ -f "$env_file" ]; then
  tmux_target=$(kp_env_get "$env_file" TMUX_TARGET)
  [ -n "$tmux_target" ] || tmux_target="kingpin:$id"
fi

# Prefer the window ID (survives rename and move); task.env files from before
# it was recorded only have the name target.
shown_target=$tmux_target
if [ -f "$env_file" ]; then
  window_id=$(kp_env_get "$env_file" TMUX_WINDOW_ID)
  if [ -n "$window_id" ]; then
    tmux_target=$window_id
    shown_target="$shown_target ($window_id)"
  fi
fi

if ! tmux list-panes -t "$tmux_target" >/dev/null 2>&1; then
  echo "kingpin-peek: tmux window $shown_target is not alive" >&2
  exit 1
fi

pane=$(tmux capture-pane -p -J -t "$tmux_target" -S -2000 2>/dev/null) || {
  echo "kingpin-peek: could not read tmux window $shown_target" >&2
  exit 1
}

printf '%s\n' "$pane" | awk 'NF' | tail -n "$lines"
