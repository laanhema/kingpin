#!/usr/bin/env bash
# Show the tail of a kingpin task's terminal pane, read-only.
#
# Usage: kingpin-peek <task-id> [--lines N]
#
# Prints the last N (default 20) non-empty lines of the worker's pane, scrollback
# included, with wrapped lines joined. The terminal is resolved through
# lib/mux.sh from the mux the record names: a tmux window by its own name first,
# which is the one key that survives a tmux server restart, then the recorded
# window id for a hand-renamed window; a Herdr pane by its label first, then the
# recorded pane id. It sends no keys and writes nothing in either mode: in tmux
# only `list-panes` and `capture-pane` run, and a Herdr pane found under a stale
# recorded id is left unrecorded.
set -euo pipefail

KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
# shellcheck source=../lib/status.sh
. "$(dirname "$0")/../lib/status.sh"
# shellcheck source=../lib/mux.sh
. "$(dirname "$0")/../lib/mux.sh"

usage() { echo "usage: kingpin-peek <task-id> [--lines N]" >&2; }

id=""
lines=20
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      echo "  Prints the last N (default 20) non-empty lines of the worker's tmux pane. Read-only." >&2
      exit 0
      ;;
    --lines)
      [ $# -ge 2 ] || { echo "kingpin-peek: --lines needs a positive integer" >&2; exit 2; }
      lines=$2
      shift 2
      ;;
    --lines=*)
      lines=${1#--lines=}
      shift
      ;;
    -*)
      echo "kingpin-peek: unknown option '$1'" >&2
      usage
      exit 2
      ;;
    *)
      if [ -n "$id" ]; then
        echo "kingpin-peek: unexpected argument '$1'" >&2
        usage
        exit 2
      fi
      id=$1
      shift
      ;;
  esac
done

[ -n "$id" ] || { usage; exit 2; }
[[ $lines =~ ^[1-9][0-9]*$ ]] || { echo "kingpin-peek: --lines needs a positive integer" >&2; exit 2; }

task_dir="$KP_HOME/tasks/$id"
[ -d "$task_dir" ] || { echo "kingpin-peek: task $id not found: $task_dir" >&2; exit 1; }

# The task's terminal is resolved through lib/mux.sh: a tmux window by its own
# name first, then the recorded id, on the socket the record names (issue #142); a
# Herdr pane by its label first, then the recorded pane id. In tmux mode only
# `list-panes` and `capture-pane` run: no keys are sent and nothing is written.
# `--no-record` keeps that promise for a Herdr task too: a pane found under a
# stale recorded id is not written back, because a reader must not race a writer.
if ! kp_mux_find "$task_dir" --no-record; then
  echo "kingpin-peek: $KP_MUX window $KP_WINDOW_LABEL is not alive" >&2
  exit 1
fi

pane=$(kp_mux_capture "$KP_WINDOW_ID" --scrollback 2000 2>/dev/null) || {
  echo "kingpin-peek: could not read $KP_MUX window $KP_WINDOW_LABEL" >&2
  exit 1
}

printf '%s\n' "$pane" | awk 'NF' | tail -n "$lines"
