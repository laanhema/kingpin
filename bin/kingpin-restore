#!/usr/bin/env bash
# Bring a live task's window back after the tmux server dies.
#
# A tmux server that dies takes every worker window with it. The task records still
# say what the worker last reported, but nothing is running, and tmux window ids
# restart at @0, so a reader that trusts a recorded id can reach a stranger's pane.
# This command recreates or reclaims one window per live task, in the task's own
# worktree and on its own branch, launches the recorded harness through the same
# lib/launch.sh a spawn uses, and hands it a resume brief that says where the work
# stands. A dead window is not a dead worker: the harness may still hold the task's
# conversation in its own server, so the command resumes the session the task already
# had rather than starting a second one beside it. It refuses when resuming would leave
# a second live session, and says in its `OK:` line when it starts a fresh one because
# the harness cannot report an existing session (issue #168). It never deletes anything:
# a task it cannot bring back is refused by name with the reason and the remedy, and its
# record, worktree and branch stay in place.
#
# Usage: kingpin-restore [<task-id> ...] [--harness <name>] [--dry-run] [--force]
#   (no ids)    restore every live task under $KINGPIN_HOME/tasks
#   --harness   launch this harness instead of the recorded one, and record it
#   --dry-run   print the plan and touch nothing
#   --force     restore a task whose harness still looks alive, or whose lease
#               cannot be verified, and resume one session when several look
#               live (the task's recorded session when it is among them, otherwise
#               the newest); it never overrides a missing worktree, an archived
#               task or a terminal status line
#
# KINGPIN_HOME defaults to ~/.kingpin. Harness command overrides: KINGPIN_CLAUDE,
# KINGPIN_AGY, KINGPIN_OPENCODE, KINGPIN_PI.
set -euo pipefail

KP_ROOT=$(cd "$(dirname "$0")/.." && pwd)
KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
# shellcheck source=../lib/status.sh
. "$KP_ROOT/lib/status.sh"
# shellcheck source=../lib/tmux.sh
. "$KP_ROOT/lib/tmux.sh"
# shellcheck source=../lib/launch.sh
. "$KP_ROOT/lib/launch.sh"
# shellcheck source=../lib/exclude.sh
. "$KP_ROOT/lib/exclude.sh"
# shellcheck source=../lib/gitdir.sh
. "$KP_ROOT/lib/gitdir.sh"
# shellcheck source=../lib/landing.sh
. "$KP_ROOT/lib/landing.sh"
# shellcheck source=../lib/mutex.sh
. "$KP_ROOT/lib/mutex.sh"

die() { echo "kingpin-restore: $*" >&2; exit 1; }

usage() {
  cat <<'HELP'
usage: kingpin-restore [<task-id> ...] [--harness <name>] [--dry-run] [--force]

  (no ids)   restore every live task under $KINGPIN_HOME/tasks
  --harness  harness to launch instead of the recorded one (recorded afterwards)
  --dry-run  print what would happen, and touch nothing
  --force    restore a task whose harness still looks alive, or whose lease cannot
             be verified, and resume one session when several look live (the task's
             recorded session when it is among them, otherwise the newest); a
             missing worktree, an archived task and a terminal status stay refused
HELP
}

harness_cli='' dry_run=0 force=0
ids=()
while [ $# -gt 0 ]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --harness)
      [ $# -ge 2 ] || { echo "kingpin-restore: --harness needs a name" >&2; exit 2; }
      harness_cli=$2
      shift 2
      ;;
    --dry-run) dry_run=1; shift ;;
    --force) force=1; shift ;;
    -*) echo "kingpin-restore: unknown argument: $1" >&2; usage >&2; exit 2 ;;
    *)
      [[ $1 =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "kingpin-restore: invalid task id: $1" >&2; exit 2; }
      ids+=("$1")
      shift
      ;;
  esac
done
case ${harness_cli:-none} in
  none|claude|agy|opencode|pi) ;;
  *) echo "kingpin-restore: --harness must be claude, agy, opencode, or pi: $harness_cli" >&2; exit 2 ;;
esac

# One restore at a time: two operators, or one operator and a retry, must never both
# start a harness for the same task. A dry run takes no lock because it writes nothing.
mutex="$KP_HOME/locks/restore.mutex"
# shellcheck disable=SC2329 # invoked by the EXIT trap below
release_restore_mutex() { kp_mutex_release "$mutex"; }
if [ "$dry_run" -eq 0 ]; then
  if ! kp_mutex_acquire "$mutex"; then
    die "another restore is running (pid ${kp_mutex_owner:-unknown})"
  fi
  trap release_restore_mutex EXIT
fi

if [ ${#ids[@]} -eq 0 ]; then
  for d in "$KP_HOME"/tasks/*; do
    kp_task_is_live "$d" || continue
    [ -f "$d/task.env" ] || continue
    ids+=("$(basename "$d")")
  done
  if [ ${#ids[@]} -gt 0 ]; then
    # Stable output: the same fleet restores in the same order on every run.
    sorted=()
    while IFS= read -r line; do
      sorted+=("$line")
    done < <(printf '%s\n' "${ids[@]}" | LC_ALL=C sort)
    ids=("${sorted[@]}")
  fi
fi

restored=0 live=0 refused=0 would=0
refuse() {
  printf 'kingpin-restore: refused %s: %s\n' "$1" "$2" >&2
  refused=$((refused + 1))
}

# set_env_key <env-file> <KEY> <value>: rewrite one KEY=value line, adding it when the
# record has none (bin/kingpin-rename:55-58 shape: a temp file in the same folder).
set_env_key() {
  local env_file=$1 key=$2 value=$3 cur tmp
  cur=$(kp_env_get "$env_file" "$key")
  [ "$cur" = "$value" ] && return 0
  tmp="$env_file.set.$$"
  if grep -q "^$key=" "$env_file"; then
    sed "s|^$key=.*|$key=$value|" "$env_file" > "$tmp" \
      || { rm -f "$tmp"; return 1; }
  else
    { cat "$env_file" && printf '%s=%s\n' "$key" "$value"; } > "$tmp" \
      || { rm -f "$tmp"; return 1; }
  fi
  mv -f "$tmp" "$env_file" || { rm -f "$tmp"; return 1; }
  return 0
}

# next_step <task-dir> <task-id> <project> <last-status-line>
# The one instruction the resumed worker needs, keyed by its last *worker* event (notes
# included never decide it). The landing-lane row wins: a task whose landing was already
# sent must not send another one.
next_step() {
  local task_dir=$1 id=$2 project=$3 last=$4 holder=''
  if [ -f "$task_dir/landing_sent" ]; then
    holder=$(kp_landing_holder "$KP_HOME" "$project")
  fi
  if [ -n "$holder" ] && [ "$holder" = "$id" ]; then
    printf '%s\n' "the landing was already sent when the tmux server died: check whether the merge happened, report merged: pr=<url> if it did, otherwise say what is left, and never re-run kingpin land"
    return 0
  fi
  case $last in
    ''|issue:*)
      printf '%s\n' "read $task_dir/prompt.txt and continue the job; report as the preamble says"
      ;;
    ready:*)
      printf 'the review stands: the dossier is %s/report.html, do not land, wait for the operator%s next message\n' \
        "$task_dir" "'s"
      ;;
    fixed:*)
      printf '%s\n' "the fix pass is done; the landing continues, so check the PR state and report merged: pr=<url> once it merged"
      ;;
    needs-input:*)
      printf 'an open question is in %s/question.md; wait for the answer, do not ask again\n' "$task_dir"
      ;;
    waiting:*)
      local path=${last##* }
      case $path in
        /*) [ -f "$path" ] || path="$task_dir/question.md" ;;
        *) path="$task_dir/question.md" ;;
      esac
      printf 'an open question is in %s; wait for the answer, do not ask again\n' "$path"
      ;;
    *)
      printf 'read %s/prompt.txt and continue the job from its last status line; report as the preamble says\n' "$task_dir"
      ;;
  esac
}

# write_resume_prompt <task-dir> <id> <project> <worktree> <branch> <mode> <harness> <last> <next> <resumed-session>
# The brief repeats the task's identity, where the work stands, what to do next, and the
# house rules that still hold. A resumed session still has the earlier conversation, so
# the opening says so and the facts name the session; a fresh launch keeps the "no
# memory" wording, because there really is none.
write_resume_prompt() {
  local task_dir=$1 id=$2 project=$3 worktree=$4 branch=$5 mode=$6 harness=$7 last=$8 next=$9 resumed=${10:-}
  local status_file="$task_dir/status"
  {
    printf '# Kingpin resume brief\n\n'
    if [ -n "$resumed" ]; then
      printf 'The tmux server died and your window went with it. Kingpin restored the window\n'
      printf 'in the same worktree, on the same branch, with the same job, and resumed the\n'
      printf 'session this task already had: that conversation is in front of you. This brief\n'
      printf 'repeats the facts below from the task record.\n\n'
    else
      printf 'The tmux server died and your window went with it. Kingpin restored the window\n'
      printf 'in the same worktree, on the same branch, with the same job. You have no memory\n'
      printf 'of the earlier session: this brief and the worker preamble are the context you get.\n\n'
    fi
    printf -- '- Task id: %s\n' "$id"
    printf -- '- Project: %s\n' "$project"
    printf -- '- Worktree: %s\n' "$worktree"
    printf -- '- Branch: %s\n' "$branch"
    printf -- '- Mode: %s\n' "$mode"
    printf -- '- Harness: %s\n' "$harness"
    [ -z "$resumed" ] || printf -- '- Session: %s (resumed)\n' "$resumed"
    printf -- '- Status file: %s\n' "$status_file"
    printf -- '- Last status line: %s\n' "${last:-none}"
    printf -- '- Next step: %s\n\n' "$next"
    printf 'The original job prompt is still in %s/prompt.txt. Read it first, then check what\n' "$task_dir"
    printf 'is already on disk before you act: the work may be part-finished.\n\n'
    printf 'House rules that still hold:\n'
    printf -- '- Report every event as one literal status line appended to %s, the same protocol\n' "$status_file"
    printf '  the preamble describes. ready:, fixed: and merged: keep their fields, with no flavor.\n'
    printf -- '- Questions go up through needs-input: after the whole question is written to\n'
    printf '  %s/question.md. Ask through that file only.\n' "$task_dir"
    printf -- '- Never run kingpin spawn, lock, land, done, listen or send.\n'
    printf -- '- The record stays clean: commits, PRs, issues, code and review reports carry no rank talk.\n'
  } > "$task_dir/resume-prompt.txt" \
    || { echo "cannot write $task_dir/resume-prompt.txt" >&2; return 1; }
  return 0
}

for id in ${ids[@]+"${ids[@]}"}; do
  task_dir="$KP_HOME/tasks/$id"
  # The dossier link `kingpin done` leaves is not a live task: name the archive.
  if archived=$(kp_task_archive_dir "$KP_HOME" "$id"); then
    refuse "$id" "finished and archived at $archived"
    continue
  fi
  [ -d "$task_dir" ] || { refuse "$id" "not found"; continue; }
  env_file="$task_dir/task.env"
  [ -f "$env_file" ] || { refuse "$id" "task.env missing in $task_dir"; continue; }

  tid=$(kp_env_get "$env_file" TASK_ID)
  project=$(kp_env_get "$env_file" PROJECT)
  worktree=$(kp_env_get "$env_file" WORKTREE)
  tmux_target=$(kp_env_get "$env_file" TMUX_TARGET)
  [ -n "$tid" ] || { refuse "$id" "TASK_ID missing in $env_file"; continue; }
  [ -n "$project" ] || { refuse "$id" "PROJECT missing in $env_file"; continue; }
  [ -n "$worktree" ] || { refuse "$id" "WORKTREE missing in $env_file"; continue; }
  [ -n "$tmux_target" ] || { refuse "$id" "TMUX_TARGET missing in $env_file"; continue; }

  if [ "$(kp_env_get "$env_file" NO_LEASE)" = "1" ]; then
    refuse "$id" "curator task; run kingpin curate"
    continue
  fi

  # The last *worker* event decides whether the task is still restorable. A terminal
  # line means the job is over: there is nothing to resume, and each refusal names the
  # command that finishes or replaces the task.
  last=$(kp_status_last "$task_dir/status")
  case $last in
    merged:*) refuse "$id" "$last; run kingpin done $id"; continue ;;
    cleanup-refused:*) refuse "$id" "$last; run kingpin done $id --force, or fix the cause"; continue ;;
    failed:*) refuse "$id" "$last; spawn a new task, or run kingpin done $id"; continue ;;
  esac

  # A harness that is really in its window means nothing needs restoring; --force is
  # for a driver that knows better (a wedged pane, for example).
  if kp_window_harness_live "$task_dir"; then
    if [ "$force" -eq 0 ]; then
      printf 'OK: %s is already live (%s)\n' "$id" "$KP_WINDOW_LABEL"
      live=$((live + 1))
      continue
    fi
    printf 'kingpin-restore: %s still looks alive (%s); restoring it again because of --force\n' \
      "$id" "$KP_WINDOW_LABEL" >&2
  fi

  [ -d "$worktree" ] || { refuse "$id" "worktree missing: $worktree"; continue; }
  git_dir=$(kp_git_dir "$worktree") || { refuse "$id" "cannot read the git directory of $worktree"; continue; }
  common_dir=$(kp_git_common_dir "$worktree") || { refuse "$id" "cannot read the common git directory of $worktree"; continue; }
  [ "$git_dir" != "$common_dir" ] || { refuse "$id" "$worktree is not a linked worktree"; continue; }
  # The worktree's current branch is what the worker runs on (kingpin-done reads it the
  # same way): a worker may have moved branches since task.env was written.
  branch=$(git -C "$worktree" symbolic-ref --short -q HEAD 2>/dev/null || true)
  [ -n "$branch" ] || { refuse "$id" "worktree $worktree has a detached HEAD; check out the task's branch first"; continue; }

  # The lease is what keeps a slot from being handed to another task while this worker
  # runs. It is advisory here: an unreadable or free lease refuses unless --force, so a
  # driver can still bring back work whose pool state it has already checked.
  project_path=$(kp_env_get "$env_file" PROJECT_PATH)
  lease='unreadable'
  lease_raw=''
  if [ -n "$project_path" ] && [ -d "$project_path" ]; then
    if lease_raw=$(cd "$project_path" && treehouse status --json 2>&1); then
      lease=$(printf '%s\n' "$lease_raw" | node -e '
        const chunks = [];
        process.stdin.on("data", (d) => chunks.push(d)).on("end", () => {
          const text = chunks.join("");
          const want = process.argv[1];
          const norm = (p) => {
            try { return require("fs").realpathSync(p); } catch { return require("path").resolve(p); }
          };
          let rows = null;
          try { rows = JSON.parse(text); } catch {}
          if (!Array.isArray(rows)) {
            for (const line of text.split("\n")) {
              const t = line.trim();
              if (!t.startsWith("[")) continue;
              try { const r = JSON.parse(t); if (Array.isArray(r)) { rows = r; break; } } catch {}
            }
          }
          if (!Array.isArray(rows)) { console.log("unreadable"); return; }
          const target = norm(want);
          const hit = rows.find((r) => r && typeof r.path === "string" && norm(r.path) === target);
          if (!hit) { console.log("missing"); return; }
          console.log(hit.status === "leased" ? "leased" : "available");
        });
      ' "$worktree" 2>/dev/null || echo unreadable)
    fi
  fi
  if [ "$lease" != "leased" ]; then
    case $lease in
      available) lease_reason="worktree $worktree is no longer leased (treehouse reports the slot available)" ;;
      missing) lease_reason="worktree $worktree is not in treehouse's pool listing" ;;
      *) lease_reason="cannot verify the lease on $worktree (treehouse status --json is unavailable or unreadable)" ;;
    esac
    if [ -z "$project_path" ] || [ ! -d "$project_path" ]; then
      lease_reason="PROJECT_PATH is missing or not a directory in $env_file"
    fi
    if [ "$force" -eq 0 ]; then
      refuse "$id" "$lease_reason; run treehouse lease for this worktree if the slot is still yours, or pass --force"
      continue
    fi
    printf 'kingpin-restore: %s continues without a verified lease (%s) because of --force\n' \
      "$id" "$lease_reason" >&2
  fi

  recorded_harness=$(kp_env_get "$env_file" HARNESS)
  [ -n "$recorded_harness" ] || recorded_harness=claude
  harness=${harness_cli:-$recorded_harness}
  case $harness in
    claude|agy|opencode|pi) ;;
    *) refuse "$id" "unsupported harness in $env_file: $harness (must be claude, agy, opencode, or pi)"; continue ;;
  esac
  harness_cmd=$(kp_harness_command "$harness") || { refuse "$id" "unsupported harness: $harness"; continue; }
  if ! command -v "${harness_cmd%% *}" >/dev/null 2>&1; then
    refuse "$id" "missing command: ${harness_cmd%% *}"
    continue
  fi

  # A dead window is not a dead worker: the harness may still hold the task's
  # conversation, so restore resumes the session this task owns instead of starting a
  # second one beside it (issue #168). This block only reads, and every refusal here
  # happens before the command writes anything.
  recorded_session=$(kp_env_get "$env_file" HARNESS_SESSION)
  use_recorded=0
  if [ -z "$harness_cli" ] || [ "$harness_cli" = "$recorded_harness" ]; then
    use_recorded=1
  fi
  rows=() live_rows=()
  sessions_known=1
  sessions_truncated=0
  session_id=''
  session_ok_note='started a new session'
  session_dry_note='started a new session'
  resume_args=()
  session_rc=0
  session_list=$(kp_harness_sessions "$harness" "$worktree") || session_rc=$?
  case $session_rc in
    0|3) ;;
    *) sessions_known=0 ;;
  esac
  if [ "$sessions_known" -eq 1 ]; then
    # Exit 3 means the listing filled the cap: use the rows it did report, but do not
    # read an empty result as proof that the task never had a session.
    if [ "$session_rc" -eq 3 ]; then
      sessions_truncated=1
    fi
    while IFS= read -r row; do
      [ -n "$row" ] || continue
      rows+=("$row")
      IFS=$'\t' read -r sid supdated slabel <<< "$row"
      if kp_harness_session_live "$supdated"; then
        live_rows+=("$row")
      fi
    done <<< "$session_list"
  fi

  # A --harness override must not quietly abandon a task whose recorded harness still
  # has a live session: two live sessions on one worktree is the incident this command
  # repairs. --force is the documented escape, and it names what it leaves running.
  if [ -n "$harness_cli" ] && [ "$harness_cli" != "$recorded_harness" ]; then
    recorded_rc=0
    recorded_list=$(kp_harness_sessions "$recorded_harness" "$worktree") || recorded_rc=$?
    if [ "$recorded_rc" -eq 0 ] || [ "$recorded_rc" -eq 3 ]; then
      recorded_live=()
      while IFS= read -r row; do
        [ -n "$row" ] || continue
        IFS=$'\t' read -r sid supdated slabel <<< "$row"
        if kp_harness_session_live "$supdated"; then
          recorded_live+=("$row")
        fi
      done <<< "$recorded_list"
      if [ "${#recorded_live[@]}" -gt 0 ]; then
        detail=''
        for row in ${recorded_live[@]+"${recorded_live[@]}"}; do
          IFS=$'\t' read -r sid supdated slabel <<< "$row"
          detail="$detail $sid (${slabel:-untitled}, last active $(kp_harness_session_age "$supdated") ago)"
        done
        if [ "$force" -eq 0 ]; then
          refuse "$id" "--harness $harness_cli would add a second live session beside the $recorded_harness session(s) in $worktree:$detail; close one, or pass --force"
          continue
        fi
        printf 'kingpin-restore: %s launches %s and leaves the live %s session(s) running because of --force:%s\n' \
          "$id" "$harness_cli" "$recorded_harness" "$detail" >&2
      fi
    fi
  fi

  # Two live sessions for one worktree means resuming either leaves a competitor
  # driving the same branch and issue. Name every one of them and both remedies.
  n_live=${#live_rows[@]}
  if [ "$n_live" -ge 2 ] && [ "$force" -eq 0 ]; then
    detail=''
    for row in ${live_rows[@]+"${live_rows[@]}"}; do
      IFS=$'\t' read -r sid supdated slabel <<< "$row"
      detail="$detail $sid (${slabel:-untitled}, last active $(kp_harness_session_age "$supdated") ago)"
    done
    case $harness in
      opencode) remedy='opencode session list' ;;
      claude) remedy="the transcripts under ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects" ;;
      *) remedy="$harness sessions" ;;
    esac
    refuse "$id" "$n_live live $harness sessions for $worktree:$detail; close the ones this task does not own ($remedy), then restore again, or pass --force to resume one of them (the task's recorded session when it is among them, otherwise the newest)"
    continue
  fi

  # A live session is the one this task is still driving: prefer the recorded id when it
  # is among them, otherwise the newest live one. With nothing live, a session that
  # finished since the crash is still this task's conversation, so the recorded id wins
  # when it is in the list and the newest is the fallback (a pooled slot's newest).
  chosen=''
  if [ "$n_live" -ge 1 ]; then
    if [ -n "$recorded_session" ] && [ "$use_recorded" -eq 1 ]; then
      for row in ${live_rows[@]+"${live_rows[@]}"}; do
        IFS=$'\t' read -r sid supdated slabel <<< "$row"
        if [ "$sid" = "$recorded_session" ]; then
          chosen=$row
          break
        fi
      done
    fi
    [ -n "$chosen" ] || chosen=${live_rows[0]}
  elif [ "${#rows[@]}" -gt 0 ]; then
    if [ -n "$recorded_session" ] && [ "$use_recorded" -eq 1 ]; then
      for row in ${rows[@]+"${rows[@]}"}; do
        IFS=$'\t' read -r sid supdated slabel <<< "$row"
        if [ "$sid" = "$recorded_session" ]; then
          chosen=$row
          break
        fi
      done
    fi
    [ -n "$chosen" ] || chosen=${rows[0]}
  fi

  # With --force over several live sessions, one note names the ones left running.
  if [ "$n_live" -ge 2 ] && [ "$force" -eq 1 ]; then
    IFS=$'\t' read -r sid supdated slabel <<< "$chosen"
    left=''
    for row in ${live_rows[@]+"${live_rows[@]}"}; do
      IFS=$'\t' read -r live_id live_updated live_label <<< "$row"
      if [ "$live_id" != "$sid" ]; then
        left="$left $live_id (${live_label:-untitled}, last active $(kp_harness_session_age "$live_updated") ago)"
      fi
    done
    printf 'kingpin-restore: %s resumes %s session %s and leaves these running because of --force:%s\n' \
      "$id" "$harness" "$sid" "$left" >&2
  fi

  if [ -n "$chosen" ]; then
    IFS=$'\t' read -r session_id session_updated _ <<< "$chosen"
    session_age=$(kp_harness_session_age "$session_updated" || true)
    if resume_words=$(kp_harness_resume_args "$harness" "$session_id"); then
      while IFS= read -r word; do
        [ -n "$word" ] || continue
        resume_args+=("$word")
      done <<< "$resume_words"
      session_ok_note="resumed session $session_id (last active ${session_age:-unknown} ago)"
      session_dry_note="would resume session $session_id (last active ${session_age:-unknown} ago)"
    else
      # A harness that can list sessions but not resume one keeps the fresh path, and
      # the note says so instead of pretending the conversation came back.
      session_id=''
      session_ok_note="started a new session ($harness cannot resume an existing session)"
      session_dry_note=$session_ok_note
    fi
  elif [ "$sessions_truncated" -eq 1 ]; then
    # The listing stopped at the cap without a row for this worktree. That is not proof
    # the task never had a session, so the fresh note says which one it is.
    session_ok_note="started a new session (the harness listed only its newest ${_kp_session_list_cap} sessions, so the list was truncated)"
    session_dry_note=$session_ok_note
  elif [ "$sessions_known" -eq 0 ]; then
    case $harness in
      agy|codex|pi) session_ok_note="started a new session ($harness cannot report an existing session)" ;;
      *) session_ok_note="started a new session ($harness did not report its sessions)" ;;
    esac
    session_dry_note=$session_ok_note
  fi

  IFS=$'\t' read -r session name < <(kp_window_parts "$env_file")
  [ -n "$session" ] || session=kingpin
  [ -n "$name" ] || name=$id
  # A window name is not a unique claim: two --text tasks can rename to the same issue
  # title, and an operator window can carry a task's name. Reclaiming such a window
  # would kill the other task's pane, so the conflict is refused before this command
  # writes anything.
  if claimed_by=$(kp_window_name_claimed "$task_dir" "$session" "$name"); then
    refuse "$id" "window $session:$name is also named by the live task $claimed_by; name one of the two tasks' windows differently, then restore again"
    continue
  fi
  next=$(next_step "$task_dir" "$id" "$project" "$last")

  if [ "$dry_run" -eq 1 ]; then
    printf 'would restore %s (%s) in %s:%s on %s; %s; last status: %s; next: %s\n' \
      "$id" "$harness" "$session" "$name" "$branch" "$session_dry_note" "${last:-none}" "$next"
    would=$((would + 1))
    continue
  fi

  # Past this point the command writes: the harness override, the resume brief, the
  # preamble, the launch script, the worktree exclude and the window. Everything above
  # refused first. HARNESS is recorded before the preamble because the preamble's pi
  # sentence is chosen by that record (lib/launch.sh): a --harness override has to be
  # visible there, not only after the window has started.
  if [ -n "$harness_cli" ] && ! set_env_key "$env_file" HARNESS "$harness"; then
    refuse "$id" "cannot record HARNESS=$harness in $env_file"
    continue
  fi
  if ! write_resume_prompt "$task_dir" "$id" "$project" "$worktree" "$branch" \
       "$(kp_env_get "$env_file" MODE)" "$harness" "$last" "$next" "$session_id"; then
    refuse "$id" "cannot write the resume brief"
    continue
  fi
  if ! kp_worker_preamble "$task_dir" "$worktree" "$(kp_env_get "$env_file" MODE)"; then
    refuse "$id" "cannot write the worker preamble"
    continue
  fi
  # lib/launch.sh reads the pi provider and model from the environment; a restore
  # exports the pair the spawn recorded, so a pi worker comes back on the model it had.
  # An unset key stays empty and Pi keeps its own default, as at spawn.
  KP_PI_PROVIDER=$(kp_env_get "$env_file" PI_PROVIDER)
  KP_PI_MODEL=$(kp_env_get "$env_file" PI_MODEL)
  export KP_PI_PROVIDER KP_PI_MODEL
  if ! kp_harness_launch_script "$task_dir" "$worktree" "$harness" "$task_dir/resume-prompt.txt" \
       ${resume_args[@]+"${resume_args[@]}"}; then
    refuse "$id" "cannot prepare the $harness launch (reason above)"
    continue
  fi
  # The resumed session is recorded before the window starts, so the next restore
  # resumes the same conversation rather than the newest one in a pooled slot. A stale
  # value is harmless: selection only prefers it while the id is still in the list.
  if [ -n "$session_id" ] && ! set_env_key "$env_file" HARNESS_SESSION "$session_id"; then
    refuse "$id" "cannot record HARNESS_SESSION in $env_file"
    continue
  fi
  # A slot whose exclude pointer was lost would start the worker on a dirty tree: the
  # paths the original launch recorded are hidden again before the harness starts.
  injected=()
  if [ -s "$task_dir/injected" ]; then
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      injected+=("$rel")
    done < "$task_dir/injected"
  fi
  if [ "${#injected[@]}" -gt 0 ]; then
    if ! kp_exclude_write "$worktree" "$task_dir" "$id" "$harness" "${injected[@]}"; then
      refuse "$id" "cannot hide the harness files this launch writes in $worktree"
      continue
    fi
  fi
  if ! "$KP_ROOT/bin/kingpin-scope" check --harness "$harness" --worktree "$worktree" \
       --preamble "$task_dir/preamble.md"; then
    refuse "$id" "refusing to launch a $harness worker: its instruction context is unsafe (files named above)"
    continue
  fi

  # The recorded session died with the server; recreate it under the same name on the
  # socket the record names (issue #142), as a spawn's resolve_tmux_session does for
  # `kingpin`, so the record needs no other change. kp_tmux_has_session matches
  # exactly: a session called `kingpin-workers` is not `kingpin`, and a prefix match
  # here would put the window in a session the record never names (issue #181).
  fleet_socket=$(kp_tmux_socket_from_env "$env_file")
  if ! kp_tmux_has_session "$fleet_socket" "$session"; then
    if ! kp_tmux "$fleet_socket" new-session -d -s "$session" -n home 2>/dev/null; then
      refuse "$id" "cannot create the tmux session $session on $(kp_tmux_label "$fleet_socket")"
      continue
    fi
  fi

  # The marker kingpin-wait reads: a task with a fresh `launching` file is not reported
  # exited between the window creation and the id record.
  : > "$task_dir/launching"
  if ! new_id=$(kp_window_start "$task_dir" "$session" "$name" "$worktree" "$task_dir/launch.sh"); then
    rm -f "$task_dir/launching"
    refuse "$id" "cannot start the window in $session"
    continue
  fi
  if ! kp_window_record_id "$task_dir" "$new_id"; then
    rm -f "$task_dir/launching"
    refuse "$id" "the window exists ($new_id) but its id could not be recorded"
    continue
  fi
  rm -f "$task_dir/launching"

  printf 'OK: restored %s (%s) in %s:%s (%s) on %s; %s; last status: %s; next: %s\n' \
    "$id" "$harness" "$session" "$name" "$new_id" "$branch" "$session_ok_note" "${last:-none}" "$next"
  restored=$((restored + 1))
done

if [ "$dry_run" -eq 1 ]; then
  printf 'OK: would restore %d, %d already live\n' "$would" "$live"
else
  printf 'OK: %d restored, %d already live\n' "$restored" "$live"
fi
if [ "$refused" -gt 0 ]; then
  printf 'kingpin-restore: refused %d task(s)\n' "$refused" >&2
  exit 1
fi
exit 0
