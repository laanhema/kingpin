#!/usr/bin/env bash
# Start one worker for one task: lease a worktree, open a tmux window there,
# and launch the chosen harness (claude, agy, opencode, pi) with the worker
# preamble and the turn-end Stop hook.
#
# Usage: kingpin-spawn <project> (--issue <n> | --text <request>) [--mode review|auto] [--id <task-id>] [--harness claude|agy|opencode|pi] [--tmux-session <name>]
#   --issue    an existing GitHub issue: the worker runs /issue-flow (review) or /do (auto)
#   --text     a free-text request: the worker runs /create-issue first, then the same
#   --mode     review (default) stops at a ready branch for the Lavish review; auto merges when green
#   --id       task id; defaults to kp-<n>-<slug> (slug from the issue title) or kp-<slug>
#              (slug from the request). The id is also the branch (kingpin/<id>) and the
#              tmux window name. An explicit --id skips slug generation.
#   --harness  worker harness: claude, agy, opencode, or pi (overrides everything below)
#   --tmux-session  tmux session for the worker window on the fleet's own server
#
# Workers run on the fleet's own tmux server (issue #142), socket `kingpin` unless
# KINGPIN_TMUX_SOCKET names another. The window's session there is resolved, never
# guessed (issue #152): --tmux-session, then KINGPIN_TMUX_SESSION (both must name a
# session that exists), then the one attached session on that server, then the only
# session it holds. Several unattached sessions, or more than one attached session,
# are refused with their names; only a server with no session at all gets a `kingpin`
# session, and the spawn says so. The success line names the chosen session.
#
# Default harness, first match wins: --harness > project HARNESS (only if set in
# the project env) > the harness recorded by `kingpin lock acquire` for the live
# orchestrator session > DEFAULT_HARNESS in $KINGPIN_HOME/config.env > claude.
#
# Project config: $KINGPIN_HOME/projects/<project>.env sets PROJECT_PATH (a git
# clone), optionally HARNESS (claude|agy|opencode|pi), optionally SETUP_CMD
# (run in the worktree before launch), and for the pi harness optionally
# PI_PROVIDER and PI_MODEL (passed to pi only when set, so a vendor `/login`
# user keeps Pi's own default model).
# KINGPIN_HOME defaults to ~/.kingpin.
# Command overrides: KINGPIN_CLAUDE, KINGPIN_AGY, KINGPIN_OPENCODE, KINGPIN_PI, KINGPIN_GH.
set -euo pipefail

KP_ROOT=$(cd "$(dirname "$0")/.." && pwd)
KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
# shellcheck source=../lib/status.sh
. "$KP_ROOT/lib/status.sh"
# shellcheck source=../lib/portable.sh
. "$KP_ROOT/lib/portable.sh"
# shellcheck source=../lib/exclude.sh
. "$KP_ROOT/lib/exclude.sh"
# shellcheck source=../lib/gitdir.sh
. "$KP_ROOT/lib/gitdir.sh"
# shellcheck source=../lib/tmux.sh
. "$KP_ROOT/lib/tmux.sh"
# shellcheck source=../lib/browser.sh
. "$KP_ROOT/lib/browser.sh"
CLAUDE_CMD=${KINGPIN_CLAUDE:-claude}
AGY_CMD=${KINGPIN_AGY:-agy}
OPENCODE_CMD=${KINGPIN_OPENCODE:-opencode}
PI_CMD=${KINGPIN_PI:-pi}
GH_CMD=${KINGPIN_GH:-gh}
# A hung gh call must degrade to the kp-<n> fallback, not stall the spawn.
GH_TIMEOUT=; ! command -v timeout >/dev/null || GH_TIMEOUT="timeout 10"

die() { echo "kingpin-spawn: $*" >&2; exit 1; }

# Workers live on the fleet's own tmux server (issue #142). Window creation, renames
# and probes all go through kp_tmux on `fleet_socket`, so an operator session kill, or
# a `tmux kill-server` on the default socket, cannot reach a worker. `kingpin list`
# prints how to look at that server.
fleet_socket=$(kp_tmux_socket_name)

# The session on that server, and where it came from. The session is resolved, never
# guessed (issue #152): an explicit target must exist, and with none the one attached
# session on the fleet server is used, then the only session it holds. Several
# candidates are refused, and only a server with no session at all gets the `kingpin`
# fallback, with a note that it created one. The caller's own tmux client is on the
# operator's server, not this one, so its session is not a candidate (issue #142).
# A refusal runs before the worktree is leased, so it costs no worktree and leaves no
# task record. Sets target_session and target_session_source; prints nothing on stdout.
resolve_tmux_session() {
  local explicit=${1:-} explicit_source=${2:-} name attached resolved=''
  local all=() attached_names=() joined='' measured='' attached_joined=''
  if [ -n "$explicit" ]; then
    kp_tmux "$fleet_socket" has-session -t "$explicit" 2>/dev/null \
      || die "refusing to spawn: the session '$explicit' from $explicit_source does not exist on the fleet's tmux server (tmux -L $fleet_socket); start it, or name a session that does"
    # has-session accepts an unambiguous prefix, so record the name tmux resolved it to:
    # storing the prefix would name a session that does not exist (issue #152).
    resolved=$(kp_tmux "$fleet_socket" display-message -p -t "$explicit" '#S' 2>/dev/null) || resolved=''
    [ -n "$resolved" ] \
      || die "refusing to spawn: the session '$explicit' from $explicit_source could not be resolved to a session name"
    target_session=$resolved
    target_session_source="from $explicit_source"
    return 0
  fi
  # Join a session on the fleet server that cannot be mistaken for another: the one an
  # operator attached there, then the only one the server holds. One candidate is not
  # a guess.
  while IFS=$'\t' read -r name attached; do
    [ -n "$name" ] || continue
    all+=("$name")
    [ "$attached" = 0 ] || attached_names+=("$name")
  done < <(kp_tmux "$fleet_socket" list-sessions -F $'#{session_name}\t#{session_attached}' 2>/dev/null || true)
  if [ "${#attached_names[@]}" -eq 1 ]; then
    target_session=${attached_names[0]}
    target_session_source='the only attached session'
    return 0
  fi
  if [ "${#all[@]}" -eq 1 ]; then
    target_session=${all[0]}
    target_session_source='the only session on the server'
    return 0
  fi
  if [ "${#all[@]}" -gt 1 ]; then
    for name in "${all[@]}"; do joined=${joined:+"$joined, "}$name; done
    if [ "${#attached_names[@]}" -eq 0 ]; then
      measured="the fleet's tmux server has ${#all[@]} sessions and none has a client attached ($joined)"
    else
      for name in "${attached_names[@]}"; do
        attached_joined=${attached_joined:+"$attached_joined, "}$name
      done
      measured="the fleet's tmux server has ${#all[@]} sessions and ${#attached_names[@]} of them have a client attached ($attached_joined)"
    fi
    die "refusing to spawn: no single target session on the fleet's tmux server, and $measured; name one with --tmux-session <name> or KINGPIN_TMUX_SESSION=<name>"
  fi
  # Nothing to join. This is the one case where a session is created, and the output
  # says so instead of leaving the worker silently in a session nobody watches.
  kp_tmux "$fleet_socket" new-session -d -s kingpin -n home \
    || die "no session on the fleet's tmux server (tmux -L $fleet_socket) and the fallback session 'kingpin' could not be created"
  printf 'kingpin-spawn: no session on the fleet tmux server; created and using "kingpin" (name one with --tmux-session or KINGPIN_TMUX_SESSION)\n' >&2
  target_session=kingpin
  target_session_source='the named fallback (no session existed)'
  return 0
}

usage() {
  cat <<'HELP'
usage: kingpin-spawn <project> (--issue <n> | --text <request>) [--mode review|auto] [--id <task-id>] [--harness claude|agy|opencode|pi] [--tmux-session <name>]

  --issue    an existing GitHub issue: the worker runs /issue-flow (review) or /do (auto)
  --text     a free-text request: the worker runs /create-issue first, then the same
  --mode     review (default) stops at a ready branch for the review; auto merges when green
  --id       task id; defaults to kp-<n>-<slug> (issue title) or kp-<slug> (request)
  --harness  worker harness: claude, agy, opencode, or pi (overrides the project and the lock)
  --tmux-session  tmux session for the worker window on the fleet's own server
             (also read from KINGPIN_TMUX_SESSION); it must already exist. Without
             either, the one attached session or the only session on the fleet server
             is used, and several unattached sessions or more than one attached
             session are refused
HELP
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac
[ $# -ge 1 ] || die "usage: kingpin-spawn <project> (--issue <n> | --text <request>) [--mode review|auto] [--id <task-id>] [--harness claude|agy|opencode|pi] [--tmux-session <name>]"
project=$1; shift
issue='' text='' mode=review id='' harness_cli='' session_cli=''
while [ $# -gt 0 ]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --issue) issue=${2:?--issue needs a number}; shift 2 ;;
    --text) text=${2:?--text needs a request}; shift 2 ;;
    --mode) mode=${2:?--mode needs review or auto}; shift 2 ;;
    --id) id=${2:?--id needs a value}; shift 2 ;;
    --harness) harness_cli=${2:?--harness needs a value}; shift 2 ;;
    --tmux-session) session_cli=${2:?--tmux-session needs a session name}; shift 2 ;;
    *) die "unknown argument: $1" ;;
  esac
done
[ -n "$issue$text" ] || die "give --issue <n> or --text <request>"
[ -z "$issue" ] || [ -z "$text" ] || die "give only one of --issue and --text"
[ -z "$issue" ] || [[ $issue =~ ^[0-9]+$ ]] || die "--issue must be a number: $issue"
case $mode in review|auto) ;; *) die "--mode must be review or auto: $mode" ;; esac

conf=$KP_HOME/projects/$project.env
[ -f "$conf" ] || die "no project config: $conf"
PROJECT_PATH='' SETUP_CMD='' HARNESS=''
PI_PROVIDER='' PI_MODEL=''
# shellcheck source=/dev/null
. "$conf"
[ -n "$PROJECT_PATH" ] && git -C "$PROJECT_PATH" rev-parse --git-dir >/dev/null 2>&1 \
  || die "PROJECT_PATH in $conf is not a git clone: $PROJECT_PATH"

global_conf=$KP_HOME/config.env
DEFAULT_HARNESS=''
[ -f "$global_conf" ] && DEFAULT_HARNESS=$(kp_env_get "$global_conf" DEFAULT_HARNESS)
lock_harness=$("$KP_ROOT/bin/kingpin-lock" harness 2>/dev/null || true)
harness=${harness_cli:-${HARNESS:-${lock_harness:-${DEFAULT_HARNESS:-claude}}}}
case $harness in
  claude|agy|opencode|pi) ;;
  *) die "unsupported harness: $harness (must be claude, agy, opencode, or pi)" ;;
esac

case $harness in
  claude) harness_bin=${CLAUDE_CMD%% *} ;;
  agy) harness_bin=${AGY_CMD%% *} ;;
  opencode) harness_bin=${OPENCODE_CMD%% *} ;;
  pi) harness_bin=${PI_CMD%% *} ;;
esac

for tool in git tmux treehouse node "$harness_bin"; do
  command -v "$tool" >/dev/null || die "missing command: $tool"
done

if [ -z "$id" ]; then
  if [ -n "$issue" ]; then
    # A failed gh call or an empty slug degrades to kp-<n>; it never aborts the spawn.
    # shellcheck disable=SC2086 # GH_TIMEOUT is "timeout N" or empty and must word-split
    title=$(cd "$PROJECT_PATH" && $GH_TIMEOUT $GH_CMD issue view "$issue" --json title -q .title 2>/dev/null || true)
    slug=$(node "$KP_ROOT/lib/slug.mjs" "$title" 2>/dev/null || true)
    id=kp-$issue${slug:+-$slug}
  else
    slug=$(node "$KP_ROOT/lib/slug.mjs" "$text" 2>/dev/null || true)
    base=kp-${slug:-task}
    id=$base
    n=2
    # Two live text tasks with the same opening words must not collide, and a
    # dossier link left for an archived task is a taken name even when its archive
    # is gone: [ -e ] is false for a dangling link, and the spawn below would then
    # abort on it instead of trying the next suffix.
    while [ -e "$KP_HOME/tasks/$id" ] || [ -L "$KP_HOME/tasks/$id" ]; do id=$base-$n; n=$((n + 1)); done
  fi
fi
[[ $id =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "task id must be lowercase letters, digits, and dashes: $id"

# Resolve the tmux session before anything is leased or written, so a refusal (an
# unknown target, or an ambiguous server) costs no worktree and leaves no record.
target_session=''
target_session_source=''
session_target=${session_cli:-${KINGPIN_TMUX_SESSION:-}}
session_source=''
if [ -n "$session_target" ]; then
  if [ -n "$session_cli" ]; then session_source='--tmux-session'; else session_source='KINGPIN_TMUX_SESSION'; fi
fi
resolve_tmux_session "$session_target" "$session_source"

task_dir=$KP_HOME/tasks/$id
mkdir -p "$KP_HOME/tasks"
# A finished task keeps a symlink at its old path (kingpin done, issue #115), and
# mkdir fails on it. Name what is there: a spawn must never write its harness
# files through that link into the archive. An archive with no link at the task
# path is harmless to reuse: the record lives elsewhere under archive/<id>.
if [ -L "$task_dir" ]; then
  archived=$(kp_task_archive_dir "$KP_HOME" "$id" || true)
  die "task $id is already finished and archived at ${archived:-$KP_HOME/archive/$id}; choose another --id"
fi
mkdir "$task_dir" 2>/dev/null || die "task $id already exists: $task_dir"

worktree=''
launched=0
cleanup() {
  [ "$launched" = 1 ] && return
  if [ -n "$worktree" ]; then
    # A failed spawn must not leave its harness files or ignore pointer for the next
    # task that leases the slot (issue #77).
    kp_exclude_clear "$worktree" "$task_dir" || true
    (cd "$PROJECT_PATH" && treehouse return "$worktree" >/dev/null 2>&1) || true
  fi
  rm -rf "$task_dir"
}
trap cleanup EXIT

branch=kingpin/$id
worktree=$(cd "$PROJECT_PATH" && treehouse get --lease -b "$branch") || die "treehouse could not lease a worktree"
[ -d "$worktree" ] || die "treehouse returned no directory: $worktree"
git_dir=$(kp_git_dir "$worktree") || die "refusing to launch: cannot read the git directory of $worktree"
common_dir=$(kp_git_common_dir "$worktree") || die "refusing to launch: cannot read the common git directory of $worktree"
[ "$git_dir" != "$common_dir" ] || die "refusing to launch: $worktree is not a linked worktree"
[ "$(git -C "$worktree" branch --show-current)" = "$branch" ] || die "worktree is not on $branch"

# The harness files this spawn writes into the worktree must not show up in its
# `git status`, and the file that says so must not be the main checkout's: see
# lib/exclude.sh and issue #77. Each harness below records the paths it injects.
task_exclude_paths=()

# What the pooled slot already carried when this spawn leased it (issue #127). An older
# task's harness files can survive a `kingpin done` that only removed what its own task
# recorded; treehouse then hands the slot out when a stale `.git/info/exclude` line hid
# those files, and they surface the moment the user removes that line. Snapshot the
# visible untracked files now, before SETUP_CMD and the harness branches write anything
# of this task's, so the spawn can name them. Kingpin's own paths are checked in the
# worktree itself below, because the stale line keeps them out of this listing.
task_leftover_paths=()
while IFS= read -r -d '' rel; do
  [ -n "$rel" ] || continue
  task_leftover_paths+=("$rel")
done < <(git -C "$worktree" ls-files -z --others --exclude-standard 2>/dev/null || true)

# Older Kingpin versions appended entries to the shared .git/info/exclude, and
# `kingpin guard install` owns a marked block there for its own contract copies. That
# file belongs to the user and this spawn never edits it, but a broad `.agents/` or
# `.opencode/` line, or one of the exact paths an older spawn appended, hides files
# in every worktree: name it and let the user decide. The lines inside the guard's block
# are skipped, because the guard rewrites them on every install and naming them sends the
# user to remove files the next install puts back (issue #123). Either form may also be
# the user's own line, so the warning suggests where it came from instead of asserting it.
warn_shared_excludes() {
  local excl line rel joined='' named=() injected=()
  local in_guard=0
  excl=$(kp_git_path "$worktree" info/exclude 2>/dev/null || true)
  [ -n "$excl" ] && [ -f "$excl" ] || return 0
  while IFS= read -r rel; do injected+=("$rel"); done < <(kp_exclude_injected_paths)
  while IFS= read -r line; do
    case $line in
      "$KP_GUARD_EXCLUDE_BEGIN") in_guard=1; continue ;;
      "$KP_GUARD_EXCLUDE_END") in_guard=0; continue ;;
    esac
    [ "$in_guard" = 0 ] || continue
    case $line in
      .agents|.opencode|/.agents|/.opencode|.agents/|.opencode/|/.agents/|/.opencode/)
        named+=("$line")
        continue
        ;;
    esac
    for rel in "${injected[@]}"; do
      if [ "$line" = "$rel" ]; then named+=("$line"); break; fi
    done
  done < "$excl"
  [ "${#named[@]}" -gt 0 ] || return 0
  for line in "${named[@]}"; do joined=${joined:+"$joined, "}$line; done
  printf 'kingpin-spawn: %s carries a Kingpin-shaped exclude (%s); an older Kingpin may have written it (or you did), it hides files in every worktree, and this spawn does not edit that file, so remove it yourself\n' \
    "$excl" "$joined" >&2
}

if [ -n "$SETUP_CMD" ]; then
  if ! (cd "$worktree" && bash -c "$SETUP_CMD") > "$task_dir/setup.log" 2>&1; then
    # The cleanup trap deletes $task_dir on a failed spawn, so a message that says "see
    # setup.log" would point at a file that is gone by the time the operator reads it (issue
    # #81). Stream the captured output with a prefix, then die without naming a path.
    while IFS= read -r line || [ -n "$line" ]; do
      printf 'kingpin-spawn: setup: %s\n' "$line" >&2
    done < "$task_dir/setup.log"
    die "setup failed in $worktree; the command's own output is above"
  fi
fi

if [ -n "$issue" ]; then
  printf 'GitHub issue #%s\n' "$issue" > "$task_dir/brief.md"
  case $mode in
    review) prompt=$(kp_skill_command "$harness" issue-flow "$issue") ;;
    auto) prompt=$(kp_skill_command "$harness" "do" "$issue") ;;
  esac
  # Pi expands a skill only when the message starts with its command, so a pi job
  # prompt is the bare `/skill:<name> <args>` line. The other harnesses keep the
  # prose form they have always accepted (`Run /issue-flow 93.`).
  [ "$harness" = pi ] || prompt="Run $prompt."
else
  printf '%s\n' "$text" > "$task_dir/brief.md"
  case $mode in
    review) next=$(kp_skill_command "$harness" issue-flow) ;;
    auto) next=$(kp_skill_command "$harness" "do") ;;
  esac
  first=$(kp_skill_command "$harness" create-issue)
  if [ "$harness" = pi ]; then
    # The bare command comes first so Pi expands it; the follow-up follows in a
    # second paragraph, because dropping it would lose the brief entirely.
    # shellcheck disable=SC2016 # the apostrophe is literal text, not shell quoting
    prompt=$(printf "%s\n\nWhen the issue exists, run %s on it. The request is in %s (read it first; it is the user's own words)." \
      "$first" "$next" "$task_dir/brief.md")
  else
    prompt="Run $first on the request in $task_dir/brief.md (read it first; it is the user's own words). When the issue exists, run $next on it."
  fi
fi
printf '%s\n' "$prompt" > "$task_dir/prompt.txt"

sed -e "s|{{TASK_ID}}|$id|g" -e "s|{{TASK_DIR}}|$task_dir|g" -e "s|{{MODE}}|$mode|g" -e "s|{{WORKTREE}}|$worktree|g" -e "s|{{KP_ROOT}}|$KP_ROOT|g" \
  "$KP_ROOT/worker/preamble.md" > "$task_dir/preamble.md"
# Pi ships no subagent tool (spike.md, Check 2): a delegating skill's steps run
# inline, and /do's no-subagent branch otherwise stops to ask whether to continue.
# The sentence lives in the pi preamble, not the job prompt, so the prompt can start
# with the skill command Pi needs to see (issue #93 review, M2).
if [ "$harness" = pi ]; then
  printf '%s\n' '' 'This harness has no subagent tool: run every step of the skill inline in this session, and continue rather than asking whether to continue without subagents.' >> "$task_dir/preamble.md"
fi
: > "$task_dir/status"

kp_tmux "$fleet_socket" has-session -t "$target_session" 2>/dev/null \
  || die "the session $target_session is gone from the fleet's tmux server (tmux -L $fleet_socket)"

# kingpin-wait does not report "exited" for a task with a fresh marker: task.env
# exists before the window does. Removed once the window ID is recorded.
: > "$task_dir/launching"

# `date -Iseconds` is GNU-only, and a failed command substitution inside the
# heredoc leaves CREATED empty without failing the spawn, which leaves a worker
# that died at launch stuck at (pending). Stop instead.
created=$(kp_now_iso) || die "cannot read the current time (date +%Y-%m-%dT%H:%M:%S%z failed)"

cat > "$task_dir/task.env" <<EOF
TASK_ID=$id
PROJECT=$project
PROJECT_PATH=$PROJECT_PATH
HARNESS=$harness
ISSUE=$issue
MODE=$mode
BRANCH=$branch
WORKTREE=$worktree
TMUX_SOCKET=$fleet_socket
TMUX_TARGET=$target_session:$id
CREATED=$created
EOF

case "$harness" in
  claude)
    node "$KP_ROOT/lib/claude-trust.mjs" "$worktree" >/dev/null
    cat > "$task_dir/launch.sh" <<EOF
#!/usr/bin/env bash
export KINGPIN_TASK_DIR='$task_dir'
export KINGPIN_WORKTREE='$worktree'
export KINGPIN_ROOT='$KP_ROOT'
exec $CLAUDE_CMD --append-system-prompt-file '$task_dir/preamble.md' --settings '$KP_ROOT/worker/hooks.json' "\$(cat '$task_dir/prompt.txt')"
EOF
    ;;
  agy)
    node "$KP_ROOT/lib/agy-trust.mjs" "$worktree" >/dev/null
    mkdir -p "$worktree/.agents/rules"
    # A rules file agy does not recognize is skipped without a word, so the preamble
    # carries the trigger frontmatter that makes agy load it (verified with agy 1.4.12).
    {
      printf -- '---\ntrigger: always_on\ndescription: Kingpin worker preamble\n---\n\n'
      cat "$task_dir/preamble.md"
    } > "$worktree/.agents/rules/kingpin.md"
    cat > "$worktree/.agents/hooks.json" << 'EOF_HOOKS'
{
  "kingpin": {
    "Stop": [
      {
        "type": "command",
        "command": "[ -n \"${KINGPIN_TASK_DIR:-}\" ] || exit 0; if [ -x \"${KINGPIN_ROOT:-/nonexistent}/bin/kingpin-stop\" ]; then \"$KINGPIN_ROOT/bin/kingpin-stop\" || true; else echo \"kingpin: stop hook unavailable (KINGPIN_ROOT unset or kingpin-stop missing); the worker's outcome is not recorded\" >&2; fi; exit 0",
        "timeout": 30
      }
    ]
  }
}
EOF_HOOKS
    task_exclude_paths+=('.agents/rules/kingpin.md' '.agents/hooks.json')
    cat > "$task_dir/launch.sh" <<EOF
#!/usr/bin/env bash
export KINGPIN_TASK_DIR='$task_dir'
export KINGPIN_ROOT='$KP_ROOT'
exec $AGY_CMD --prompt-interactive "\$(cat '$task_dir/prompt.txt')" --dangerously-skip-permissions
EOF
    ;;
  opencode)
    mkdir -p "$worktree/.opencode/plugins"
    # OpenCode V2 reads opencode.json(c) (or .opencode/opencode.json), not
    # .opencode/config.json, which it ignores without a word (verified with
    # opencode 2.2.5: the old file left the worker with no preamble at all).
    # That path is also a project's normal config, holding its own instructions and
    # permissions, so it is merged into, never truncated. A file the project tracks
    # cannot be hidden by .git/info/exclude: rewriting it would start the worker on a
    # dirty tree and a worker could commit the change, so the spawn refuses instead.
    if git -C "$worktree" ls-files --error-unmatch .opencode/opencode.json >/dev/null 2>&1; then
      die "refusing to launch: $worktree/.opencode/opencode.json is tracked by the project; Kingpin must add the preamble to its instructions, so untrack that file (add it to .gitignore) and respawn"
    fi
    # shellcheck disable=SC2016 # single quotes are intentional: the program runs in node
    node -e '
      const fs = require("fs");
      const [file, entry] = [process.argv[1], process.argv[2]];
      let cfg = {};
      if (fs.existsSync(file)) {
        try { cfg = JSON.parse(fs.readFileSync(file, "utf8")); }
        catch (e) { console.error(`kingpin-spawn: ${file} is not valid JSON; fix it before spawning`); process.exit(1); }
      }
      if (cfg === null || typeof cfg !== "object" || Array.isArray(cfg)) {
        console.error(`kingpin-spawn: ${file} must contain a JSON object`); process.exit(1);
      }
      if (cfg.instructions !== undefined && !Array.isArray(cfg.instructions)) {
        console.error(`kingpin-spawn: "instructions" in ${file} must be a JSON array`); process.exit(1);
      }
      cfg.$schema = cfg.$schema || "https://opencode.ai/config.json";
      cfg.instructions = (cfg.instructions || []).filter((e) => e !== entry).concat(entry);
      const tmp = `${file}.tmp.${process.pid}`;
      fs.writeFileSync(tmp, JSON.stringify(cfg, null, 2) + "\n");
      fs.renameSync(tmp, file);
    ' "$worktree/.opencode/opencode.json" "$task_dir/preamble.md"
    cat > "$worktree/.opencode/plugins/package.json" << 'EOF_OC_PKG'
{ "private": true, "type": "module" }
EOF_OC_PKG
    cat > "$worktree/.opencode/plugins/kingpin-stop.js" << 'EOF_OC_PLUG'
import { execFileSync } from "node:child_process";
import path from "node:path";

// The one Stop hook: bin/kingpin-stop records the turn end and appends the missing
// outcome (issue #102). A failed hook warns here and never blocks the stop.
const recordStop = () => {
  const taskDir = process.env.KINGPIN_TASK_DIR;
  if (!taskDir) return;
  const root = process.env.KINGPIN_ROOT;
  if (!root) {
    console.error("kingpin: stop hook unavailable (KINGPIN_ROOT unset); the worker's outcome is not recorded");
    return;
  }
  try {
    execFileSync(path.join(root, "bin", "kingpin-stop"), [], { stdio: ["ignore", "ignore", "inherit"] });
  } catch (err) {
    console.error(`kingpin: stop hook failed: ${err && err.message ? err.message : err}`);
  }
};

const setupEventSubscription = (ctx, handler) => {
  if (!ctx || !ctx.event || !ctx.event.subscribe) return false;
  const controller = new AbortController();
  void (async () => {
    try {
      const stream = await ctx.event.subscribe({ signal: controller.signal, onActivity() {} });
      for await (const event of stream) await handler(event);
    } catch {}
  })();
  return true;
};

const makeHandler = () => {
  return async (event) => {
    const type = event && (event.type || event.name) || "";
    if (
      type === "session.execution.succeeded" ||
      type === "session.execution.interrupted" ||
      type === "session.execution.failed" ||
      type === "session.idle"
    ) {
      recordStop();
    }
  };
};

export const KingpinStop = async () => {
  const handleEvent = makeHandler();
  return {
    event: async ({ event }) => handleEvent(event),
  };
};

export default {
  id: "kingpin.stop",
  server: KingpinStop,
  setup(ctx) {
    setupEventSubscription(ctx, makeHandler());
  },
};
EOF_OC_PLUG
    task_exclude_paths+=('.opencode/opencode.json' '.opencode/plugins/package.json' '.opencode/plugins/kingpin-stop.js')
    cat > "$task_dir/launch.sh" <<EOF
#!/usr/bin/env bash
export KINGPIN_TASK_DIR='$task_dir'
export KINGPIN_ROOT='$KP_ROOT'
exec $OPENCODE_CMD --standalone --auto --prompt "\$(cat '$task_dir/prompt.txt')"
EOF
    ;;
  pi)
    # Pi writes nothing into the worktree (Decision 3): the preamble arrives through
    # --append-system-prompt and the extension loads from this checkout by absolute
    # path, so there is no injected path and no task exclude file. The extension
    # records the turn end and answers the project-trust prompt for this worktree.
    [ -f "$KP_ROOT/worker/pi/kingpin-harness.ts" ] \
      || die "missing harness extension: $KP_ROOT/worker/pi/kingpin-harness.ts"
    pi_args=(--append-system-prompt "$task_dir/preamble.md" -e "$KP_ROOT/worker/pi/kingpin-harness.ts")
    # Each flag is passed only when its own project key is set: a vendor `/login`
    # host keeps Pi's default model, and an inconsistent pair fails in the pane
    # rather than at spawn (no auth preflight here; `kingpin scope doctor` is that job).
    [ -z "$PI_PROVIDER" ] || pi_args+=(--provider "$PI_PROVIDER")
    [ -z "$PI_MODEL" ] || pi_args+=(--model "$PI_MODEL")
    # %q on every argv word keeps a path with spaces intact; the prompt is read from
    # its file at launch, so a long request is never re-quoted into the command line.
    {
      printf '#!/usr/bin/env bash\n'
      printf 'export KINGPIN_TASK_DIR=%q\n' "$task_dir"
      printf 'export KINGPIN_WORKTREE=%q\n' "$worktree"
      printf 'export KINGPIN_ROOT=%q\n' "$KP_ROOT"
      printf 'exec %s' "$PI_CMD"
      printf ' %q' "${pi_args[@]}"
      # shellcheck disable=SC2016 # the program text belongs to the generated launch script
      printf ' "$(cat %q)"\n' "$task_dir/prompt.txt"
    } > "$task_dir/launch.sh"
    ;;
esac

# An earlier task's files at Kingpin's own harness paths (issue #127). A `done` removes
# only the paths its own task recorded, so a pooled slot can still carry them, and a
# stale `.git/info/exclude` line can hide them from treehouse until the user removes that
# line. Remove one here only when its content proves Kingpin wrote it (`lib/leftover.mjs`):
# the worktree is still a checkout of the user's repository and a delete is not
# reversible, so anything else is left in place and named. A path this spawn wrote is not
# a leftover and is skipped; `done` owns those through `<task-dir>/injected` (issue #77).
# The check is on disk, not on the visible listing above, because the stale line hides a
# file from git while it is still there. A tracked file is the project's: never deleted.
kingpin_paths=()
while IFS= read -r rel; do
  [ -n "$rel" ] || continue
  kingpin_paths+=("$rel")
done < <(kp_exclude_injected_paths)

# Visible untracked files that are not at a Kingpin path: they were in the slot before
# this spawn, so name them for the user, but never delete them.
for rel in ${task_leftover_paths[@]+"${task_leftover_paths[@]}"}; do
  skip=0
  for held in ${task_exclude_paths[@]+"${task_exclude_paths[@]}"} ${kingpin_paths[@]+"${kingpin_paths[@]}"}; do
    if [ "$rel" = "$held" ]; then skip=1; break; fi
  done
  [ "$skip" = 0 ] || continue
  printf 'kingpin-spawn: %s was already untracked in %s before this spawn; Kingpin did not write it, so it is left in place (check it yourself)\n' \
    "$rel" "$worktree" >&2
done

for rel in ${kingpin_paths[@]+"${kingpin_paths[@]}"}; do
  skip=0
  for written in ${task_exclude_paths[@]+"${task_exclude_paths[@]}"}; do
    if [ "$rel" = "$written" ]; then skip=1; break; fi
  done
  [ "$skip" = 0 ] || continue
  [ -e "$worktree/$rel" ] || [ -L "$worktree/$rel" ] || continue
  git -C "$worktree" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1 && continue
  if node "$KP_ROOT/lib/leftover.mjs" "$worktree" "$rel" "$KP_HOME"; then
    rm -f "$worktree/$rel" \
      || die "cannot remove the earlier task's leftover $rel from $worktree"
    printf 'kingpin-spawn: removed %s from %s: an earlier task left it there and its content is the shape Kingpin writes\n' \
      "$rel" "$worktree" >&2
  else
    printf 'kingpin-spawn: left %s in %s: it is untracked and its content does not prove Kingpin wrote it, so it is not Kingpin'"'"'s to delete\n' \
      "$rel" "$worktree" >&2
  fi
done

# A browser daemon left in this pooled slot belongs to the task that leased it last
# (issue #160). treehouse can hand a returned slot to this spawn, and the daemon's cwd
# still names the worktree, so stop it before this task's harness starts and name what
# went: a worker must not share the host with a browser nobody is looking at.
browser_stopped=$(kp_browser_stop_under "$worktree" 2>/dev/null || true)
browser_count=${browser_stopped%%$'\t'*}
browser_rss=${browser_stopped##*$'\t'}
case "$browser_count" in ''|*[!0-9]*) browser_count=0 ;; esac
case "$browser_rss" in ''|*[!0-9]*) browser_rss=0 ;; esac
if [ "$browser_count" -eq 1 ]; then
  printf 'kingpin-spawn: stopped 1 browser daemon left in %s by an earlier task (%s freed)\n' \
    "$worktree" "$(kp_browser_size "$browser_rss")" >&2
elif [ "$browser_count" -gt 1 ]; then
  printf 'kingpin-spawn: stopped %s browser daemons left in %s by an earlier task (%s freed)\n' \
    "$browser_count" "$worktree" "$(kp_browser_size "$browser_rss")" >&2
fi

# Record exactly the paths this spawn injected, so the cleanup (`kingpin-done`, or the
# failure trap below) removes only those: a file someone left at another harness's path
# in this slot is not Kingpin's to delete (issue #77 review).
if [ "${#task_exclude_paths[@]}" -gt 0 ]; then
  printf '%s\n' "${task_exclude_paths[@]}" > "$task_dir/injected"
fi

if [ "${#task_exclude_paths[@]}" -gt 0 ]; then
  kp_exclude_write "$worktree" "$task_dir" "$id" "$harness" "${task_exclude_paths[@]}" \
    || die "refusing to launch: $worktree cannot hide the harness files this spawn writes (issue #77)"
fi
# The user's shared exclude file is checked on every spawn, whatever the harness: the
# stale lines an older Kingpin left there are not this harness's business.
warn_shared_excludes

chmod +x "$task_dir/launch.sh"

# Refuse a worker whose context would carry the orchestrator contract, and name the
# file that leaks it (issue #96). The check reads the files the harness really loads,
# so a harness that silently ignores the preamble fails here instead of waking up as
# the orchestrator. A global instruction file in the user's own config directory
# refuses too, unless KINGPIN_ALLOW_GLOBAL_CONTRACT=1 is set.
"$KP_ROOT/bin/kingpin-scope" check --harness "$harness" --worktree "$worktree" --preamble "$task_dir/preamble.md" \
  || die "refusing to launch a $harness worker: its instruction context is unsafe (files named above)"

# Record the window ID (@N): unlike the name in TMUX_TARGET, it survives a
# rename or a move to another session.
window_id=$(kp_tmux "$fleet_socket" new-window -d -P -F '#{window_id}' -t "$target_session:" -n "$id" -c "$worktree" "$task_dir/launch.sh")
# Pin the name: ambient `automatic-rename on` and `allow-rename on` (tmux config,
# or an escape sequence from the worker's child commands) would otherwise
# rename the window. Only kingpin-rename/kingpin-wait renames it, explicitly.
# `|| true`: a failed pin is cosmetic and must not tear down a started worker.
kp_tmux "$fleet_socket" set-window-option -t "$window_id" automatic-rename off || true
kp_tmux "$fleet_socket" set-window-option -t "$window_id" allow-rename off || true
printf 'TMUX_WINDOW_ID=%s\n' "$window_id" >> "$task_dir/task.env"
rm -f "$task_dir/launching"
launched=1

echo "OK: spawned $id ($harness) in $worktree on $branch (tmux -L $fleet_socket $target_session:$id, session $target_session_source, window $window_id, mode $mode)"
