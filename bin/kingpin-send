#!/usr/bin/env bash
# Send text into a kingpin task's tmux window.
#
# Usage: kingpin-send <task-id> "<text>"
#
# The text is typed literally (send-keys -l), so words like Escape or C-c reach
# the pane as characters, not as keypresses. The window is resolved by lib/tmux.sh:
# its own name first, so a send after a tmux server restart reaches the task's own
# window rather than whichever window inherited the stale recorded id. Enter follows in a separate call
# after a short pause (KINGPIN_SEND_DELAY seconds, default 0.2), so a long
# message that a TUI treats as a paste is submitted instead of swallowed.
set -euo pipefail

KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
# shellcheck source=../lib/status.sh
. "$(dirname "$0")/../lib/status.sh"
# shellcheck source=../lib/tmux.sh
. "$(dirname "$0")/../lib/tmux.sh"

usage() {
  cat <<'HELP'
usage: kingpin-send <task-id> <text>

Type <text> literally into the worker's window, then press Enter after
KINGPIN_SEND_DELAY seconds (default 0.2) so a TUI submits it as a paste.
HELP
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac
[ $# -ge 2 ] || { echo "usage: kingpin-send <task-id> <text>" >&2; exit 1; }
id=$1
shift
keys="$*"

task_dir="$KP_HOME/tasks/$id"
[ -d "$task_dir" ] || { echo "kingpin-send: task $id not found: $task_dir" >&2; exit 1; }

# The window is resolved by lib/tmux.sh: its own name first, then the recorded id,
# on the socket the task record names (issue #142), so a send after a tmux server
# restart reaches the task's own window rather than whichever window inherited the
# stale recorded id.
if ! kp_window_find "$task_dir"; then
  echo "kingpin-send: tmux window $KP_WINDOW_LABEL is not alive" >&2
  exit 1
fi

kp_tmux "$KP_WINDOW_SOCKET" send-keys -t "$KP_WINDOW_ID" -l -- "$keys"
sleep "${KINGPIN_SEND_DELAY:-0.2}"
kp_tmux "$KP_WINDOW_SOCKET" send-keys -t "$KP_WINDOW_ID" Enter
echo "OK: sent to $KP_WINDOW_LABEL"
