#!/usr/bin/env bash
# Send text into a kingpin task's tmux window.
#
# Usage: kingpin-send <task-id> "<text>"
#
# The text is typed literally (send-keys -l), so words like Escape or C-c reach
# the pane as characters, not as keypresses. Enter follows in a separate call
# after a short pause (KINGPIN_SEND_DELAY seconds, default 0.2), so a long
# message that a TUI treats as a paste is submitted instead of swallowed.
set -euo pipefail

KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
# shellcheck source=../lib/status.sh
. "$(dirname "$0")/../lib/status.sh"

usage() {
  cat <<'HELP'
usage: kingpin-send <task-id> <text>

Type <text> literally into the worker's window, then press Enter after
KINGPIN_SEND_DELAY seconds (default 0.2) so a TUI submits it as a paste.
HELP
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac
[ $# -ge 2 ] || { echo "usage: kingpin-send <task-id> <text>" >&2; exit 1; }
id=$1
shift
keys="$*"

task_dir="$KP_HOME/tasks/$id"
[ -d "$task_dir" ] || { echo "kingpin-send: task $id not found: $task_dir" >&2; exit 1; }

env_file="$task_dir/task.env"
tmux_target="kingpin:$id"
if [ -f "$env_file" ]; then
  tmux_target=$(kp_env_get "$env_file" TMUX_TARGET)
  [ -n "$tmux_target" ] || tmux_target="kingpin:$id"
fi

# Prefer the window ID (survives rename and move); task.env files from before
# it was recorded only have the name target.
shown_target=$tmux_target
if [ -f "$env_file" ]; then
  window_id=$(kp_env_get "$env_file" TMUX_WINDOW_ID)
  if [ -n "$window_id" ]; then
    tmux_target=$window_id
    shown_target="$shown_target ($window_id)"
  fi
fi

if ! tmux list-panes -t "$tmux_target" >/dev/null 2>&1; then
  echo "kingpin-send: tmux window $shown_target is not alive" >&2
  exit 1
fi

tmux send-keys -t "$tmux_target" -l -- "$keys"
sleep "${KINGPIN_SEND_DELAY:-0.2}"
tmux send-keys -t "$tmux_target" Enter
echo "OK: sent to $shown_target"
