#!/usr/bin/env bash
# Continuous fleet supervision loop for Kingpin: the fleet's one supervisor.
#
# Listens for fleet events via kingpin-wait:
#   1. When a worker in 'auto' mode reports 'ready:', automatically triggers kingpin-land.
#   2. When a worker reports 'merged:', automatically runs kingpin-done to clean up.
#
# Every unprocessed status line is dispatched once, in file order. The cursor is
# the task's `seen` count, advanced line by line through `kingpin-ack --through`,
# so a worker event that a listener note follows is not lost, and lines appended
# while a batch runs stay pending for the next pass. A supervisor restart resumes
# at the first undispatched line; a crash between a dispatch and its ack replays
# that one line (at-least-once, never lost). The count is paired with the handled
# line's text (`seen_line`), so a status file a worker rewrote under the cursor is
# noticed and repaired instead of silently skipping the line it covered (issue #190).
#
# One supervisor per fleet: it claims $KINGPIN_HOME/supervisor.pid (pid on line 1,
# start epoch on line 2) and refuses to start a second copy while that pid is live,
# naming it. A stale file (dead pid, or a pid that is not a kingpin-watch) is
# reclaimed. The pidfile is the lock: it is hard-linked into place, so link(2) lets
# exactly one claimer win and nothing is held while the supervisor runs (flock is
# Linux-only, so it is not used). `--once`, the one-shot pass that `kingpin run`
# and the tests use, returns before the guard and touches no pidfile.
#
# One sweep at a time: the loop and `--once` dispatch and run the maintenance
# steps through the shared watch_sweep, which holds
# $KINGPIN_HOME/locks/watch-sweep.mutex. Without it, a `--once` sweep from
# `kingpin run` and the supervisor's sweep can both read the same `seen` cursor
# and dispatch one status line twice (issue #209). The pidfile and the sweep lock
# answer different questions: the pidfile decides who may run a daemon, the sweep
# lock who may dispatch this pass, and `--once` taking the sweep lock does not
# claim the supervisor slot (#99). A sweep keeps its lock file's mtime fresh while
# it runs, so a slow dispatch is not mistaken for a dead holder.
#
# Usage: kingpin-watch [--once] [--interval <seconds>]
set -euo pipefail

KP_ROOT=$(cd "$(dirname "$0")/.." && pwd)
KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
# shellcheck source=../lib/status.sh
. "$KP_ROOT/lib/status.sh"
# shellcheck source=../lib/tmux.sh
. "$KP_ROOT/lib/tmux.sh"
# shellcheck source=../lib/landing.sh
. "$KP_ROOT/lib/landing.sh"
# shellcheck source=../lib/supervisor.sh
. "$KP_ROOT/lib/supervisor.sh"
# shellcheck source=../lib/afk.sh
. "$KP_ROOT/lib/afk.sh"
# shellcheck source=../lib/curator.sh
. "$KP_ROOT/lib/curator.sh"
# shellcheck source=../lib/dossier.sh
. "$KP_ROOT/lib/dossier.sh"
# shellcheck source=../lib/mutex.sh
. "$KP_ROOT/lib/mutex.sh"
KP_BIN="$KP_ROOT/bin"

ONCE=0
INTERVAL=300

while [ $# -gt 0 ]; do
  case $1 in
    --once) ONCE=1; shift ;;
    --interval)
      # A missing value is caught by the digit case, not by bash's own `${2:?}`
      # message: every bad --interval exits 2, as kingpin-wait does.
      INTERVAL=${2:-}
      case "$INTERVAL" in
        ''|*[!0-9]*) echo "kingpin-watch: --interval needs a whole number of seconds" >&2; exit 2 ;;
      esac
      # Bound the digits before the numeric compare: `[ ... -lt ... ]` fails with
      # "integer expected" past the shell's range, and a failing test inside an
      # `if` is just false, so an overflowing value would pass validation and then
      # leave kingpin-wait --timeout unable to ever time out.
      if [ "${#INTERVAL}" -gt 9 ]; then
        echo "kingpin-watch: --interval is too large (at most 9 digits)" >&2
        exit 2
      fi
      if [ "$INTERVAL" -lt 1 ]; then
        echo "kingpin-watch: --interval must be at least 1 second" >&2
        exit 2
      fi
      shift 2 ;;
    -h|--help)
      cat <<'USAGE'
usage: kingpin-watch [--once] [--interval <seconds>]

Loops as the fleet's supervisor: dispatches landing, fix passes, cleanup and
review listeners. Refuses to start a second copy (it names the running pid) and
reclaims a stale $KINGPIN_HOME/supervisor.pid. --once runs one pass, without
claiming the pidfile. `kingpin list` shows whether a supervisor is running.
--interval takes a whole number of seconds, at least 1 and at most 9 digits
(default 300); anything else exits 2.
USAGE
      exit 0
      ;;
    *) echo "kingpin-watch: unknown argument $1" >&2; exit 2 ;;
  esac
done

SUPERVISOR_PID_FILE="$KP_HOME/supervisor.pid"
CLAIM_TMP="$SUPERVISOR_PID_FILE.claim.$$"
# Every dispatch and maintenance pass goes through this lock, whether it comes
# from the loop or from --once (issue #209).
SWEEP_MUTEX="$KP_HOME/locks/watch-sweep.mutex"
# A sweep holds the mutex for its whole pass, and kp_mutex_acquire reclaims a
# mutex file that is more than a minute old (lib/mutex.sh). A pass can run longer
# than that: a `merged:` line runs kingpin-done, whose git fetch has no timeout,
# and retire_dossiers walks the whole archive. This heartbeat refreshes the file's
# mtime every 15 seconds, four times inside the staleness window, so a live sweep
# is never mistaken for an abandoned one while a dead holder's lock still ages out
# and is reclaimed.
SWEEP_HEARTBEAT_INTERVAL=15
SWEEP_HEARTBEAT_PID=''

# Start the mtime heartbeat for the held $SWEEP_MUTEX. The child exits as soon as
# the file no longer names this shell or this shell is gone, so it cannot keep a
# released lock alive. It must not outlive its owner either: an orphan that kept
# touching the file would make the lock look live forever and defeat the stale
# reclaim that recovers a hung holder. Both release paths stop it as well (the
# EXIT trap here and release_supervisor below).
sweep_heartbeat_start() {
  local owner=$$
  sweep_heartbeat_stop
  (
    while kill -0 "$owner" 2>/dev/null; do
      sleep "$SWEEP_HEARTBEAT_INTERVAL"
      kill -0 "$owner" 2>/dev/null || exit 0
      [ "$(head -n 1 "$SWEEP_MUTEX" 2>/dev/null || true)" = "$owner" ] || exit 0
      touch -c "$SWEEP_MUTEX" 2>/dev/null || exit 0
    done
  ) &
  SWEEP_HEARTBEAT_PID=$!
}

# Stop the heartbeat and reap it. Called before every release of $SWEEP_MUTEX, so
# no child can touch the file after its owner let go of it.
sweep_heartbeat_stop() {
  [ -n "${SWEEP_HEARTBEAT_PID:-}" ] || return 0
  kill "$SWEEP_HEARTBEAT_PID" 2>/dev/null || true
  wait "$SWEEP_HEARTBEAT_PID" 2>/dev/null || true
  SWEEP_HEARTBEAT_PID=''
}

# release_supervisor replaces this trap for the daemon; both release the sweep lock.
trap 'sweep_heartbeat_stop; kp_mutex_release "$SWEEP_MUTEX"' EXIT

# Remove the pidfile only when it still names this process. Runs on a normal exit,
# on a signal, and when a second copy is refused. Another supervisor's pidfile is
# never touched: the file is that supervisor's claim on the slot.
release_supervisor() {
  sweep_heartbeat_stop
  kp_mutex_release "$SWEEP_MUTEX"
  if [ -f "$SUPERVISOR_PID_FILE" ] \
     && [ "$(sed -n 1p "$SUPERVISOR_PID_FILE" 2>/dev/null | tr -d ' ' || true)" = "$$" ]; then
    rm -f "$SUPERVISOR_PID_FILE"
  fi
  rm -f "$CLAIM_TMP"
  [ -z "${EVENTS_FILE:-}" ] || rm -f "$EVENTS_FILE"
  [ -z "${WAIT_ERR:-}" ] || rm -f "$WAIT_ERR"
}

# Claim the supervisor slot, or refuse. The pidfile is the lock: it is written to a
# private file and hard-linked into place, so exactly one claimer wins and no
# contender ever sees a pidfile without its pid inside. A pidfile whose pid is dead,
# or is not a kingpin-watch process, is stale: it is renamed away and the claim
# retried. The rename is checked against the pid that was inspected, so two
# reclaimers cannot delete each other's fresh claim. Nothing stays held while the
# supervisor runs, so a refused second copy cannot disturb the first copy's claim.
claim_supervisor() {
  local tries=0 pid seen moved stale
  mkdir -p "$KP_HOME"
  trap release_supervisor EXIT
  trap 'exit 0' INT TERM
  while [ "$tries" -lt 120 ]; do
    tries=$((tries + 1))
    if ! printf '%s\n%s\n' "$$" "$(date +%s)" > "$CLAIM_TMP" 2>/dev/null; then
      sleep 0.05
      continue
    fi
    chmod 644 "$CLAIM_TMP" 2>/dev/null || true
    if ln "$CLAIM_TMP" "$SUPERVISOR_PID_FILE" 2>/dev/null; then
      rm -f "$CLAIM_TMP"
      return 0
    fi
    rm -f "$CLAIM_TMP"

    pid=$(kp_supervisor_pid "$KP_HOME")
    if [ -n "$pid" ] && [ "$pid" != "$$" ]; then
      echo "kingpin-watch: a fleet supervisor is already running (pid $pid); use 'kingpin list' to see it" >&2
      exit 1
    fi

    # Stale. Reclaim only the file this pass inspected, and hand a fresh claim that
    # appeared after the read back untouched.
    seen=''
    [ -f "$SUPERVISOR_PID_FILE" ] \
      && seen=$(sed -n 1p "$SUPERVISOR_PID_FILE" 2>/dev/null | tr -d ' ' || true)
    stale="$SUPERVISOR_PID_FILE.stale.$$"
    rm -f "$stale"
    if mv "$SUPERVISOR_PID_FILE" "$stale" 2>/dev/null; then
      moved=''
      [ -f "$stale" ] && moved=$(sed -n 1p "$stale" 2>/dev/null | tr -d ' ' || true)
      if [ "$moved" = "$seen" ]; then
        rm -f "$stale"
      elif [ -e "$SUPERVISOR_PID_FILE" ]; then
        rm -f "$stale"
      else
        mv "$stale" "$SUPERVISOR_PID_FILE" 2>/dev/null || rm -f "$stale"
      fi
    fi
    sleep 0.05
  done
  echo "kingpin-watch: cannot claim $SUPERVISOR_PID_FILE" >&2
  exit 1
}

# ---- AFK auto-landing (issue #94) -------------------------------------------
# Everything AFK does to a ready: or fixed: line lives in this block, so a parallel
# change to those branches below stays a trivial rebase. It only decides whether to
# call kingpin-land: the verdict gate and the per-project landing lane stay exactly
# where they are. kingpin-land runs no report check; the check is the warning this
# supervisor runs in its review branch and in the AFK clean branch below. Each
# function returns 1 when the line is not AFK's, which is how the caller gets
# today's behaviour unchanged.

# Warn when a task's dossier fails kingpin report check. The review branch runs it
# before it opens the page, and the AFK clean branch runs it before landing, so an
# AFK landing gets the same warning an operator's review does. kingpin-land itself
# runs no check.
warn_report_check() {
  local id=$1 task_dir=$2
  [ -f "$task_dir/report.html" ] || return 0
  "$KP_BIN/kingpin-report" check "$task_dir/report.html" >/dev/null 2>&1 \
    || echo "[kingpin-watch] WARNING $id report.html fails kingpin report check (blank diffs, an overflowing layout or sloppy prose); run kingpin report check $task_dir/report.html to see the reason" >&2
}

# The audit note for a landing AFK decided. It is written at most once per task, so
# a replayed line or a leftover marker cannot append it twice. The note matches
# approved:*, which kp_status_last skips, so the verdict gate still reads the
# ready:/fixed: line and the note cannot trigger another landing. It goes through
# kp_status_note like the listener's notes, so it never moves the Stop hook's turn
# boundary (a worker that ends its next turn silently still gets its failed: line).
afk_note_landing() {
  local task_dir=$1
  grep -qxF 'approved: auto (afk)' "$task_dir/status" 2>/dev/null && return 0
  kp_status_note "$task_dir/status" "$task_dir/stopped" 'approved: auto (afk)'
}

afk_dispatch_ready() {
  local id=$1
  local task_dir=$2
  local line=$3
  local kind

  kp_afk_armed "$KP_HOME" || return 1

  # The dossier listener records landing_sent once it has started a landing and
  # approve_pending while an approval's fix pass or re-review runs. Either marker
  # means the decision was already taken, so AFK must not take it again.
  if [ -f "$task_dir/landing_sent" ] || [ -f "$task_dir/approve_pending" ]; then
    echo "[kingpin-watch] $id is ready (afk on); a landing or fix pass is already under way"
    return 0
  fi

  kind=$(kp_verdict_kind "$(kp_status_verdict "$line")")
  case "$kind" in
    clean)
      echo "[kingpin-watch] $id is ready with a clean verdict (afk on); auto-landing..."
      warn_report_check "$id" "$task_dir"
      if "$KP_BIN/kingpin-land" "$id"; then
        # Note only a landing that actually started (landing_sent), the same rule
        # the fixed: branch uses. A line that only queued behind a live holder
        # carries no note: it is not a decision AFK has completed yet.
        if [ -f "$task_dir/landing_sent" ]; then
          afk_note_landing "$task_dir"
        fi
        # A re-review ready: line takes over from an earlier AFK-started fix pass,
        # so that pass's marker must not make a later fixed: line note again.
        rm -f "$task_dir/afk_fix_pass"
      fi
      ;;
    findings)
      # The landing gate makes the call, not AFK: it lands a report whose open
      # findings are all Low (and writes followups.md), and runs the fix pass for
      # anything blocking or unreadable. AFK reads the markers land wrote instead
      # of deciding the same question twice.
      echo "[kingpin-watch] $id review has findings (afk on); asking the landing gate..."
      if "$KP_BIN/kingpin-land" "$id"; then
        if [ -f "$task_dir/landing_sent" ]; then
          # It landed past the findings, so this line is the decision AFK took.
          afk_note_landing "$task_dir"
          rm -f "$task_dir/afk_fix_pass"
        elif [ -f "$task_dir/landing_in_progress" ]; then
          # The pass was AFK-started whatever the task's mode, so its clean fixed:
          # line gains the note that records who decided.
          touch "$task_dir/afk_fix_pass"
        fi
      fi
      ;;
    *)
      echo "[kingpin-watch] $id is ready but its review verdict cannot be read (afk on); holding for the operator" >&2
      ;;
  esac
  return 0
}

# A fixed: line for an AFK-started fix pass. Only the afk_fix_pass marker claims
# the line; the approved: auto (afk) note does not, because afk_note_landing already
# refuses to write it twice. The marker survives the /review round of a pass that
# left High findings, so the clean landing that follows gains the note; AFK only
# owns the line while the arm is still live: once it is off or expired, the marker
# is dropped and today's branch lands the line without an AFK note (review M1).
afk_dispatch_fixed() {
  local id=$1
  local task_dir=$2
  local line=$3
  local high

  if ! kp_afk_armed "$KP_HOME"; then
    rm -f "$task_dir/afk_fix_pass"
    return 1
  fi
  # A landing already sent must not dispatch a second one. This is a no-op guard,
  # not a claim: it also covers a replayed fixed: line after AFK cleared its marker.
  if [ -f "$task_dir/landing_sent" ]; then
    echo "[kingpin-watch] $id reported fix pass (afk on); the landing is already under way"
    rm -f "$task_dir/afk_fix_pass"
    return 0
  fi
  # Only an AFK-started pass is AFK's. A task AFK already landed is not claimed
  # again from its audit note alone; afk_note_landing keeps that note single.
  if [ ! -f "$task_dir/afk_fix_pass" ]; then
    return 1
  fi
  # A dossier approval owns this pass; its listener records that approval itself.
  if [ -f "$task_dir/approve_pending" ]; then
    rm -f "$task_dir/afk_fix_pass"
    return 1
  fi
  echo "[kingpin-watch] $id reported fixed: from an AFK-started fix pass; continuing landing..."
  if "$KP_BIN/kingpin-land" "$id"; then
    if [ -f "$task_dir/landing_sent" ]; then
      afk_note_landing "$task_dir"
      rm -f "$task_dir/afk_fix_pass"
    else
      # A clean fixed: line that only queued behind a live holder starts no
      # landing yet, so it carries no note; drop the marker so it cannot claim a
      # later fixed: line. A line that still leaves High findings only requests
      # /review, so its marker stays for the clean ready: that follows.
      high=$(kp_status_field "$line" high)
      if [ "$high" = "0" ]; then
        rm -f "$task_dir/afk_fix_pass"
      fi
    fi
  fi
  return 0
}

# listener_is_live <task-dir>: a background listener is running for the task.
# `kingpin-listen` writes the child's pid to listener.pid, and its EXIT trap removes
# the file, so a live pid there is the one thing a launch leaves behind when it
# really started a listener.
listener_is_live() {
  local dir=$1 pid
  [ -f "$dir/listener.pid" ] || return 1
  pid=$(cat "$dir/listener.pid" 2>/dev/null || true)
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# start_dossier_listener <task-id> <task-dir>: start a background listener, or
# confirm the one already running, and report whether one runs afterwards. The
# launcher's exit status is not that answer: `kingpin-listen --background` exits 0
# without a listener when lavish-axi is missing, when it cannot take the launch
# lock, and when its child never writes listener.pid (issue #182 review M1). Its
# own explanation is discarded by the launch, so it is repeated on stderr when the
# launch left nothing behind (its child logs the rest to listener.log).
start_dossier_listener() {
  local id=$1 dir=$2 out line
  out=$("$KP_BIN/kingpin-listen" "$id" --background 2>&1) || true
  listener_is_live "$dir" && return 0
  line=$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | head -n 1 || true)
  [ -z "$line" ] || echo "$line" >&2
  return 1
}

# Apply one status line. The case is the dispatch table; process_task_event calls
# it once per unprocessed line, so a worker event batched with a listener note
# cannot be acknowledged away.
dispatch_status_line() {
  local id=$1
  local task_dir=$2
  local mode=$3
  local line=$4

  case "$line" in
    ready:*)
      if afk_dispatch_ready "$id" "$task_dir" "$line"; then
        # AFK owned this line: it landed, started a fix pass, or held it.
        :
      elif [ "$mode" = "auto" ] && [ ! -f "$task_dir/landing_sent" ]; then
        echo "[kingpin-watch] $id is ready (auto mode); initiating landing..."
        "$KP_BIN/kingpin-land" "$id" || true
      elif [ "$mode" = "review" ]; then
        if [ -f "$task_dir/landing_in_progress" ] && [ ! -f "$task_dir/landing_sent" ]; then
          echo "[kingpin-watch] $id is ready (review mode, landing in progress); continuing landing..."
          "$KP_BIN/kingpin-land" "$id" || true
        else
          echo "[kingpin-watch] $id is ready for review (lavish-axi $task_dir/report.html)"
          if [ -f "$task_dir/report.html" ]; then
            warn_report_check "$id" "$task_dir"
            if start_dossier_listener "$id" "$task_dir"; then
              echo "[kingpin-watch] $id: dossier listener started"
            else
              echo "[kingpin-watch] $id: could not start the dossier listener; open the page by hand (lavish-axi $task_dir/report.html)" >&2
            fi
          fi
        fi
      fi
      ;;
    approved:*)
      # kingpin-listen already ran kingpin-land for a dossier approval; AFK wrote
      # its own note after landing, and neither note may start another landing.
      case "$line" in
        "approved: auto (afk)")
          echo "[kingpin-watch] $id was auto-landed by AFK (approved: auto (afk))"
          ;;
        *)
          echo "[kingpin-watch] $id was approved via the review dossier; landing started by its listener"
          ;;
      esac
      ;;
    feedback:*)
      echo "[kingpin-watch] $id received review feedback: $line"
      ;;
    fixed:*)
      if afk_dispatch_fixed "$id" "$task_dir" "$line"; then
        # AFK owned this fixed: line: it landed, or left the re-review running.
        :
      elif [ "$mode" = "auto" ] || [ -f "$task_dir/landing_in_progress" ]; then
        echo "[kingpin-watch] $id reported fix pass; continuing landing..."
        "$KP_BIN/kingpin-land" "$id" || true
      fi
      ;;
    merged:*)
      if [ ! -f "$task_dir/done_cleaned" ]; then
        echo "[kingpin-watch] $id merged; running cleanup..."
        "$KP_BIN/kingpin-done" "$id" || true
      fi
      ;;
    cleanup-refused:*)
      echo "[kingpin-watch] $id cleanup refused: ${line#cleanup-refused: }"
      ;;
    failed:*)
      echo "[kingpin-watch] $id reported failure: $line"
      ;;
    needs-input:*)
      echo "[kingpin-watch] $id needs input (question at $task_dir/question.md)"
      ;;
    waiting:*)
      echo "[kingpin-watch] $id is waiting: ${line#waiting: }"
      ;;
  esac
}

process_task_event() {
  # $2 is the kingpin-wait reason (status|quiet|exited); every reason is acked.
  local id=$1
  local task_dir="$KP_HOME/tasks/$id"
  # A task kingpin-done archived keeps a symlink at its old path (issue #115).
  # Its events are already dispatched (or moot): a ready: there must not start a
  # listener, and a merged: there must not clean it up a second time.
  kp_task_is_live "$task_dir" || return 0

  local env_file="$task_dir/task.env"
  [ -f "$env_file" ] || return 0

  local mode
  mode=$(kp_env_get "$env_file" MODE)
  [ -n "$mode" ] || mode="review"

  local status_file="$task_dir/status"

  # The cursor: how many lines are already handled. It lives on disk, so a
  # supervisor restart resumes at the first undispatched line instead of
  # replaying handled lines or losing the ones that came after.
  local seen=0 total=0
  [ -f "$task_dir/seen" ] && seen=$(tr -d ' \n' < "$task_dir/seen" 2>/dev/null || true)
  case $seen in ''|*[!0-9]*) seen=0 ;; esac

  # A task directory can carry task.env and no status file (hand-made or repaired
  # by hand). It is not an early return: the ack at the end still has to run, or a
  # quiet/exited event for such a task is reported on every pass and the
  # supervisor spins. With no file the loop below dispatches nothing.
  local i=$seen line
  if [ -f "$status_file" ]; then
    # A status file rewritten under the cursor (issue #190). kingpin-ack records the
    # handled line's text beside the count, so a rewrite (a line removed, the file
    # reordered or truncated) shows up as another line at the cursor's index. The
    # count then names no line, so dispatch resumes where the anchor still is, and
    # the one repair that moves the cursor backwards says so on stderr, naming the
    # task. Replaying handled lines is allowed here, as everywhere in this loop;
    # losing one is not.
    local resume
    resume=$(kp_status_cursor_resume "$task_dir")
    if [ "$resume" != "$seen" ]; then
      echo "[kingpin-watch] $id status file was rewritten under its cursor ($(wc -l < "$status_file" | tr -d ' ') line(s), seen $seen); resuming at line $((resume + 1))" >&2
      "$KP_BIN/kingpin-ack" --through "$resume" --rewind "$id" >/dev/null 2>&1 || true
      seen=$resume
      i=$resume
    fi
    total=$(wc -l < "$status_file" | tr -d ' ')

    # Read at most the lines that existed when this pass started. A line a
    # dispatch appends (kingpin-done's cleanup-refused:, a listener note) gets a
    # number past `total`, so it stays pending for the next pass rather than
    # being swallowed.
    while [ "$i" -lt "$total" ] && IFS= read -r line; do
      i=$((i + 1))
      # Blank and issue: lines are informational: they advance the cursor but
      # dispatch nothing, exactly as kingpin-wait treats them.
      if [ "${line#issue:}" = "$line" ] && [ -n "${line//[[:space:]]/}" ]; then
        dispatch_status_line "$id" "$task_dir" "$mode" "$line"
      fi
      # Ack after the line is handled, through its index only, so later appends
      # stay pending. A crash between the dispatch and this write replays that one
      # line (at-least-once, never lost).
      "$KP_BIN/kingpin-ack" --through "$i" "$id" >/dev/null 2>&1 || true
    done < <(tail -n +$((seen + 1)) "$status_file")
  fi

  # Every event is acknowledged, including a status-less `quiet` or `exited` one:
  # seen_stopped, seen_activity and seen_exited live in the same ack, and without
  # this call kingpin-wait reports the event on every pass (a supervisor spin).
  # --through "$i" keeps the status cursor where the batch ended (i is `seen` when
  # there was no pending line), so a line appended meanwhile stays pending.
  "$KP_BIN/kingpin-ack" --through "$i" "$id" >/dev/null 2>&1 || true
}

# Retry cleanups that kingpin-done refused (dirty worktree, HEAD not yet on the
# remote default branch). A task is pending while its last status is
# cleanup-refused: and it has no done_cleaned marker. kingpin-done does not add
# a status line when the refusal reason is unchanged, so retrying every cycle
# raises no new events; it writes done_cleaned once the cleanup succeeds.
retry_pending_cleanups() {
  local dir id last
  for dir in "$KP_HOME"/tasks/*; do
    kp_task_is_live "$dir" || continue
    [ -f "$dir/task.env" ] || continue
    [ ! -f "$dir/done_cleaned" ] || continue
    id=$(basename "$dir")
    last=$(kp_status_last "$dir/status")
    case "$last" in
      cleanup-refused:*) "$KP_BIN/kingpin-done" "$id" >/dev/null 2>&1 || true ;;
    esac
  done
}

# Advance a project's landing queue whose holder released or is gone. An entry
# appended between kingpin-land's holder check and its claim would otherwise sit
# in a queue with no holder, and nothing else picks it up; this is the recovery
# path, so it needs no new fleet event.
advance_landing_queues() {
  local q project
  for q in "$KP_HOME"/projects/*.landing_queue; do
    [ -f "$q" ] || continue
    project=$(basename "$q" .landing_queue)
    kp_landing_drain "$KP_HOME" "$project" "$KP_BIN" || true
  done
}

# A review task's dossier listener runs until kingpin-done stops it, but it can die
# on its own: kingpin-listen gives up after 20 consecutive poll failures and its EXIT
# trap removes the pid file, and a killed listener leaves the file naming a dead pid.
# Nothing re-armed it before, so the reviewer's clicks queued in a session nobody read.
# This is a sweep, not an event branch, because the task's ready: line is already acked.
rearm_listeners() {
  local dir id mode last
  # Without lavish-axi kingpin-listen only prints a note and exits 0; skip the sweep
  # so a host without it does not relaunch one listener per task per cycle.
  command -v "${KINGPIN_LAVISH:-lavish-axi}" >/dev/null 2>&1 || return 0
  for dir in "$KP_HOME"/tasks/*; do
    kp_task_is_live "$dir" || continue
    [ -f "$dir/task.env" ] || continue
    [ -f "$dir/report.html" ] || continue
    [ ! -f "$dir/lavish_ended" ] || continue      # the reviewer ended the session
    [ ! -f "$dir/done_cleaned" ] || continue      # finished
    [ ! -f "$dir/landing_sent" ] || continue      # the review is decided
    [ ! -f "$dir/landing_in_progress" ] || continue
    mode=$(kp_env_get "$dir/task.env" MODE)
    [ -n "$mode" ] || mode="review"               # the same default process_task_event uses
    [ "$mode" = "review" ] || continue            # auto mode never had a listener
    last=$(kp_status_last "$dir/status")
    case "$last" in
      # The dossier is live only once the worker has reported for review; the
      # listener's own approval gate uses the same two lines.
      ready:*|fixed:*) ;;
      *) continue ;;
    esac
    id=$(basename "$dir")
    listener_is_live "$dir" && continue
    echo "[kingpin-watch] $id: dossier listener is gone; re-arming"
    if start_dossier_listener "$id" "$dir"; then
      echo "[kingpin-watch] $id: dossier listener re-armed"
    else
      echo "[kingpin-watch] $id: could not re-arm the dossier listener; open the page by hand (lavish-axi $dir/report.html)" >&2
    fi
  done
}

# A finished task's dossier is retired (issue #186). `kingpin done` marks the page of the
# task it archives; this sweep covers the records that reached a finished state without
# that step: an archive from before the marker existed, a `failed:` task, and a page
# rewritten by hand. A record that is not finished, archived or not, is left alone. It
# also ends the Lavish session a reviewer left open on such a page, once, recording that
# in the record's `dossier.ended` marker, so a browser tab full of live-looking buttons
# cannot sit there for hours. Marking is guarded by a grep, so a sweep over a long archive
# reads each page once and runs the helper only for the ones still unmarked. Runs in
# --once and in every loop.
retire_dossiers() {
  local dir id page end_out
  for dir in "$KP_HOME"/tasks/* "$KP_HOME"/archive/*; do
    [ -d "$dir" ] || continue
    # The dossier link kingpin done leaves at tasks/<id> is not a record: archive/ holds
    # the page it resolves to, and the second half of this loop reaches it there.
    case "$dir" in
      "$KP_HOME"/tasks/*) kp_task_is_live "$dir" || continue ;;
    esac
    # Only a finished record is retired, whichever half it was found in: a hand-archived
    # record whose work is not over keeps its page and its session (issue #186 review H2).
    kp_task_is_finished "$dir" || continue
    page=$(kp_dossier_file "$dir") || continue
    id=$(basename "$dir")
    if ! kp_dossier_marked "$page" && command -v node >/dev/null 2>&1; then
      if ! kp_dossier_mark "$dir" "$id" >/dev/null 2>&1; then
        echo "[kingpin-watch] $id: could not mark $page finished; run kingpin-done $id --force, or edit the page by hand" >&2
      fi
    fi
    # Nothing to end for a record that never opened a session. kp_dossier_end returns 1
    # when lavish-axi itself failed, which is retried on the next sweep.
    end_out=''
    if end_out=$(kp_dossier_end "$KP_HOME" "$dir"); then
      [ -z "$end_out" ] || echo "[kingpin-watch] $id: $end_out"
    else
      echo "[kingpin-watch] $id: could not end the dossier session for $page; run lavish-axi end $(kp_dossier_session_path "$KP_HOME" "$dir") by hand" >&2
    fi
  done
}

# A tmux server that dies takes every worker window with it, and nothing restarts it:
# the records still name the socket, so the fleet reads as a table of DEAD rows and no
# worker is running. The supervisor owns the fleet's lifecycle, so it owns this too: for
# each socket a live task record names that no longer answers, log one line and hand the
# tasks on it to kingpin-restore (issue #149), which recreates the session (and with it
# the server) and re-arms each window with a resume brief. This runs before the wait
# pass, so a restored window is back before `exited` would be raised for it, and it runs
# on every sweep, so a server that dies while the supervisor runs is brought back on the
# next pass. Curator tasks are skipped (curate reaps its own window) and a terminal task
# is skipped (restore would refuse it by name).
restore_skips() {
  [ "$(kp_env_get "$1/task.env" NO_LEASE)" = "1" ] && return 0
  kp_status_is_terminal "$(kp_status_last "$1/status")"
}
restore_fleet_sockets() {
  local sock ids
  while IFS=$'\t' read -r sock ids; do
    kp_tmux_socket_reachable "$sock" && continue
    echo "[kingpin-watch] the tmux server '$sock' is not running; restoring $ids"
    # shellcheck disable=SC2086 # ids is a space-separated list of task ids
    "$KP_BIN/kingpin-restore" $ids >/dev/null 2>&1 \
      || echo "[kingpin-watch] kingpin-restore refused at least one task on the tmux server '$sock'; run kingpin restore to see why" >&2
  done < <(kp_tmux_live_by_socket --skip restore_skips "$KP_HOME"/tasks/*)
}

# Dispatch one batch of kingpin-wait events. The batch may have been read before
# the sweep lock was taken, and that is safe: process_task_event starts from the
# task's on-disk `seen` cursor, so an event another sweep already handled reads as
# nothing pending here.
dispatch_updates() {
  local updates=${1:-} id reason
  [ -n "$updates" ] || return 0
  while IFS=' ' read -r id reason; do
    [ -n "$id" ] || continue
    process_task_event "$id" "$reason"
  done <<< "$updates"
}

# Run one maintenance step, naming it and carrying on when it fails. A failure is
# logged so it reaches the fleet log even though the sweep also runs unattended;
# the rest of the pass still runs, because a step that fails once must not take the
# supervisor down with it. The `||` suppresses errexit only for this step, whose
# status is inspected here, not for the sweep.
sweep_step() {
  local name=$1 rc=0
  shift
  "$@" || rc=$?
  [ "$rc" -eq 0 ] || echo "[kingpin-watch] sweep step '$name' failed (exit $rc); continuing" >&2
  return 0
}

# The steps every sweep runs after its event batch. Listed once here so `--once`
# and the loop cannot drift apart (issue #209).
sweep_steps() {
  sweep_step retry_pending_cleanups retry_pending_cleanups
  sweep_step advance_landing_queues advance_landing_queues
  sweep_step rearm_listeners rearm_listeners
  sweep_step retire_dossiers retire_dossiers
  # issue #88: one non-blocking auto-curate chance per idle sweep.
  sweep_step auto-curate kp_curate_maybe "$KP_HOME" "$KP_BIN"
}

# watch_sweep <updates>: dispatch this pass's event batch and run the maintenance
# steps, holding $SWEEP_MUTEX for the whole pass. The lock is what makes the `seen`
# read, the dispatch and the ack one step: a concurrent sweep waits here and then
# finds the line already acknowledged (issue #209). A sweep that finds the lock
# held names the holder and skips this pass; the caller carries on, so `kingpin
# run` keeps working beside a supervisor. Both paths call this as a plain command
# (it always returns 0), so errexit stays on inside the sweep and a step failure
# is reported by sweep_step instead of being hidden by a `|| true` (review L4). A
# live holder's lock is kept fresh by the heartbeat above; a dead holder's is
# reclaimed by the helper.
watch_sweep() {
  local updates=${1:-}
  if ! kp_mutex_acquire "$SWEEP_MUTEX"; then
    echo "[kingpin-watch] another sweep is running (pid ${kp_mutex_owner:-unknown}); skipping this pass" >&2
    return 0
  fi
  sweep_heartbeat_start
  dispatch_updates "$updates"
  sweep_steps
  sweep_heartbeat_stop
  kp_mutex_release "$SWEEP_MUTEX"
  return 0
}

# The step every pass runs before its wait: a socket whose server died is restored
# first, so `kingpin-wait` cannot raise `exited` for a window that is about to come
# back (issue #149). Listed once so the `--once` and loop entry points cannot drift
# apart (issue #209 review L1). It stays outside the sweep lock because the wait
# runs before the sweep.
watch_pass_begin() {
  restore_fleet_sockets
}

if [ "$ONCE" -eq 1 ]; then
  watch_pass_begin
  # The wait may run before the lock: a batch another sweep handles meanwhile
  # leaves this pass with nothing pending, not with a second dispatch.
  watch_sweep "$("$KP_BIN/kingpin-wait" --once 2>/dev/null || true)"
  exit 0
fi

claim_supervisor
echo "[kingpin-watch] Watching fleet events (pid $$)..."

# Run each wait in the background and `wait` on it: a trap runs only after the
# current foreground command finishes, so a plain foreground wait would defer a
# `kill` for up to --interval (300 s by default). `wait` is interruptible.
WAIT_CHILD=''
EVENTS_FILE=''
WAIT_ERR=''
LAST_WARN=''
# One warning per failure streak, then a fixed pause: a wait that cannot scan the
# fleet (an unusable fleet directory, for example) will not recover by polling
# faster, and the supervisor must stay alive instead of burning a core.
WARNED=0
BACKOFF=2
stop_waiter() {
  [ -z "$WAIT_CHILD" ] || kill "$WAIT_CHILD" 2>/dev/null || true
  exit 0
}
trap stop_waiter INT TERM

while true; do
  watch_pass_begin
  EVENTS_FILE=$(mktemp "$KP_HOME/watch-events.XXXXXX")
  WAIT_ERR=$(mktemp "$KP_HOME/watch-wait-err.XXXXXX")
  "$KP_BIN/kingpin-wait" --timeout "$INTERVAL" >"$EVENTS_FILE" 2>"$WAIT_ERR" &
  WAIT_CHILD=$!
  wait_rc=0
  wait "$WAIT_CHILD" || wait_rc=$?
  WAIT_CHILD=''
  updates=$(cat "$EVENTS_FILE" 2>/dev/null || true)
  wait_warn=$(head -n 1 "$WAIT_ERR" 2>/dev/null || true)
  if [ "$wait_rc" -ne 0 ]; then
    # kingpin-wait exits 0 on a quiet fleet and prints a reason on stderr when the
    # scan itself failed. Warn once per streak, then back off.
    if [ "$WARNED" -eq 0 ]; then
      [ -n "$wait_warn" ] || wait_warn='(no message)'
      echo "[kingpin-watch] kingpin-wait failed (exit $wait_rc): $wait_warn; retrying every ${BACKOFF} s" >&2
      WARNED=1
    fi
    LAST_WARN=''
    rm -f "$EVENTS_FILE" "$WAIT_ERR"
    EVENTS_FILE=''
    WAIT_ERR=''
    sleep "$BACKOFF"
    continue
  fi
  WARNED=0
  # A healthy pass can still warn about a task it could not judge (an unreadable
  # mtime, an unparseable CREATED) or about a tmux server that is not running, and a
  # pass can carry more than one line. Log each distinct line once per streak so it
  # reaches the fleet log, not only the terminal of a manual `kingpin wait`, and so a
  # second warning is not hidden behind the first.
  PASS_WARNED=0
  while IFS= read -r wait_warn; do
    [ -n "$wait_warn" ] || continue
    PASS_WARNED=1
    case " $LAST_WARN " in *" $wait_warn "*) continue ;; esac
    echo "[kingpin-watch] kingpin-wait warning: $wait_warn" >&2
    LAST_WARN="${LAST_WARN:+$LAST_WARN }$wait_warn"
  done < "$WAIT_ERR"
  # A pass whose stderr held no line ends the streak, so a fault that clears and
  # returns hours later reaches the log again instead of staying silent for the rest
  # of the supervisor's life (issue #165 review L2).
  [ "$PASS_WARNED" -eq 1 ] || LAST_WARN=''
  rm -f "$EVENTS_FILE" "$WAIT_ERR"
  EVENTS_FILE=''
  WAIT_ERR=''
  # One sweep at a time (issue #209): a --once pass from kingpin run can hold this
  # lock; when it does, watch_sweep names the holder and this pass skips dispatch
  # and maintenance, and the un-acked line is raised again on the next wait.
  watch_sweep "$updates"
done
