#!/usr/bin/env bash
# Acknowledge task events across the kingpin fleet.
#
# Advances seen status line counts, seen_stopped timestamps, records the pane
# activity time (seen_activity), and sets seen_exited for specified task IDs or all tasks (--all).
#
# Usage: kingpin-ack <task-id>... | --all
set -euo pipefail

KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
# shellcheck source=../lib/status.sh
. "$(dirname "$0")/../lib/status.sh"
tasks_dir="$KP_HOME/tasks"

ALL=0
TARGETS=()

while [ $# -gt 0 ]; do
  case $1 in
    --all)
      ALL=1
      shift
      ;;
    -h|--help)
      echo "usage: kingpin-ack <task-id>... | --all"
      exit 0
      ;;
    -*)
      echo "kingpin-ack: unknown argument $1" >&2
      exit 2
      ;;
    *)
      TARGETS+=("$1")
      shift
      ;;
  esac
done

if [ "$ALL" -eq 0 ] && [ ${#TARGETS[@]} -eq 0 ]; then
  echo "usage: kingpin-ack <task-id>... | --all" >&2
  exit 2
fi

ack_task() {
  local task_dir=$1
  local id
  id=$(basename "$task_dir")
  local task_env="$task_dir/task.env"
  local status_file="$task_dir/status"
  local stopped_file="$task_dir/stopped"

  # 1. If status exists, count lines and write to seen
  if [ -f "$status_file" ]; then
    wc -l < "$status_file" | tr -d ' ' > "$task_dir/seen"
  fi

  # 2. If stopped exists, read timestamp and write to seen_stopped
  if [ -f "$stopped_file" ]; then
    cat "$stopped_file" 2>/dev/null | tr -d ' ' > "$task_dir/seen_stopped"
  fi

  # 3. If tmux window is no longer alive, touch seen_exited
  local tmux_target=""
  if [ -f "$task_env" ]; then
    tmux_target=$(kp_env_get "$task_env" TMUX_TARGET)
  fi
  [ -n "$tmux_target" ] || tmux_target="kingpin:$id"
  # The window ID survives rename and move; older task.env files lack it.
  local window_id=""
  if [ -f "$task_env" ]; then
    window_id=$(kp_env_get "$task_env" TMUX_WINDOW_ID)
  fi
  [ -n "$window_id" ] && tmux_target=$window_id

  if ! tmux list-panes -t "$tmux_target" >/dev/null 2>&1; then
    touch "$task_dir/seen_exited"
  else
    # 4. Remember the pane activity time: kingpin-wait holds a repeated `quiet`
    # for an acknowledged needs-input until it changes.
    tmux display-message -p -t "$tmux_target" '#{window_activity}' > "$task_dir/seen_activity" 2>/dev/null || rm -f "$task_dir/seen_activity"
  fi
}

if [ "$ALL" -eq 1 ]; then
  if [ -d "$tasks_dir" ]; then
    for dir in "$tasks_dir"/*; do
      [ -d "$dir" ] || continue
      ack_task "$dir"
    done
  fi
else
  for id in "${TARGETS[@]}"; do
    task_dir="$tasks_dir/$id"
    if [ ! -d "$task_dir" ] && [ -d "$KP_HOME/archive/$id" ]; then
      # kingpin-done archives the task: there is nothing left to acknowledge.
      echo "kingpin-ack: task $id is already archived; nothing to acknowledge"
      continue
    fi
    if [ ! -d "$task_dir" ]; then
      echo "kingpin-ack: task $id not found: $task_dir" >&2
      exit 1
    fi
    ack_task "$task_dir"
  done
fi
