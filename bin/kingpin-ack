#!/usr/bin/env bash
# Acknowledge task events across the kingpin fleet.
#
# Advances seen status line counts, seen_stopped timestamps, records the pane
# activity time (seen_activity), and sets seen_exited for specified task IDs or all tasks (--all).
#
# `--through <line>` moves `seen` to that line instead of the whole file. It is for
# a caller that dispatches a batch one line at a time (kingpin-watch): lines
# appended while the batch runs stay pending, and a restart resumes at the first
# undispatched line. The cursor never moves backwards, and it is clamped to the
# file's line count.
#
# Usage: kingpin-ack [--through <line>] <task-id>... | --all
set -euo pipefail

KP_HOME=${KINGPIN_HOME:-$HOME/.kingpin}
# shellcheck source=../lib/status.sh
. "$(dirname "$0")/../lib/status.sh"
# shellcheck source=../lib/mux.sh
. "$(dirname "$0")/../lib/mux.sh"
tasks_dir="$KP_HOME/tasks"

ALL=0
THROUGH=''
TARGETS=()

while [ $# -gt 0 ]; do
  case $1 in
    --all)
      ALL=1
      shift
      ;;
    --through)
      THROUGH=${2:-}
      case $THROUGH in
        ''|*[!0-9]*) echo "kingpin-ack: --through needs a whole line number" >&2; exit 2 ;;
      esac
      shift 2
      ;;
    -h|--help)
      echo "usage: kingpin-ack [--through <line>] <task-id>... | --all"
      exit 0
      ;;
    -*)
      echo "kingpin-ack: unknown argument $1" >&2
      exit 2
      ;;
    *)
      TARGETS+=("$1")
      shift
      ;;
  esac
done

if [ "$ALL" -eq 1 ] && [ -n "$THROUGH" ]; then
  echo "kingpin-ack: --through names one task's cursor; it cannot be combined with --all" >&2
  exit 2
fi

if [ "$ALL" -eq 0 ] && [ ${#TARGETS[@]} -eq 0 ]; then
  echo "usage: kingpin-ack [--through <line>] <task-id>... | --all" >&2
  exit 2
fi

ack_task() {
  local task_dir=$1
  local id
  id=$(basename "$task_dir")
  local status_file="$task_dir/status"
  local stopped_file="$task_dir/stopped"

  # 1. If status exists, count lines and write to seen. With --through, advance to
  # the line the caller just handled instead, so a later append stays pending.
  if [ -f "$status_file" ]; then
    if [ -n "$THROUGH" ]; then
      local current=0 lines target
      [ -f "$task_dir/seen" ] && current=$(tr -d ' \n' < "$task_dir/seen" 2>/dev/null || true)
      case $current in ''|*[!0-9]*) current=0 ;; esac
      lines=$(wc -l < "$status_file" | tr -d ' ')
      target=$THROUGH
      if [ "$target" -gt "$lines" ]; then target=$lines; fi
      if [ "$target" -lt "$current" ]; then target=$current; fi
      printf '%s\n' "$target" > "$task_dir/seen"
    else
      wc -l < "$status_file" | tr -d ' ' > "$task_dir/seen"
    fi
  fi

  # 2. If stopped exists, read timestamp and write to seen_stopped
  if [ -f "$stopped_file" ]; then
    cat "$stopped_file" 2>/dev/null | tr -d ' ' > "$task_dir/seen_stopped"
  fi

  # 3. If no terminal of this task is alive, touch seen_exited. The resolver
  # (lib/mux.sh) looks for the task's own terminal, from the mux its record names
  # (issue #144): a tmux window by its own name first, on the socket the record
  # names (issue #142), so a stale recorded id that now names a foreign window no
  # longer counts as this task being alive; a Herdr pane by its label first.
  if kp_mux_find "$task_dir" >/dev/null 2>&1; then
    # 4. Remember the pane activity token: kingpin-wait holds a repeated `quiet`
    # for an acknowledged needs-input until it changes.
    kp_mux_activity "$KP_WINDOW_ID" > "$task_dir/seen_activity" 2>/dev/null || rm -f "$task_dir/seen_activity"
  else
    touch "$task_dir/seen_exited"
  fi
}

if [ "$ALL" -eq 1 ]; then
  if [ -d "$tasks_dir" ]; then
    for dir in "$tasks_dir"/*; do
      kp_task_is_live "$dir" || continue
      ack_task "$dir"
    done
  fi
else
  for id in "${TARGETS[@]}"; do
    task_dir="$tasks_dir/$id"
    if kp_task_archive_dir "$KP_HOME" "$id" >/dev/null; then
      # kingpin-done archives the task and leaves its link at this path: there is
      # nothing left to acknowledge, and the archive is the record, so no cursor
      # is written into it (issue #115).
      echo "kingpin-ack: task $id is already archived; nothing to acknowledge"
      continue
    fi
    if [ ! -d "$task_dir" ]; then
      echo "kingpin-ack: task $id not found: $task_dir" >&2
      exit 1
    fi
    ack_task "$task_dir"
  done
fi
