#!/usr/bin/env python3
"""Render the kingpin fleet board HTML from task directories.

Usage: kingpin-board [--out <path>]
Defaults to $KINGPIN_HOME/board.html.
"""

import os
import sys
import html
import subprocess
from pathlib import Path
from datetime import datetime

KP_HOME = Path(os.environ.get("KINGPIN_HOME", Path.home() / ".kingpin"))
TASKS_DIR = KP_HOME / "tasks"


def parse_task_env(path: Path) -> dict:
    env = {}
    if not path.is_file():
        return env
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        env[k.strip()] = v.strip().strip("'\"")
    return env


def is_window_alive(tmux_target: str) -> bool:
    if not tmux_target:
        return False
    res = subprocess.run(
        ["tmux", "list-panes", "-t", tmux_target],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return res.returncode == 0


def capture_pane_tail(tmux_target: str, lines: int = 15) -> str:
    if not tmux_target:
        return ""
    res = subprocess.run(
        ["tmux", "capture-pane", "-pt", tmux_target, "-S", f"-{lines}"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    return res.stdout.strip() if res.returncode == 0 else ""


def derive_task_state(task_dir: Path, task_env: dict, status_lines: list) -> tuple:
    tmux_target = task_env.get("TMUX_TARGET", f"kingpin:{task_dir.name}")
    alive = is_window_alive(tmux_target)
    last_line = status_lines[-1] if status_lines else ""

    if last_line.startswith("merged:"):
        return "merged", "PR merged"
    if last_line.startswith("failed:"):
        return "failed", last_line[len("failed:"):].strip()
    if last_line.startswith("ready:"):
        return "ready", "Review complete, ready to land"
    if not alive and not last_line:
        return "failed", "Window closed before startup"
    if not alive:
        return "failed", "Window closed unexpectedly without completion"

    if last_line.startswith("needs-input:"):
        return "needs-input", last_line[len("needs-input:"):].strip()
    if last_line.startswith("issue:"):
        # Check stopped qualifier
        stopped_file = task_dir / "stopped"
        if stopped_file.is_file():
            pane = capture_pane_tail(tmux_target, 25)
            if "Waiting for" not in pane and "background agent" not in pane.lower():
                return "quiet", "Stopped without reporting"
        return "running", "In progress"

    if not last_line:
        return "drafting", "Drafting issue"

    return "running", last_line


def load_tasks() -> list:
    tasks = []
    if not TASKS_DIR.is_dir():
        return tasks

    for entry in sorted(TASKS_DIR.iterdir()):
        if not entry.is_dir():
            continue
        env = parse_task_env(entry / "task.env")
        task_id = env.get("TASK_ID", entry.name)
        brief = ""
        brief_file = entry / "brief.md"
        if brief_file.is_file():
            brief = brief_file.read_text(encoding="utf-8", errors="replace").strip()

        status_file = entry / "status"
        status_lines = []
        if status_file.is_file():
            status_lines = [
                line.strip()
                for line in status_file.read_text(encoding="utf-8", errors="replace").splitlines()
                if line.strip()
            ]

        state, state_desc = derive_task_state(entry, env, status_lines)

        question = ""
        question_file = entry / "question.md"
        if question_file.is_file():
            question = question_file.read_text(encoding="utf-8", errors="replace").strip()

        report_exists = (entry / "report.html").is_file()
        tmux_target = env.get("TMUX_TARGET", f"kingpin:{task_id}")
        pane_preview = capture_pane_tail(tmux_target, 12) if state in ("quiet", "failed", "running") else ""

        tasks.append({
            "id": task_id,
            "dir": entry,
            "env": env,
            "brief": brief,
            "status_lines": status_lines,
            "state": state,
            "state_desc": state_desc,
            "question": question,
            "report_exists": report_exists,
            "pane_preview": pane_preview,
            "tmux_target": tmux_target,
        })
    return tasks


STATE_BADGES = {
    "drafting": "badge-neutral",
    "needs-input": "badge-warning",
    "running": "badge-primary",
    "quiet": "badge-warning",
    "ready": "badge-success",
    "fixing": "badge-secondary",
    "queued to land": "badge-info",
    "landing": "badge-primary",
    "merged": "badge-success",
    "failed": "badge-error",
}


def render_html(tasks: list) -> str:
    now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    total = len(tasks)
    ready_count = sum(1 for t in tasks if t["state"] == "ready")
    input_count = sum(1 for t in tasks if t["state"] == "needs-input")
    running_count = sum(1 for t in tasks if t["state"] in ("running", "drafting", "quiet"))

    cards_html = []
    for t in tasks:
        tid = html.escape(t["id"])
        project = html.escape(t["env"].get("PROJECT", "unknown"))
        mode = html.escape(t["env"].get("MODE", "review"))
        branch = html.escape(t["env"].get("BRANCH", f"kingpin/{t['id']}"))
        state = t["state"]
        badge_cls = STATE_BADGES.get(state, "badge-neutral")
        state_desc = html.escape(t["state_desc"])
        brief = html.escape(t["brief"])

        # Links
        links = []
        if t["report_exists"]:
            links.append(f'<a href="tasks/{tid}/report.html" class="link link-primary" target="_blank">Review Report</a>')
        issue_no = t["env"].get("ISSUE")
        if issue_no:
            links.append(f'<span class="text-xs opacity-75">Issue #{html.escape(issue_no)}</span>')

        # Action buttons
        actions_html = ""
        if state == "ready":
            actions_html = f'''
            <div class="card-actions justify-end mt-4 pt-3 border-t border-base-300">
              <button class="btn btn-sm btn-success" onclick="if(window.lavish){{window.lavish.queuePrompt('land {tid}', {{tag:'action',text:'Land {tid}'}})}}">Land</button>
              <button class="btn btn-sm btn-outline" onclick="const n=prompt('Notes for changes:');if(n&&window.lavish){{window.lavish.queuePrompt('request-changes {tid} '+n, {{tag:'action',text:'Request changes: {tid}'}})}}">Request changes</button>
              <button class="btn btn-sm btn-ghost text-error" onclick="if(confirm('Drop {tid}?')&&window.lavish){{window.lavish.queuePrompt('drop {tid}', {{tag:'action',text:'Drop {tid}'}})}}">Drop</button>
            </div>'''
        elif state == "needs-input":
            q_text = html.escape(t["question"] or t["state_desc"])
            actions_html = f'''
            <div class="mt-4 pt-3 border-t border-base-300 space-y-2">
              <div class="p-3 bg-base-300 rounded text-xs font-mono whitespace-pre-wrap max-h-40 overflow-y-auto">{q_text}</div>
              <form onsubmit="event.preventDefault(); const a=this.elements.ans.value; if(window.lavish){{window.lavish.queuePrompt('answer {tid} '+a, {{tag:'answer',text:'Answer for {tid}'}})}}">
                <textarea name="ans" rows="2" class="textarea textarea-bordered textarea-sm w-full" placeholder="Your response or approval..."></textarea>
                <div class="flex justify-end gap-2 mt-2">
                  <button type="submit" class="btn btn-sm btn-primary">Submit Answer</button>
                </div>
              </form>
            </div>'''
        elif state == "failed":
            actions_html = f'''
            <div class="card-actions justify-end mt-4 pt-3 border-t border-base-300">
              <button class="btn btn-sm btn-outline" onclick="if(window.lavish){{window.lavish.queuePrompt('retry {tid}', {{tag:'action',text:'Retry {tid}'}})}}">Retry</button>
              <button class="btn btn-sm btn-ghost text-error" onclick="if(window.lavish){{window.lavish.queuePrompt('drop {tid}', {{tag:'action',text:'Drop {tid}'}})}}">Drop</button>
            </div>'''

        pane_html = ""
        if t["pane_preview"]:
            pane_esc = html.escape(t["pane_preview"])
            pane_html = f'''
            <details class="collapse collapse-arrow bg-base-300 mt-3 text-xs">
              <summary class="collapse-title py-1 text-xs font-semibold opacity-75">Terminal tail ({html.escape(t["tmux_target"])})</summary>
              <div class="collapse-content"><pre class="p-2 font-mono overflow-x-auto text-xs">{pane_esc}</pre></div>
            </details>'''

        cards_html.append(f'''
        <div class="card bg-base-200 border border-base-300 shadow-md">
          <div class="card-body p-5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="card-title text-base font-bold font-mono">{tid}</h3>
              <div class="flex items-center gap-1">
                <span class="badge badge-sm badge-outline">{mode}</span>
                <span class="badge badge-sm {badge_cls}">{html.escape(state)}</span>
              </div>
            </div>
            <div class="text-xs text-base-content/70">Project: <b>{project}</b> · Branch: <code>{branch}</code></div>
            <p class="text-sm mt-2 opacity-90 line-clamp-2">{brief}</p>
            <div class="mt-2 text-xs font-semibold text-primary">{state_desc}</div>
            {" · ".join(links)}
            {pane_html}
            {actions_html}
          </div>
        </div>''')

    cards_grid = "\n".join(cards_html) if cards_html else '<div class="text-center py-12 opacity-60">No tasks in fleet</div>'

    return f'''<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kingpin Fleet Board</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5.5.19/daisyui.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5.5.19/themes.css">
<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.2.4/dist/index.global.js"></script>
<style>
  :root {{ color-scheme: dark; --bg:#0d1117; --fg:#e6edf3; }}
  body {{ background: var(--bg); color: var(--fg); font-family: ui-sans-serif, system-ui, -apple-system, sans-serif; }}
</style>
</head>
<body class="p-6 max-w-6xl mx-auto space-y-6">

<header class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-base-300">
  <div>
    <h1 class="text-2xl font-bold tracking-tight">Kingpin Fleet Board</h1>
    <p class="text-xs text-base-content/60">Parallel worktree workers · Last refreshed {now_str}</p>
  </div>
  <div class="flex gap-2">
    <div class="stat py-1 px-3 bg-base-200 rounded-lg text-center border border-base-300"><div class="stat-title text-xs">Total</div><div class="stat-value text-lg">{total}</div></div>
    <div class="stat py-1 px-3 bg-base-200 rounded-lg text-center border border-base-300"><div class="stat-title text-xs">Active</div><div class="stat-value text-lg text-primary">{running_count}</div></div>
    <div class="stat py-1 px-3 bg-base-200 rounded-lg text-center border border-base-300"><div class="stat-title text-xs">Needs input</div><div class="stat-value text-lg text-warning">{input_count}</div></div>
    <div class="stat py-1 px-3 bg-base-200 rounded-lg text-center border border-base-300"><div class="stat-title text-xs">Ready</div><div class="stat-value text-lg text-success">{ready_count}</div></div>
  </div>
</header>

<main class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
{cards_grid}
</main>

</body>
</html>'''


def main():
    out_path = KP_HOME / "board.html"
    if "--out" in sys.argv:
        idx = sys.argv.index("--out")
        if idx + 1 < len(sys.argv):
            out_path = Path(sys.argv[idx + 1])

    tasks = load_tasks()
    html_content = render_html(tasks)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(html_content, encoding="utf-8")
    print(f"OK: rendered {len(tasks)} task(s) to {out_path}")


if __name__ == "__main__":
    main()
