#!/usr/bin/env bash
# Name the instruction files a harness loads into a spawned worker's context, and
# refuse a worktree whose instruction files carry the orchestrator contract.
#
# A worker's context is assembled by the harness from files the worker never chose:
# the repository's AGENTS.md, a harness's own config, the global config directory.
# A rule that matters has to be a file the harness really loads (issue #96: two of
# the harnesses silently ignored the preamble file the spawn pointed at), and the
# orchestrator contract must not be one of those files.
#
# Usage: kingpin-scope files --harness <claude|agy|opencode|pi|codex> --worktree <dir>
#        kingpin-scope check --harness <claude|agy|opencode|pi|codex> --worktree <dir> --preamble <file>
#        kingpin-scope doctor --harness pi [--worktree <dir>] [--provider <name>] [--model <id>]
#        kingpin-scope doctor --harness codex [--worktree <dir>]
#
# `files` prints one "<kind>\t<path>" line per source that exists:
#   discovery   the harness loads it by discovery (AGENTS.md, CLAUDE.md, rules/)
#   configured  an `instructions` entry of the worktree's harness config
#   ignored     a rules file the harness skips (agy without a trigger frontmatter)
#   global      loaded in every session from the user's config directory
#
# `check` exits 1 and names the file when a source carries an orchestrator-contract
# marker, including a *global* file in the user's own config directory: Kingpin cannot
# edit that file, so the spawn refuses rather than launch a worker that may wake up as
# the orchestrator (KINGPIN_ALLOW_GLOBAL_CONTRACT=1 downgrades that hit to a warning).
# It also exits 1 when the preamble is not among the sources the harness actually
# loads; for Claude Code it arrives through --append-system-prompt-file, so it is
# never a discovered source and is not checked. `check` never edits anything.
#
# `doctor` is the readiness view of a harness that has one, pi or codex: the binary, its
# credential state and the skills directory (pi also reports its extension) in one
# command, then the same source list `files` prints. For pi it reads `--provider`/`--model`,
# or `PI_PROVIDER`/`PI_MODEL` when the flag is absent, and runs
# `pi auth check --no-refresh --json`, so it is local and offline. With no provider named
# it reports whether the Pi agent directory holds credentials in `auth.json` (default
# `$HOME/.pi/agent`, override `PI_CODING_AGENT_DIR`), so a host with no login reads
# differently from a logged-in one. The codex probe reads `codex login status` and the
# config store instead, so it takes no provider or model. Exit 0 when the binary,
# credentials and extension are usable (or the credential state is unverified because no
# provider was named), 1 when the binary or extension is missing or the credentials
# report not_ready.
set -euo pipefail

KP_ROOT=$(cd "$(dirname "$0")/.." && pwd)

# The sentences that make a file the orchestrator contract. Each one is a marker
# that must never reach a worker; `orchestrator/contract.md` carries the first.
MARKERS=(
  'kingpin orchestrator contract'
  'You are the underboss'
  'The user is the boss'
  'Never edit, write, or touch project code directly'
)

die() { echo "kingpin-scope: $*" >&2; exit 2; }

cmd='' harness='' worktree='' preamble='' provider='' model=''
while [ $# -gt 0 ]; do
  case $1 in
    files|check|doctor) cmd=$1; shift ;;
    --harness) harness=${2:?--harness needs a value}; shift 2 ;;
    --worktree) worktree=${2:?--worktree needs a directory}; shift 2 ;;
    --preamble) preamble=${2:?--preamble needs a file}; shift 2 ;;
    --provider) provider=${2:?--provider needs a value}; shift 2 ;;
    --model) model=${2:?--model needs a value}; shift 2 ;;
    -h|--help)
      echo "usage: kingpin-scope files|check --harness <claude|agy|opencode|pi|codex> --worktree <dir> [--preamble <file>]"
      echo "       kingpin-scope doctor --harness pi [--worktree <dir>] [--provider <name>] [--model <id>]"
      echo "       kingpin-scope doctor --harness codex [--worktree <dir>]"
      exit 0
      ;;
    *) die "unknown argument: $1" ;;
  esac
done

# No subcommand but a harness or a provider flag reads as doctor, so the issue #93
# criterion `kingpin scope --harness pi` reports readiness too.
if [ -z "$cmd" ]; then
  [ -n "$harness$provider$model" ] || die "give files, check, or doctor"
  cmd=doctor
fi
case $harness in claude|agy|opencode|pi|codex) ;; *) die "--harness must be claude, agy, opencode, pi, or codex" ;; esac
case $cmd in
  doctor)
    case $harness in
      pi|codex) ;;
      *) die "doctor supports --harness pi or codex (the other harnesses have no readiness probe)" ;;
    esac
    # The codex probe reads the binary's own login status and its config store, so a
    # provider or model flag would look like it tuned the check while doing nothing
    # (issue #106 review, L2).
    [ "$harness" != codex ] || [ -z "$provider$model" ] \
      || die "--provider and --model belong to --harness pi (the codex probe reads codex login status and needs neither)"
    ;;
  *) [ -z "$provider$model" ] || die "--provider and --model belong to doctor" ;;
esac
# doctor defaults to the current directory; files and check need an explicit one.
if [ -z "$worktree" ] && [ "$cmd" = doctor ]; then worktree=$PWD; fi
[ -n "$worktree" ] || die "--worktree is required"
[ -d "$worktree" ] || die "worktree does not exist: $worktree"
worktree=$(cd "$worktree" && pwd -P)
[ "$cmd" != check ] || [ -n "$preamble" ] || die "check needs --preamble <file>"

emit() {
  local kind=$1 path=$2
  if [ -f "$path" ]; then printf '%s\t%s\n' "$kind" "$path"; fi
  return 0
}

# The `instructions` entries of one OpenCode config document, resolved the way the
# harness resolves them. OpenCode accepts JSONC (comments and trailing commas) in a
# project config, so the text is parsed as JSON after comments are stripped; a
# document that still does not parse prints a note on stderr and contributes nothing.
opencode_instructions() {
  # shellcheck disable=SC2016 # single quotes are intentional: the program runs in node
  node -e '
    const fs = require("fs");
    const [file, root] = [process.argv[1], process.argv[2]];
    const home = process.env.HOME || "";
    // JSONC: drop // and /* */ comments outside strings, plus a trailing comma.
    const strip = (s) => {
      let out = "", i = 0, quote = null, commaAt = -1;
      while (i < s.length) {
        const c = s[i], n = s[i + 1];
        if (quote) {
          out += c;
          if (c === "\\") { out += n === undefined ? "" : n; i += 2; continue; }
          if (c === quote) quote = null;
          i++;
          continue;
        }
        if (c === "\"") { quote = c; commaAt = -1; out += c; i++; continue; }
        if (c === "/" && n === "/") { while (i < s.length && s[i] !== "\n") i++; continue; }
        if (c === "/" && n === "*") {
          i += 2;
          while (i < s.length && !(s[i] === "*" && s[i + 1] === "/")) i++;
          i += 2;
          continue;
        }
        if (c === ",") { commaAt = out.length; out += c; i++; continue; }
        if (c === "]" || c === "}") {
          // A comma that is followed only by whitespace and comments is dropped.
          if (commaAt >= 0) out = out.slice(0, commaAt) + out.slice(commaAt + 1);
          commaAt = -1;
          out += c;
          i++;
          continue;
        }
        if (!/\s/.test(c)) commaAt = -1;
        out += c;
        i++;
      }
      return out;
    };
    let cfg;
    try {
      cfg = JSON.parse(fs.readFileSync(file, "utf8"));
    } catch (e) {
      try { cfg = JSON.parse(strip(fs.readFileSync(file, "utf8"))); }
      catch (e2) { console.error(`kingpin-scope: cannot parse ${file}: ${e2.message}`); process.exit(0); }
    }
    const list = (cfg && cfg.instructions) || [];
    for (const entry of list) {
      if (typeof entry !== "string" || /^https?:\/\//.test(entry)) continue;
      const p = entry.startsWith("~/") ? home + entry.slice(1)
        : entry.startsWith("/") ? entry : root + "/" + entry;
      console.log(p);
    }
  ' "$1" "$2" || true
}

scope_files() {
  local f d kind
  case $harness in
    claude)
      # Claude Code loads the workspace CLAUDE.md (and whatever it imports, which is
      # how AGENTS.md arrives here), .claude/CLAUDE.md, every nested CLAUDE.md, every
      # .claude/rules/*.md of the workspace, and the CLAUDE.md of each ancestor
      # directory up to the home directory (its help text: "in the project,
      # including nested directories").
      emit discovery "$worktree/CLAUDE.md"
      emit discovery "$worktree/AGENTS.md"
      while IFS= read -r f; do
        [ "$f" = "$worktree/CLAUDE.md" ] || emit discovery "$f"
      done < <(find "$worktree" -name CLAUDE.md -type f -not -path '*/.git/*' -print 2>/dev/null || true)
      d=$worktree
      while case $d in "$HOME"/*) true ;; *) false ;; esac; do
        d=$(dirname "$d")
        emit discovery "$d/CLAUDE.md"
      done
      for f in "$worktree"/.claude/rules/*.md; do emit discovery "$f"; done
      local claude_dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
      emit global "$claude_dir/CLAUDE.md"
      for f in "$claude_dir"/rules/*.md; do emit global "$f"; done
      ;;
    agy)
      # agy loads the workspace AGENTS.md/GEMINI.md, and a file under .agents/rules/
      # only when it is named AGENTS.md/GEMINI.md or carries a trigger frontmatter.
      emit discovery "$worktree/AGENTS.md"
      emit discovery "$worktree/GEMINI.md"
      for f in "$worktree"/.agents/rules/*.md; do
        [ -f "$f" ] || continue
        case $(basename "$f") in
          AGENTS.md|GEMINI.md) emit discovery "$f" ;;
          *)
            if head -n 5 "$f" | grep -qE '^trigger:[[:space:]]*(always_on|model_decision|manual|glob)[[:space:]]*$'; then
              emit discovery "$f"
            else
              emit ignored "$f"
            fi
            ;;
        esac
      done
      local gemini_dir=${GEMINI_CONFIG_DIR:-$HOME/.gemini}
      emit global "$gemini_dir/AGENTS.md"
      emit global "$gemini_dir/GEMINI.md"
      ;;
    opencode)
      # OpenCode loads every AGENTS.md from the workspace up to the home directory.
      emit discovery "$worktree/AGENTS.md"
      d=$worktree
      while case $d in "$HOME"/*) true ;; *) false ;; esac; do
        d=$(dirname "$d")
        emit discovery "$d/AGENTS.md"
      done
      for f in "$worktree/opencode.json" "$worktree/opencode.jsonc" \
               "$worktree/.opencode/opencode.json" "$worktree/.opencode/opencode.jsonc"; do
        [ -f "$f" ] || continue
        while IFS= read -r d; do [ -n "$d" ] && emit configured "$d"; done < <(opencode_instructions "$f" "$worktree")
      done
      local oc_dir=${XDG_CONFIG_HOME:-$HOME/.config}/opencode
      emit global "$oc_dir/AGENTS.md"
      for f in "$oc_dir/opencode.json" "$oc_dir/opencode.jsonc"; do
        [ -f "$f" ] || continue
        while IFS= read -r d; do [ -n "$d" ] && emit global "$d"; done < <(opencode_instructions "$f" "$oc_dir")
      done
      ;;
    pi)
      # Pi loads AGENTS.override.md, AGENTS.md, AGENTS.MD, CLAUDE.md and CLAUDE.MD
      # from the working directory and each ancestor, without trust, and applies a
      # directory's file to every directory below it (Pi docs, configuration.md).
      # Walking the parents covers that downward rule without a nested `find`.
      for f in AGENTS.override.md AGENTS.md AGENTS.MD CLAUDE.md CLAUDE.MD; do
        emit discovery "$worktree/$f"
      done
      d=$worktree
      while case $d in "$HOME"/*) true ;; *) false ;; esac; do
        d=$(dirname "$d")
        for f in AGENTS.override.md AGENTS.md AGENTS.MD CLAUDE.md CLAUDE.MD; do
          emit discovery "$d/$f"
        done
      done
      # The project's .pi/ config: SYSTEM.md replaces the system prompt and
      # APPEND_SYSTEM.md adds to it (Pi docs, configuration.md).
      emit configured "$worktree/.pi/SYSTEM.md"
      emit configured "$worktree/.pi/APPEND_SYSTEM.md"
      local pi_dir=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}
      for f in AGENTS.override.md AGENTS.md AGENTS.MD CLAUDE.md CLAUDE.MD SYSTEM.md APPEND_SYSTEM.md; do
        emit global "$pi_dir/$f"
      done
      # Pi also loads every skill it discovers, and a skill's name and description
      # reach the system prompt before the model asks for it (issue #93 review, H3).
      # The project's own skill dirs are trust-protected resources, so a contract in
      # one would arrive through the extension's automatic trust answer: walk them as
      # `configured`. The user-level dirs Pi scans go as `global`, because a leak there
      # is the operator's own file: the bridged skills directory, the Agent Skills
      # directory `~/.agents/skills/`, and `<agent-dir>/skills/` (Pi docs, skills.md
      # and configuration.md). All of them are walked recursively, the way Pi finds a
      # SKILL.md.
      local skills_root=${KINGPIN_SKILLS_DIR:-$HOME/.claude/skills}
      for d in "$worktree/.agents/skills" "$worktree/.pi/skills"; do
        [ -d "$d" ] || continue
        while IFS= read -r f; do emit configured "$f"; done \
          < <(find "$d" -name SKILL.md -type f -print 2>/dev/null || true)
      done
      for d in "$skills_root" "$HOME/.agents/skills" "$pi_dir/skills"; do
        [ -d "$d" ] || continue
        while IFS= read -r f; do emit global "$f"; done \
          < <(find "$d" -name SKILL.md -type f -print 2>/dev/null || true)
      done
      ;;
    codex)
      # Codex reads `AGENTS.override.md` ahead of `AGENTS.md` in the worktree (the
      # installed binary's agents_md.rs names that precedence), so both are discovery
      # sources: a contract in the override file would otherwise ride in unseen (issue
      # #106 review, H2).
      emit discovery "$worktree/AGENTS.override.md"
      emit discovery "$worktree/AGENTS.md"
      # Every skill Codex discovers is listed to the model by name and description
      # before it is asked for. Kingpin's own links under .codex/skills are what makes
      # `$<skill>` expand, so they are walked as `configured`, and the project's own
      # skills sit at the same path.
      for f in "$worktree"/.codex/skills/*/SKILL.md; do emit configured "$f"; done
      local codex_dir=${CODEX_HOME:-$HOME/.codex}
      # The global instruction chain Codex loads in every session: the same pair under its
      # config directory, and its hook program (Codex hashes `hooks.json`, so a contract
      # there runs as part of every session). config.toml follows: it can carry
      # developer_instructions or its own model_instructions_file.
      for f in AGENTS.override.md AGENTS.md hooks.json; do emit global "$codex_dir/$f"; done
      # The user-level skills directory.
      for f in "$codex_dir"/skills/*/SKILL.md; do emit global "$f"; done
      emit global "$codex_dir/config.toml"
      ;;
  esac
}

# auth_json_has_credentials <file>
# True when the Pi agent directory's auth.json holds at least one credential entry.
# Pi writes an empty object before the first login, so a non-empty file alone would
# call a logged-out host logged in. An unreadable or unparseable file reads as none.
auth_json_has_credentials() {
  local file=${1:-}
  [ -s "$file" ] || return 1
  # shellcheck disable=SC2016 # single quotes are intentional: the program runs in node
  node -e '
    const fs = require("fs");
    let o = {};
    try { o = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); } catch { process.exit(1); }
    process.exit(o && typeof o === "object" && Object.keys(o).length > 0 ? 0 : 1);
  ' "$file" 2>/dev/null
}

# The Codex readiness view: the binary, the credential state `codex login status`
# reports, the config store and the skills directory. Exit 1 only for a missing
# binary: a logged-out host is `unverified`, because a provider configured through
# env keys or a custom provider is invisible to `login status` (issue #106, the
# "Readiness check" comment). The exit status is the contract, never the wording.
doctor_codex() {
  local bin=${KINGPIN_CODEX:-codex} bin_path='' rc=0 login_rc=0 line='' cfg='' n=0 skills=''
  bin_path=$(command -v "$bin" 2>/dev/null || true)
  if [ -n "$bin_path" ]; then
    printf 'codex: %s\n' "$bin_path"
  else
    printf 'codex: MISSING (%s is not on PATH)\n' "$bin"
    rc=1
  fi

  if [ -z "$bin_path" ]; then
    printf 'credentials: unverified (%s is missing)\n' "$bin"
  else
    # `codex login status` prints one line and sets the exit status; both are kept as
    # they are, so a host that is logged out reads differently from one that is not
    # without Kingpin parsing the wording.
    line=$("$bin_path" login status 2>&1) || login_rc=$?
    line=${line%%$'\n'*}
    if [ "$login_rc" -eq 0 ]; then
      printf 'credentials: ready (codex login status: %s)\n' "${line:-no output}"
    else
      printf 'credentials: unverified (codex login status exited %s: %s; a provider configured through env keys or a custom provider is not visible here, so this is not proof the worker will fail)\n' \
        "$login_rc" "${line:-no output}"
    fi
  fi

  cfg=${CODEX_HOME:-$HOME/.codex}/config.toml
  if [ -f "$cfg" ]; then
    # Only the entries that really say trusted: a [projects."…"] section without the
    # key is a folder Codex still asks about.
    n=$(awk '/^\[projects\."/{inside=1; next} /^\[/{inside=0} inside && /^[ \t]*trust_level[ \t]*=[ \t]*"trusted"/{count++} END{print count+0}' "$cfg")
    printf 'config: %s (%s trusted project entries)\n' "$cfg" "$n"
  fi

  skills=${KINGPIN_SKILLS_DIR:-$HOME/.claude/skills}
  if [ -d "$skills" ]; then
    # The fleet's skills are linked into .codex/skills per skill, and Codex discovers a
    # skill by its SKILL.md; count them the same recursive way the pi branch does.
    n=$(find "$skills" -name SKILL.md -type f 2>/dev/null | wc -l | tr -d ' ')
    printf 'skills: %s (%s skills)\n' "$skills" "$n"
  else
    printf 'skills: MISSING (%s)\n' "$skills"
  fi

  scope_files
  return "$rc"
}

# One readiness line per check, then the same source list `files` prints.
doctor() {
  # Codex has its own probe; everything below is the pi one.
  if [ "$harness" = codex ]; then
    # `doctor_codex` already returns its status (1 for a missing binary); return it
    # rather than discarding it, so the contract holds even if the caller stops
    # running under `set -e` (issue #106 review, L6).
    doctor_codex || return $?
    return 0
  fi
  local bin=${KINGPIN_PI:-pi} bin_path='' rc=0 json='' parsed=''
  local status='' got_provider='' auth='' reason=''
  local skills='' n=0 pi_dir='' auth_json=''
  local -a auth_args=() fields=()
  # The flags fall back to the project env the spawn reads, so the short form
  # `kingpin scope --harness pi` checks the provider the worker will launch with.
  provider=${provider:-${PI_PROVIDER:-}}
  model=${model:-${PI_MODEL:-}}
  pi_dir=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}
  auth_json=$pi_dir/auth.json
  bin_path=$(command -v "$bin" 2>/dev/null || true)
  if [ -n "$bin_path" ]; then
    printf 'pi: %s\n' "$bin_path"
  else
    printf 'pi: MISSING (%s is not on PATH)\n' "$bin"
    rc=1
  fi

  if [ -z "$provider" ]; then
    # No provider named: the state is genuinely undetermined, because a vendor
    # `/login` cannot be checked without one. A host with no login must still not
    # read like a logged-in one, so name what the agent directory holds.
    if [ -n "$bin_path" ] && auth_json_has_credentials "$auth_json"; then
      printf 'credentials: unverified (no provider; %s holds credentials: pass --provider or set PI_PROVIDER to check them)\n' "$auth_json"
    else
      printf 'credentials: unverified (no provider; %s holds no credentials: run %s and /login, or pass --provider or set PI_PROVIDER)\n' "$auth_json" "$bin"
    fi
  elif [ -z "$bin_path" ]; then
    printf 'credentials: unverified (%s is missing)\n' "$bin"
  else
    auth_args=(auth check --provider "$provider" --no-refresh --json)
    [ -z "$model" ] || auth_args+=(--model "$model")
    json=$("$bin_path" "${auth_args[@]}" 2>/dev/null || true)
    # shellcheck disable=SC2016 # single quotes are intentional: the program runs in node
    parsed=$(printf '%s' "$json" | node -e '
      const fs = require("fs");
      let o = {};
      try { o = JSON.parse(fs.readFileSync(0, "utf8")); } catch {}
      process.stdout.write([o.status || "", o.provider || "", o.authType || "", o.reason || ""].join("\n"));
    ' 2>/dev/null || true)
    # Four lines, so an empty authType does not collapse the fields the way an
    # IFS tab (whitespace, and therefore collapsed) would.
    mapfile -t fields <<< "$parsed"
    status=${fields[0]:-} got_provider=${fields[1]:-} auth=${fields[2]:-} reason=${fields[3]:-}
    case "$status" in
      ready) printf 'credentials: ready (%s, %s)\n' "${got_provider:-$provider}" "${auth:-unknown}" ;;
      *)
        printf 'credentials: not_ready (%s)\n' "${reason:-unknown}"
        rc=1
        ;;
    esac
  fi

  skills=${KINGPIN_SKILLS_DIR:-$HOME/.claude/skills}
  if [ -d "$skills" ]; then
    # Pi discovers a skill by its SKILL.md, recursively, not by a fixed depth: count
    # the files the same way the source list finds them (issue #93 review, L5).
    n=$(find "$skills" -name SKILL.md -type f 2>/dev/null | wc -l | tr -d ' ')
    printf 'skills: %s (%s skills)\n' "$skills" "$n"
  else
    printf 'skills: MISSING (%s)\n' "$skills"
  fi

  if [ -f "$KP_ROOT/worker/pi/kingpin-harness.ts" ]; then
    printf 'extension: %s\n' "$KP_ROOT/worker/pi/kingpin-harness.ts"
  else
    printf 'extension: MISSING (%s)\n' "$KP_ROOT/worker/pi/kingpin-harness.ts"
    rc=1
  fi

  scope_files
  return "$rc"
}

if [ "$cmd" = files ]; then
  scope_files
  exit 0
fi

if [ "$cmd" = doctor ]; then
  doctor
  exit $?
fi

list=$(mktemp)
trap 'rm -f "$list"' EXIT
scope_files > "$list"
rc=0
while IFS=$'\t' read -r kind path; do
  [ -f "$path" ] || continue
  case $kind in
    ignored)
      echo "kingpin-scope: $path is ignored by agy (a rules file needs a trigger: frontmatter)" >&2
      ;;
    global)
      for marker in "${MARKERS[@]}"; do
        grep -Fq -- "$marker" "$path" || continue
        if [ "${KINGPIN_ALLOW_GLOBAL_CONTRACT:-}" = 1 ]; then
          echo "kingpin-scope: warning: the global instruction file carries the orchestrator contract (allowed by KINGPIN_ALLOW_GLOBAL_CONTRACT): $path" >&2
        else
          echo "kingpin-scope: the global instruction file is yours and carries the orchestrator contract: $path (remove the contract from it, or set KINGPIN_ALLOW_GLOBAL_CONTRACT=1 to allow it)" >&2
          rc=1
        fi
      done
      ;;
    *)
      for marker in "${MARKERS[@]}"; do
        if grep -Fq -- "$marker" "$path"; then
          echo "kingpin-scope: the orchestrator contract reaches this worker through $path" >&2
          rc=1
        fi
      done
      ;;
  esac
done < "$list"

# The preamble must be a source the harness really loads, not just a file the spawn
# wrote somewhere. For Claude Code it arrives through --append-system-prompt-file,
# which the launch script passes, so it is not part of discovery. Pi is the same
# shape: --append-system-prompt reads the file, so there is nothing to verify here.
# Codex is the third: `-c model_instructions_file` reads the file at launch, so it is
# a launch flag like the other two rather than a discovered source.
case $harness in
  opencode)
    grep -qxF "configured	$preamble" "$list" \
      || { echo "kingpin-scope: the preamble is not in OpenCode's instruction set: $preamble" >&2; rc=1; }
    ;;
  agy)
    grep -qxF "discovery	$worktree/.agents/rules/kingpin.md" "$list" \
      || { echo "kingpin-scope: the preamble is not a rules file agy loads: $worktree/.agents/rules/kingpin.md" >&2; rc=1; }
    ;;
esac

exit "$rc"
